import DimensionFourDependence.GenericOutputPoint
import DimensionFourDependence.FiberCoordinateRing
import DimensionFourDependence.ProjectiveSourceParameterField

/-! # The full generic fiber ideal is generated by the literal output equations -/

namespace DimensionFourDependence

open MvPolynomial

universe u
set_option maxHeartbeats 4800000
set_option synthInstance.maxHeartbeats 145000

variable {K : Type u} [Field K] {n : ℕ}
local notation "R₀" => MvPolynomial (Fin n) K
local notation "F" => FractionRing R₀
local notation "ι" => (algebraMap R₀ F)
local notation "x" => (rationalCoordinate (K := K) (n := n))

/-- The original output viewed as an element of the full output field. -/
noncomputable def genericFiberOutputScalar (H : Fin n → R₀) (i : Fin n) : polynomialOutputField H :=
  ⟨ι (H i), IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩

/-- The actual affine generic-fiber equations with original source
variables and their universal output values as coefficients. -/
noncomputable def genericFiberOutputEquation (H : Fin n → R₀) (i : Fin n) :
    MvPolynomial (Fin n) (polynomialOutputField H) :=
  MvPolynomial.map (algebraMap K (polynomialOutputField H)) (H i) - C (genericFiberOutputScalar H i)

theorem genericFiberOutputScalar_aeval (H : Fin n → R₀) (P : R₀) :
    (aeval (genericFiberOutputScalar H) P : polynomialOutputField H).val = ι (aeval H P) := by
  let M := polynomialOutputField H
  let f := IsScalarTower.toAlgHom K M F
  let g := IsScalarTower.toAlgHom K R₀ F
  change f (aeval (genericFiberOutputScalar H) P) = g (aeval H P)
  rw [comp_aeval_apply (genericFiberOutputScalar H) f, comp_aeval_apply H g]
  rfl

/-- Each output-field scalar has an actual numerator and denominator
which are polynomial expressions in the original output tuple. -/
theorem generic_fiber_output_scalar_clears_denominator (H : Fin n → R₀) (m : polynomialOutputField H) :
    ∃ A B : R₀, aeval (genericFiberOutputScalar H) A ≠ 0 ∧
      m * aeval (genericFiberOutputScalar H) A = aeval (genericFiberOutputScalar H) B := by
  let Y : Fin n → F := fun i => ι (H i)
  let A₀ := fiberCoordinateAlgebra (L := K) Y
  let f := fiberCoordinateFractionHom (L := K) Y
  have hf : f.fieldRange = polynomialOutputField H := fiberCoordinateFractionHom_fieldRange _
  have hm : (m : F) ∈ f.fieldRange := hf.symm ▸ m.property
  obtain ⟨r, hr⟩ := hm
  obtain ⟨b, a, ha, rfl⟩ := IsFractionRing.div_surjective (A := A₀) r
  have hEval (u : A₀) : ∃ P : R₀, (aeval (genericFiberOutputScalar H) P : polynomialOutputField H).val = u.val := by
    have hu := u.property
    change u.val ∈ Algebra.adjoin K (Set.range Y) at hu
    rw [Algebra.adjoin_range_eq_range_aeval] at hu
    obtain ⟨P, hP⟩ := hu
    refine ⟨P, ?_⟩
    rw [genericFiberOutputScalar_aeval]
    have he := comp_aeval_apply H (IsScalarTower.toAlgHom K R₀ F) P
    exact he.trans hP
  obtain ⟨A, hA⟩ := hEval a
  obtain ⟨B, hB⟩ := hEval b
  have hcoef (u : A₀) : f (algebraMap A₀ (FractionRing A₀) u) = u.val := by
    change IsFractionRing.lift (g := (fiberCoordinateAlgebra (L := K) Y).val.toRingHom)
      Subtype.val_injective (algebraMap A₀ (FractionRing A₀) u) = u.val
    exact IsFractionRing.lift_algebraMap Subtype.val_injective u
  have ha₀ : a.val ≠ 0 := fun hz => (mem_nonZeroDivisors_iff_ne_zero.mp ha) (Subtype.val_injective hz)
  refine ⟨A, B, ?_, ?_⟩
  · intro h
    exact ha₀ (hA.symm.trans (by rw [h]; rfl))
  · apply Subtype.val_injective
    change (m : F) * (aeval (genericFiberOutputScalar H) A : polynomialOutputField H).val =
      (aeval (genericFiberOutputScalar H) B : polynomialOutputField H).val
    rw [hA, hB]
    change f (algebraMap A₀ (FractionRing A₀) b / algebraMap A₀ (FractionRing A₀) a) = (m : F) at hr
    rw [map_div₀, hcoef, hcoef] at hr
    rw [← hr, div_mul_cancel₀ _ ha₀]

/-- The relation ideal over the full output field is generated by the
output equations. Clearing coefficients by original output polynomials
proves the inclusion back into the literal ideal. -/
theorem generic_fiber_vanishing_ideal_eq_output_equations (H : Fin n → R₀) :
    fiberVanishingIdeal (L := polynomialOutputField H) x = Ideal.span (Set.range (genericFiberOutputEquation H)) := by
  let M := polynomialOutputField H
  let R := MvPolynomial (Fin n) M
  let J : Ideal R := Ideal.span (Set.range (genericFiberOutputEquation H))
  let q := Ideal.Quotient.mkₐ M J
  let ev : R →ₐ[M] F := aeval x
  let k₀ := IsScalarTower.toAlgHom K M (R ⧸ J)
  let ψ : R₀ →ₐ[K] (R ⧸ J) := (q.restrictScalars K).comp
    (MvPolynomial.mapAlgHom (Algebra.ofId K M))
  have hY (i : Fin n) : ψ (H i) = algebraMap M (R ⧸ J) (genericFiberOutputScalar H i) := by
    have hz : q (genericFiberOutputEquation H i) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨i, rfl⟩)
    change q (MvPolynomial.map (algebraMap K M) (H i) - C (genericFiberOutputScalar H i)) = 0 at hz
    rw [map_sub, ← MvPolynomial.algebraMap_eq, q.commutes] at hz
    exact sub_eq_zero.mp hz
  have hψ (P : R₀) : ψ (aeval H P) = algebraMap M (R ⧸ J) (aeval (genericFiberOutputScalar H) P) := by
    have he : ψ.comp (aeval H) = k₀.comp (aeval (genericFiberOutputScalar H)) := by
      apply MvPolynomial.algHom_ext
      intro i
      change ψ (aeval H (X i)) = k₀ (aeval (genericFiberOutputScalar H) (X i))
      rw [aeval_X, aeval_X]
      exact hY i
    exact DFunLike.congr_fun he P
  have hι (P : R₀) : ι (aeval H P) = algebraMap M F (aeval (genericFiberOutputScalar H) P) :=
    (genericFiberOutputScalar_aeval H P).symm
  have hJ : J ≤ fiberVanishingIdeal (L := M) x := by
    apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change ev (MvPolynomial.map (algebraMap K M) (H i) - C (genericFiberOutputScalar H i)) = 0
    have hLeft : ev (MvPolynomial.map (algebraMap K M) (H i)) = ι (H i) := by
      change aeval x (MvPolynomial.map (algebraMap K M) (H i)) = _
      rw [MvPolynomial.aeval_map_algebraMap, rationalCoordinate_aeval]
    rw [map_sub, hLeft, show ev (C (genericFiberOutputScalar H i)) = ι (H i) from aeval_C _ _, sub_self]
  have hclear (P : R) : ∃ A B : R₀, aeval (genericFiberOutputScalar H) A ≠ 0 ∧
      algebraMap M (R ⧸ J) (aeval (genericFiberOutputScalar H) A) * q P = ψ B ∧
      algebraMap M F (aeval (genericFiberOutputScalar H) A) * ev P = ι B := by
    induction P using MvPolynomial.induction_on with
    | C m =>
      obtain ⟨A, B, ha, he⟩ := generic_fiber_output_scalar_clears_denominator H m
      refine ⟨A, aeval H B, ha, ?_, ?_⟩
      · rw [hψ, ← MvPolynomial.algebraMap_eq, q.commutes, ← map_mul, mul_comm, he]
      · rw [hι, ← MvPolynomial.algebraMap_eq, ev.commutes, ← map_mul, mul_comm, he]
    | add P Q hP hQ =>
      obtain ⟨a, A, ha, hA, hA'⟩ := hP
      obtain ⟨b, B, hb, hB, hB'⟩ := hQ
      refine ⟨a * b, aeval H b * A + aeval H a * B, by rw [map_mul]; exact mul_ne_zero ha hb, ?_, ?_⟩
      · simp only [map_add, map_mul, hψ]
        linear_combination algebraMap M (R ⧸ J) (aeval (genericFiberOutputScalar H) b) * hA +
          algebraMap M (R ⧸ J) (aeval (genericFiberOutputScalar H) a) * hB
      · simp only [map_add, map_mul, hι]
        linear_combination algebraMap M F (aeval (genericFiberOutputScalar H) b) * hA' +
          algebraMap M F (aeval (genericFiberOutputScalar H) a) * hB'
    | mul_X P i hP =>
      obtain ⟨a, A, ha, hA, hA'⟩ := hP
      refine ⟨a, A * X i, ha, ?_, ?_⟩
      · have he : ψ (X i) = q (X i) := by
          change q (MvPolynomial.map (algebraMap K M) (X i)) = q (X i)
          rw [MvPolynomial.map_X]
        rw [map_mul, map_mul, ← mul_assoc, hA, he]
      · rw [map_mul, map_mul, ← mul_assoc, hA', show ev (X i) = ι (X i) from aeval_X _ _]
  refine le_antisymm ?_ hJ
  intro P hP
  change ev P = 0 at hP
  obtain ⟨a, B, ha, hB, hB'⟩ := hclear P
  rw [hP, mul_zero] at hB'
  have hz : B = 0 := (IsFractionRing.injective R₀ F) (hB'.symm.trans (map_zero _).symm)
  rw [hz, map_zero] at hB
  exact Ideal.Quotient.eq_zero_iff_mem.mp ((isUnit_iff_ne_zero.mpr ha).map (algebraMap M (R ⧸ J)) |>.mul_left_cancel
    (hB.trans (mul_zero _).symm))

end DimensionFourDependence
