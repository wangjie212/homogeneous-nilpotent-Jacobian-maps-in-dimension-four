import DimensionFourDependence.GaussCurveLineEmbedding
import Mathlib.FieldTheory.RatFunc.Luroth

/-! # A rational parameter for the actual one-dimensional Gauss image

The constructed source-line embedding puts the actual Gauss curve field
inside the one-variable rational-function field. Its dimension one excludes
the constant subfield. Mathlib's proved Lüroth theorem then constructs an
actual rational-function-field equivalence and a transcendental generator
of the original Gauss field. No rational parametrization is assumed.
-/

namespace DimensionFourDependence

universe u

variable {K F : Type u} [Field K] [Field F] [Algebra K F]

/-- An actual dimension-one field embedded in the rational-function
field is itself a rational-function field over the original field. -/
theorem rational_function_equiv_of_curve_field_embedding
    (f : F →ₐ[K] RatFunc K) (hdim : Algebra.trdeg K F = 1) :
    Nonempty (RatFunc K ≃ₐ[K] F) := by
  have hnonconstant : f.fieldRange ≠ ⊥ := by
    intro hz
    have he := f.equivFieldRange.trdeg_eq
    rw [hdim, hz, show Algebra.trdeg K (⊥ : IntermediateField K (RatFunc K)) = 0 from trdeg_eq_zero] at he
    norm_num at he
  exact ⟨(RatFunc.Luroth.algEquiv (E := f.fieldRange) hnonconstant).trans f.equivFieldRange.symm⟩

/-- An actual rational-function-field equivalence supplies a
transcendental element generating the whole actual target field. -/
theorem rational_function_equiv_transcendental_generator (e : RatFunc K ≃ₐ[K] F) :
    ∃ t : F, Transcendental K t ∧ IntermediateField.adjoin K {t} = ⊤ := by
  refine ⟨e RatFunc.X, ?_, ?_⟩
  · intro halg
    have he := halg.algHom e.symm.toAlgHom
    exact RatFunc.transcendental_X (by simpa only [AlgEquiv.coe_toAlgHom, e.symm_apply_apply] using he)
  · have hmap : (⊤ : IntermediateField K (RatFunc K)).map e.toAlgHom = ⊤ := by
      ext x
      constructor
      · intro _
        trivial
      · intro _
        obtain ⟨y, rfl⟩ := e.surjective x
        exact ⟨y, trivial, rfl⟩
    have he := congrArg (IntermediateField.map e.toAlgHom) (RatFunc.adjoin_X (K := K))
    rw [IntermediateField.adjoin_map, Set.image_singleton, hmap] at he
    exact he

/-- The actual one-dimensional Gauss image is rational over the
original characteristic-zero coefficient field. Its source-line
embedding and every original-coordinate comparison are constructed. -/
theorem actual_gauss_curve_rational_function_field
    {K : Type u} [Field K] [CharZero K]
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (hGauss : gaussImageDimension H I = 1) :
    Nonempty (RatFunc K ≃ₐ[K]
      projectiveRatioField (K := K) (rationalImageNormal H I.equation) (imageNormalPivot H I)) := by
  obtain ⟨_, _, _, f, _⟩ := exists_actual_gauss_curve_source_line_field_embedding H I hGauss
  exact rational_function_equiv_of_curve_field_embedding f hGauss

/-- The actual Gauss curve function field is generated by a constructed
single transcendental parameter over the original coefficient field. -/
theorem exists_actual_gauss_curve_rational_parameter
    {K : Type u} [Field K] [CharZero K]
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (hGauss : gaussImageDimension H I = 1) :
    ∃ t : projectiveRatioField (K := K) (rationalImageNormal H I.equation) (imageNormalPivot H I),
      Transcendental K t ∧ IntermediateField.adjoin K {t} = ⊤ := by
  obtain ⟨e⟩ := actual_gauss_curve_rational_function_field H I hGauss
  exact rational_function_equiv_transcendental_generator e

end DimensionFourDependence
