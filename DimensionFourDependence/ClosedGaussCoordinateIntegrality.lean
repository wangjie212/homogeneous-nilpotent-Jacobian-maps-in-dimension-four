import DimensionFourDependence.RelativelyClosedAlgebraicBaseChange
import DimensionFourDependence.FiberCoordinateRing
import Mathlib.RingTheory.Flat.Basic
import Mathlib.Algebra.Ring.Hom.InjSurj

/-! # Geometric integrality of the actual closed Gauss coordinate algebra

The coordinate algebra is the subalgebra generated by the original source
coordinates over the actual closed Gauss parameter field. Tensoring its
inclusion into the source field stays injective. The coefficient-extended
source is a field, so the coordinate algebra and its exact prime quotient
remain domains after every algebraic coefficient extension.
-/

namespace DimensionFourDependence

open scoped TensorProduct

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1000000

variable {C F L : Type*} [Field C] [Field F] [Field L]
  [Algebra C F] [Algebra C L] [CharZero C] [Algebra.IsAlgebraic C L]

/-- Every subalgebra of a relatively closed characteristic-zero field
extension remains a domain under algebraic coefficient extension. -/
theorem subalgebra_algebraic_base_change_isDomain
    (hclosed : algebraicClosure C F = ⊥) (A : Subalgebra C F) :
    IsDomain (A ⊗[C] L) := by
  let f := Algebra.TensorProduct.map A.val (AlgHom.id C L)
  have hmap : f.toLinearMap = A.val.toLinearMap.rTensor L := by
    ext a b
    rfl
  have hi : Function.Injective f := by
    change Function.Injective f.toLinearMap
    rw [hmap]
    exact Module.Flat.rTensor_preserves_injective_linearMap _ Subtype.val_injective
  let : IsDomain (F ⊗[C] L) :=
    (algebraic_tensor_isField_of_relatively_closed hclosed).isDomain
  exact Function.Injective.isDomain f hi

/-- The exact prime coordinate quotient, with all of its source relations,
remains a domain under every algebraic coefficient extension. -/
theorem fiber_coordinate_quotient_algebraic_base_change_isDomain
    (hclosed : algebraicClosure C F = ⊥) {n : ℕ} (x : Fin n → F) :
    IsDomain ((MvPolynomial (Fin n) C ⧸ fiberVanishingIdeal (L := C) x) ⊗[C] L) := by
  let : IsDomain (fiberCoordinateAlgebra (L := C) x ⊗[C] L) :=
    subalgebra_algebraic_base_change_isDomain hclosed _
  let e := Algebra.TensorProduct.congr (fiberCoordinateQuotientEquiv (L := C) x)
    (AlgEquiv.refl : L ≃ₐ[C] L)
  exact Function.Injective.isDomain e e.injective

variable {K : Type*} [Field K] [CharZero K]

/-- The affine generic source coordinate algebra over the actual closed
Gauss parameter field, formed in the original four source coordinates. -/
noncomputable def closedGaussCoordinateAlgebra
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H) :
    Subalgebra (closedGaussParameterField H I) (FractionRing (MvPolynomial (Fin 4) K)) :=
  fiberCoordinateAlgebra (L := closedGaussParameterField H I) (rationalCoordinate (K := K) (n := 4))

/-- The actual closed Gauss coordinate algebra stays integral under every
algebraic coefficient extension, in particular over an algebraic closure. -/
theorem actual_closed_gauss_coordinate_algebra_algebraic_base_change_isDomain
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (E : Type*) [Field E] [Algebra (closedGaussParameterField H I) E]
    [Algebra.IsAlgebraic (closedGaussParameterField H I) E] :
    IsDomain (closedGaussCoordinateAlgebra H I ⊗[closedGaussParameterField H I] E) := by
  let : CharZero (closedGaussParameterField H I) :=
    charZero_of_injective_algebraMap (algebraMap K (closedGaussParameterField H I)).injective
  exact subalgebra_algebraic_base_change_isDomain
    (closedGaussParameterField_relatively_closed H I) _

/-- The full original-coordinate prime quotient over the actual closed
Gauss field stays integral after arbitrary algebraic coefficient extension. -/
theorem actual_closed_gauss_coordinate_quotient_algebraic_base_change_isDomain
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (E : Type*) [Field E] [Algebra (closedGaussParameterField H I) E]
    [Algebra.IsAlgebraic (closedGaussParameterField H I) E] :
    IsDomain ((MvPolynomial (Fin 4) (closedGaussParameterField H I) ⧸
      fiberVanishingIdeal (L := closedGaussParameterField H I)
        (rationalCoordinate (K := K) (n := 4))) ⊗[closedGaussParameterField H I] E) := by
  let : CharZero (closedGaussParameterField H I) :=
    charZero_of_injective_algebraMap (algebraMap K (closedGaussParameterField H I)).injective
  exact fiber_coordinate_quotient_algebraic_base_change_isDomain
    (closedGaussParameterField_relatively_closed H I) _

omit [CharZero K] in
/-- The original source coordinates still generate the full source field
over the actual closed Gauss field. -/
theorem actual_closed_gauss_source_coordinates_generate
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H) :
    IntermediateField.adjoin (closedGaussParameterField H I)
      (Set.range (rationalCoordinate (K := K) (n := 4))) = ⊤ := by
  let M := IntermediateField.adjoin (closedGaussParameterField H I)
    (Set.range (rationalCoordinate (K := K) (n := 4)))
  have hcoords : ∀ i : Fin 4, rationalCoordinate (K := K) i ∈ M.restrictScalars K := by
    intro i
    change rationalCoordinate (K := K) i ∈ IntermediateField.adjoin (closedGaussParameterField H I)
      (Set.range (rationalCoordinate (K := K) (n := 4)))
    exact IntermediateField.subset_adjoin (closedGaussParameterField H I)
      (Set.range (rationalCoordinate (K := K) (n := 4))) ⟨i, rfl⟩
  have htop : M.restrictScalars K = ⊤ :=
    rationalSource_field_eq_top_of_coordinates (K := K) (n := 4) _ hcoords
  apply top_unique
  intro x _
  have hx : x ∈ M.restrictScalars K := by rw [htop]; trivial
  exact hx

/-- The exact prime coordinate quotient of the closed cover has the actual
original rational source as its function field. -/
noncomputable def closedGaussCoordinateQuotientFractionEquiv
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H) :
    FractionRing (MvPolynomial (Fin 4) (closedGaussParameterField H I) ⧸
      fiberVanishingIdeal (L := closedGaussParameterField H I)
        (rationalCoordinate (K := K) (n := 4))) ≃ₐ[closedGaussParameterField H I]
          FractionRing (MvPolynomial (Fin 4) K) :=
  fiberQuotientFractionEquiv _ (actual_closed_gauss_source_coordinates_generate H I)

end DimensionFourDependence
