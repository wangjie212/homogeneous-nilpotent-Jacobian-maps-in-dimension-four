import DimensionFourDependence.FiniteLineChartFibers
import DimensionFourDependence.UniversalLineIncidence
import Mathlib.FieldTheory.SeparableDegree

/-! # Field embeddings of actual line-chart fibers

The original polynomial coefficient equations and the actual represented
point are preserved by field embeddings. Finitely many possible conjugate
parameter matrices then imply that their generated field is algebraic.
-/

namespace DimensionFourDependence

open MvPolynomial Matrix

variable {K E L : Type*} [Field K] [Field E] [Field L]
variable [Algebra K E] [Algebra K L]

/-- Original-field line-chart equations commute with an embedding of fields. -/
theorem extendedLineChartSpecialization_algHom
    (σ : E →ₐ[K] L) (B : Matrix (Fin 2) (Fin 2) E)
    (P : MvPolynomial (Fin 2 × Fin 2) K) :
    extendedLineChartSpecialization (fun i j => σ (B i j)) P =
      σ (extendedLineChartSpecialization B P) := by
  change aeval (R := K) (fun ij : Fin 2 × Fin 2 => σ (B ij.1 ij.2)) P =
    σ (aeval (R := K) (fun ij : Fin 2 × Fin 2 => B ij.1 ij.2) P)
  exact (comp_aeval_apply (fun ij : Fin 2 × Fin 2 => B ij.1 ij.2) σ P).symm

/-- Field embeddings preserve the actual lines described by every permuted chart. -/
theorem lineChartMemberLine_map_mem
    (σ : E →ₐ[K] L) (p : Equiv.Perm (Fin 4))
    (B : Matrix (Fin 2) (Fin 2) E) (O : Fin 4 → E)
    (hO : O ∈ lineChartMemberLine p B) :
    (fun i => σ (O i)) ∈ lineChartMemberLine p (fun i j => σ (B i j)) := by
  obtain ⟨z, hz, hzO⟩ := hO
  obtain ⟨u, hu⟩ := (mem_graphLineFour B z).mp hz
  have hcoords : (fun i => σ (z i)) =
      ![σ (u 0), σ (u 1), ((fun i j => σ (B i j)) *ᵥ fun j => σ (u j)) 0,
        ((fun i j => σ (B i j)) *ᵥ fun j => σ (u j)) 1] := by
    rw [hu]
    funext i
    fin_cases i <;> simp [Matrix.mulVec, dotProduct]
  refine ⟨(fun i => σ (z i)), (mem_graphLineFour _ _).mpr
    ⟨(fun j => σ (u j)), hcoords⟩, ?_⟩
  funext i
  exact congrArg σ (congrFun hzO i)

/-- An embedding sends an original-field line-chart fiber to the corresponding
fiber through the embedded point. -/
theorem original_line_chart_fiber_algHom
    (σ : E →ₐ[K] L) (p : Equiv.Perm (Fin 4))
    (R : MvPolynomial (Fin 4) K) (B : Matrix (Fin 2) (Fin 2) E) (O : Fin 4 → E)
    (heq : ∀ P ∈ graphLineEquationPolynomials (rename p.symm R),
      extendedLineChartSpecialization B P = 0)
    (hO : O ∈ lineChartMemberLine p B) :
    (∀ P ∈ graphLineEquationPolynomials (rename p.symm R),
      extendedLineChartSpecialization (fun i j => σ (B i j)) P = 0) ∧
      (fun i => σ (O i)) ∈ lineChartMemberLine p (fun i j => σ (B i j)) := by
  refine ⟨?_, lineChartMemberLine_map_mem σ p B O hO⟩
  intro P hP
  rw [extendedLineChartSpecialization_algHom, heq P hP, map_zero]

variable {F : Type*} [Field F] [Algebra F E]

/-- A field generated by a matrix is algebraic if its embedding-conjugate
matrices lie in a finite set. This turns finite actual line fibers into
an algebraic function-field extension. -/
theorem isAlgebraic_of_finite_matrix_embedding_values
    (B : Matrix (Fin 2) (Fin 2) E)
    (hgen : IntermediateField.adjoin F (Set.range (fun ij : Fin 2 × Fin 2 => B ij.1 ij.2)) = ⊤)
    (S : Set (Matrix (Fin 2) (Fin 2) (AlgebraicClosure E))) (hfinite : S.Finite)
    (hmem : ∀ σ : Field.Emb F E, (fun i j => σ (B i j)) ∈ S) :
    Algebra.IsAlgebraic F E := by
  have hinj : Function.Injective
      (fun σ : Field.Emb F E => (fun i j => σ (B i j))) := by
    intro σ τ he
    apply AlgHom.ext
    intro x
    have hx : x ∈ IntermediateField.adjoin F (Set.range (fun ij : Fin 2 × Fin 2 => B ij.1 ij.2)) := by
      rw [hgen]
      trivial
    induction hx using IntermediateField.adjoin_induction with
    | mem x hx =>
      obtain ⟨ij, rfl⟩ := hx
      exact congrFun (congrFun he ij.1) ij.2
    | algebraMap a => rw [σ.commutes, τ.commutes]
    | add x y hx hy ihx ihy => simp only [map_add, ihx, ihy]
    | inv x hx ih => simp only [map_inv₀, ih]
    | mul x y hx hy ihx ihy => simp only [map_mul, ihx, ihy]
  have : Finite S := hfinite.to_subtype
  have : Finite (Field.Emb F E) :=
    Finite.of_injective (fun σ => (⟨_, hmem σ⟩ : S)) (fun σ τ he => hinj (congrArg Subtype.val he))
  by_contra hn
  have : Algebra.Transcendental F E := Algebra.transcendental_iff_not_isAlgebraic.mpr hn
  exact not_finite (Field.Emb F E)

end DimensionFourDependence
