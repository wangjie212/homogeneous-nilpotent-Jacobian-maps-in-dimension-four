import DimensionFourDependence.RelativelyClosedPolynomial
import Mathlib.FieldTheory.PrimitiveElement

/-! # Finite separable coefficient extensions preserve the source field's integrality

A finite separable coefficient extension is generated by one algebraic
element. Relative closedness keeps its minimal polynomial irreducible
over the source. The root-adjoining presentation and its actual tensor
base change therefore identify the coefficient-extended source with a
field. This applies to every finite extension of the actual closed
Gauss parameter field in characteristic zero.
-/

namespace DimensionFourDependence

open scoped TensorProduct

variable {K F L : Type*} [Field K] [Field F] [Field L] [Algebra K F] [Algebra K L]
  [Module.Finite K L] [Algebra.IsSeparable K L]

/-- A finite separable coefficient extension of a relatively closed
field extension gives an actual tensor-product field. -/
theorem finite_separable_tensor_isField_of_relatively_closed
    (hclosed : algebraicClosure K F = ⊥) : IsField (F ⊗[K] L) := by
  obtain ⟨a, ha⟩ := Field.exists_primitive_element K L
  have hai : IsIntegral K a := Algebra.IsIntegral.isIntegral a
  let p := minpoly K a
  have hp : p.Monic := minpoly.monic hai
  have hpI : Irreducible p := minpoly.irreducible hai
  let e : AdjoinRoot p ≃ₐ[K] L :=
    (IntermediateField.adjoinRootEquivAdjoin K hai).trans
      ((IntermediateField.equivOfEq ha).trans IntermediateField.topEquiv)
  let q : Polynomial (F ⊗[K] K) :=
    p.map (Algebra.TensorProduct.includeRight : K →ₐ[K] F ⊗[K] K).toRingHom
  let ρ : F ⊗[K] K ≃ₐ[F] F := Algebra.TensorProduct.rid K F F
  have hmap : q.map ρ.toRingHom = p.map (algebraMap K F) := by
    simp only [q, Polynomial.map_map]
    congr 1
    ext k
    simp [ρ, Algebra.smul_def]
  let eCoeff : AdjoinRoot q ≃+* AdjoinRoot (p.map (algebraMap K F)) :=
    AdjoinRoot.mapRingEquiv ρ.toRingEquiv q (p.map (algebraMap K F)) (Associated.of_eq hmap)
  have hpFI : Irreducible (p.map (algebraMap K F)) :=
    monic_irreducible_map_of_relatively_closed hclosed p hp hpI
  have hField : IsField (AdjoinRoot (p.map (algebraMap K F))) :=
    AdjoinRoot.isField_iff_irreducible.mpr hpFI
  have hFieldq : IsField (AdjoinRoot q) := eCoeff.toMulEquiv.isField hField
  let eTensor : F ⊗[K] AdjoinRoot p ≃ₐ[F] AdjoinRoot q :=
    AdjoinRoot.tensorAlgEquiv p q rfl
  have hFieldTensor : IsField (F ⊗[K] AdjoinRoot p) := eTensor.toMulEquiv.isField hFieldq
  let eExtension : F ⊗[K] L ≃ₐ[K] F ⊗[K] AdjoinRoot p :=
    Algebra.TensorProduct.congr (AlgEquiv.refl : F ≃ₐ[K] F) e.symm
  exact eExtension.toMulEquiv.isField hFieldTensor

universe u

variable {K' : Type u} [Field K'] [CharZero K']

/-- Every actual finite extension of the relatively closed Gauss
parameter field leaves the coefficient-extended source a field.
Separability is derived from characteristic zero. -/
theorem actual_closed_gauss_cover_finite_base_change_isField
    (H : Fin 4 → MvPolynomial (Fin 4) K') (I : ImageRelationWitness H)
    (L' : Type*) [Field L'] [Algebra (closedGaussParameterField H I) L']
    [Module.Finite (closedGaussParameterField H I) L'] :
    IsField (FractionRing (MvPolynomial (Fin 4) K') ⊗[closedGaussParameterField H I] L') := by
  let : CharZero (closedGaussParameterField H I) :=
    charZero_of_injective_algebraMap (algebraMap K' (closedGaussParameterField H I)).injective
  exact finite_separable_tensor_isField_of_relatively_closed (closedGaussParameterField_relatively_closed H I)

end DimensionFourDependence
