import DimensionFourDependence.LinePairComponentDimension
import DimensionFourDependence.GeneratedFieldDimension

/-! # A two-dimensional actual line pair is generic in the component product

The actual pair-coordinate domain has dimension at most two. Evaluation
at an extension-field pair factors through it, with image the actual
coordinate algebra of that pair. If the generated pair field has dimension
at least two, the specialization preserves dimension and is injective.
Thus the pair has exactly the original component-product relations.
-/

namespace DimensionFourDependence

open MvPolynomial Matrix

universe u

variable {K E : Type u} [Field K] [IsAlgClosed K] [Field E] [Algebra K E]
variable (Q Q' : Ideal (MvPolynomial LineMatrixIndex K)) [Q.IsPrime] [Q'.IsPrime]

local notation "PairRing" => (MvPolynomial LinePairIndex K ⧸ lineComponentPairIdeal Q Q')

/-- Evaluation of the actual component-product coordinate ring at a
pair of extension-field component matrices. -/
noncomputable def lineComponentPairEvaluation
    (B D : Matrix (Fin 2) (Fin 2) E)
    (hB : Q ≤ (extendedLineChartPrime (K := K) B).asIdeal)
    (hD : Q' ≤ (extendedLineChartPrime (K := K) D).asIdeal) : PairRing →ₐ[K] E :=
  Ideal.Quotient.liftₐ (lineComponentPairIdeal Q Q') (aeval (linePairCoordinates B D))
    (fun _ h => lineComponentPairIdeal_le_extension_evalKernel Q Q' B D hB hD h)

omit [Q.IsPrime] [Q'.IsPrime] in
/-- This is actual evaluation at the pair on polynomial representatives. -/
theorem lineComponentPairEvaluation_mk
    (B D : Matrix (Fin 2) (Fin 2) E)
    (hB : Q ≤ (extendedLineChartPrime (K := K) B).asIdeal)
    (hD : Q' ≤ (extendedLineChartPrime (K := K) D).asIdeal)
    (P : MvPolynomial LinePairIndex K) :
    lineComponentPairEvaluation Q Q' B D hB hD
      (Ideal.Quotient.mk (lineComponentPairIdeal Q Q') P) = aeval (linePairCoordinates B D) P := rfl

omit [Q.IsPrime] [Q'.IsPrime] in
/-- The image is the actual algebra generated by the pair's eight coordinates. -/
theorem lineComponentPairEvaluation_range
    (B D : Matrix (Fin 2) (Fin 2) E)
    (hB : Q ≤ (extendedLineChartPrime (K := K) B).asIdeal)
    (hD : Q' ≤ (extendedLineChartPrime (K := K) D).asIdeal) :
    (lineComponentPairEvaluation Q Q' B D hB hD).range =
      Algebra.adjoin K (Set.range (linePairCoordinates B D)) := by
  rw [Algebra.adjoin_range_eq_range_aeval]
  ext a
  change (∃ b : PairRing, lineComponentPairEvaluation Q Q' B D hB hD b = a) ↔
    ∃ P : MvPolynomial LinePairIndex K, aeval (linePairCoordinates B D) P = a
  constructor
  · rintro ⟨b, hb⟩
    obtain ⟨P, rfl⟩ := Ideal.Quotient.mk_surjective b
    exact ⟨P, hb⟩
  · rintro ⟨P, hP⟩
    exact ⟨Ideal.Quotient.mk _ P, hP⟩

/-- A pair retaining dimension two makes the actual component-product
evaluation injective, by the proved dimension-drop theorem. -/
theorem lineComponentPairEvaluation_injective_of_dimension_two
    (hQ : Algebra.trdeg K (FractionRing (MvPolynomial LineMatrixIndex K ⧸ Q)) = 1)
    (hQ' : Algebra.trdeg K (FractionRing (MvPolynomial LineMatrixIndex K ⧸ Q')) = 1)
    (B D : Matrix (Fin 2) (Fin 2) E)
    (hB : Q ≤ (extendedLineChartPrime (K := K) B).asIdeal)
    (hD : Q' ≤ (extendedLineChartPrime (K := K) D).asIdeal)
    (hdim : 2 ≤ Algebra.trdeg K (IntermediateField.adjoin K (Set.range (linePairCoordinates B D)))) :
    Function.Injective (lineComponentPairEvaluation Q Q' B D hB hD) := by
  let f := lineComponentPairEvaluation Q Q' B D hB hD
  have hu : Algebra.trdeg K PairRing ≤ 2 := lineComponentPair_trdeg_le_two Q Q' hQ hQ'
  have hl : 2 ≤ Algebra.trdeg K f.range := by
    rw [lineComponentPairEvaluation_range Q Q' B D hB hD,
      ← generatedField_trdeg_eq_generatedAlgebra]
    exact hdim
  have hr := trdeg_le_of_surjective f.rangeRestrict f.rangeRestrict_surjective
  have heq : Algebra.trdeg K PairRing = Algebra.trdeg K f.range := le_antisymm (hu.trans hl) hr
  have hinj := surjective_algHom_injective_of_trdeg_eq f.rangeRestrict f.rangeRestrict_surjective
    (hu.trans_lt (by simp)) heq
  intro a b hab
  apply hinj
  exact Subtype.ext hab

/-- A two-dimensional extension-field pair has exactly the relations
of the actual product of the two original covering-curve components. -/
theorem line_pair_relations_eq_product_of_dimension_two
    (hQ : Algebra.trdeg K (FractionRing (MvPolynomial LineMatrixIndex K ⧸ Q)) = 1)
    (hQ' : Algebra.trdeg K (FractionRing (MvPolynomial LineMatrixIndex K ⧸ Q')) = 1)
    (B D : Matrix (Fin 2) (Fin 2) E)
    (hB : Q ≤ (extendedLineChartPrime (K := K) B).asIdeal)
    (hD : Q' ≤ (extendedLineChartPrime (K := K) D).asIdeal)
    (hdim : 2 ≤ Algebra.trdeg K (IntermediateField.adjoin K (Set.range (linePairCoordinates B D)))) :
    RingHom.ker (aeval (linePairCoordinates B D) : MvPolynomial LinePairIndex K →ₐ[K] E) =
      lineComponentPairIdeal Q Q' := by
  have hinj := lineComponentPairEvaluation_injective_of_dimension_two Q Q' hQ hQ' B D hB hD hdim
  ext P
  constructor
  · intro hP
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    apply hinj
    rw [lineComponentPairEvaluation_mk, map_zero]
    exact hP
  · intro hP
    exact lineComponentPairIdeal_le_extension_evalKernel Q Q' B D hB hD hP

/-- Every polynomial equation of a two-dimensional actual pair holds
on every actual pair of members of the two original components. -/
theorem line_pair_equation_holds_on_product_of_dimension_two
    (hQ : Algebra.trdeg K (FractionRing (MvPolynomial LineMatrixIndex K ⧸ Q)) = 1)
    (hQ' : Algebra.trdeg K (FractionRing (MvPolynomial LineMatrixIndex K ⧸ Q')) = 1)
    (B D : Matrix (Fin 2) (Fin 2) E)
    (hB : Q ≤ (extendedLineChartPrime (K := K) B).asIdeal)
    (hD : Q' ≤ (extendedLineChartPrime (K := K) D).asIdeal)
    (hdim : 2 ≤ Algebra.trdeg K (IntermediateField.adjoin K (Set.range (linePairCoordinates B D))))
    (P : MvPolynomial LinePairIndex K) (hP : aeval (linePairCoordinates B D) P = 0) :
    ∀ C ∈ lineComponentPoints Q, ∀ T ∈ lineComponentPoints Q',
      aeval (linePairCoordinates C T) P = 0 := by
  apply (mem_lineComponentPairIdeal_iff Q Q' P).mp
  rw [← line_pair_relations_eq_product_of_dimension_two Q Q' hQ hQ' B D hB hD hdim]
  exact hP

end DimensionFourDependence
