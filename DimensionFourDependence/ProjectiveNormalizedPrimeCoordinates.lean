import DimensionFourDependence.ProjectivePrimeCoordinates

/-! # Normalized projective prime coordinates generate their own field

Remove the radial fraction-field variable by adjoining only coordinate
ratios. The chosen coordinate is one, and the resulting actual point
is still the original projective-spectrum prime. The coordinates generate
this field; algebraicity of the coordinates therefore makes the whole
field algebraic, as needed for the original extended partials.
-/

namespace DimensionFourDependence

open MvPolynomial

attribute [local instance] MvPolynomial.gradedAlgebra

section Transport

variable {F E G sigma : Type*} [Field F] [Field E] [Field G] [Algebra F E] [Algebra F G]

/-- Injective coefficient-field maps preserve nonzero coordinate vectors. -/
theorem projective_coordinate_map_ne_zero (phi : E →ₐ[F] G) (v : sigma → E) (hv : v ≠ 0) :
    (fun i => phi (v i)) ≠ 0 := by
  intro hzero
  apply hv
  funext i
  apply phi.injective
  change phi (v i) = phi (0 : E)
  rw [map_zero]
  exact congrFun hzero i

/-- Extending the coordinate field by its specified embedding leaves
the actual point of the original projective spectrum unchanged. -/
theorem projectiveFieldPoint_map_algHom
    (phi : E →ₐ[F] G) (v : sigma → E) (hv : v ≠ 0) :
    projectiveFieldPoint (E := F) (fun i => phi (v i)) (projective_coordinate_map_ne_zero phi v hv) =
      projectiveFieldPoint (E := F) v hv := by
  apply ProjectiveSpectrum.ext
  apply HomogeneousIdeal.ext'
  intro d P hP
  change P.IsHomogeneous d at hP
  rw [projectiveFieldPoint_homogeneous_mem _ _ P hP, projectiveFieldPoint_homogeneous_mem _ _ P hP]
  rw [← comp_aeval_apply v phi P]
  exact map_eq_zero_iff phi phi.injective

end Transport

variable {F sigma : Type*} [Field F]

/-- The field generated by the original normalized coordinate ratios
of an actual projective prime, excluding the radial coordinate. -/
noncomputable def projectivePrimeRatioField
    (z : ProjectiveSpectrum (homogeneousSubmodule sigma F)) (a : sigma) :
    IntermediateField F (FractionRing (MvPolynomial sigma F ⧸ z.asHomogeneousIdeal.toIdeal)) :=
  IntermediateField.adjoin F (Set.range (fun i => projectivePrimeCoordinate z i / projectivePrimeCoordinate z a))

/-- The actual normalized coordinates in their own generated field. -/
noncomputable def projectivePrimeRatioCoordinate
    (z : ProjectiveSpectrum (homogeneousSubmodule sigma F)) (a i : sigma) : projectivePrimeRatioField z a :=
  ⟨projectivePrimeCoordinate z i / projectivePrimeCoordinate z a,
    IntermediateField.subset_adjoin F _ ⟨i, rfl⟩⟩

/-- The chosen normalized projective coordinate is exactly one. -/
theorem projectivePrimeRatioCoordinate_self
    (z : ProjectiveSpectrum (homogeneousSubmodule sigma F)) (a : sigma) (ha : X a ∉ z.asHomogeneousIdeal) :
    projectivePrimeRatioCoordinate z a a = 1 := by
  apply Subtype.ext
  change projectivePrimeCoordinate z a / projectivePrimeCoordinate z a = 1
  exact div_self (mt (projectivePrimeCoordinate_eq_zero_iff z a).mp ha)

/-- The actual normalized coordinate vector is nonzero. -/
theorem projectivePrimeRatioCoordinate_ne_zero
    (z : ProjectiveSpectrum (homogeneousSubmodule sigma F)) (a : sigma) (ha : X a ∉ z.asHomogeneousIdeal) :
    projectivePrimeRatioCoordinate z a ≠ 0 := by
  intro hzero
  have he := congrFun hzero a
  rw [projectivePrimeRatioCoordinate_self z a ha] at he
  exact one_ne_zero he

/-- The normalized coordinates in their own field represent the
original actual projective-spectrum point, with the chosen coordinate one. -/
theorem projectivePrimeRatioCoordinate_represents
    (z : ProjectiveSpectrum (homogeneousSubmodule sigma F)) (a : sigma) (ha : X a ∉ z.asHomogeneousIdeal) :
    projectiveFieldPoint (E := F) (projectivePrimeRatioCoordinate z a)
      (projectivePrimeRatioCoordinate_ne_zero z a ha) = z := by
  let phi := IsScalarTower.toAlgHom F (projectivePrimeRatioField z a)
    (FractionRing (MvPolynomial sigma F ⧸ z.asHomogeneousIdeal.toIdeal))
  have hmap := projectiveFieldPoint_map_algHom phi (projectivePrimeRatioCoordinate z a)
    (projectivePrimeRatioCoordinate_ne_zero z a ha)
  rw [← hmap]
  have hscale := projectiveFieldPoint_eq_of_proportional (K := F)
    (fun i => phi (projectivePrimeRatioCoordinate z a i)) (projectivePrimeCoordinate z)
    (projective_coordinate_map_ne_zero phi _ (projectivePrimeRatioCoordinate_ne_zero z a ha))
    (projectivePrimeCoordinate_ne_zero z) (projectivePrimeCoordinate z a)⁻¹
    (inv_ne_zero (mt (projectivePrimeCoordinate_eq_zero_iff z a).mp ha)) (by
      intro i
      change projectivePrimeCoordinate z i / projectivePrimeCoordinate z a =
        (projectivePrimeCoordinate z a)⁻¹ * projectivePrimeCoordinate z i
      rw [div_eq_mul_inv, mul_comm])
  exact hscale.trans (projectivePrimeCoordinate_represents z)

/-- Evaluation in the actual normalized-coordinate field has exactly
the same values after its original fraction-field inclusion. -/
theorem projectivePrimeRatioCoordinate_aeval_coe
    (z : ProjectiveSpectrum (homogeneousSubmodule sigma F)) (a : sigma) (P : MvPolynomial sigma F) :
    (aeval (projectivePrimeRatioCoordinate z a) P :
      FractionRing (MvPolynomial sigma F ⧸ z.asHomogeneousIdeal.toIdeal)) =
      aeval (fun i => projectivePrimeCoordinate z i / projectivePrimeCoordinate z a) P :=
  comp_aeval_apply _ (IsScalarTower.toAlgHom F (projectivePrimeRatioField z a)
    (FractionRing (MvPolynomial sigma F ⧸ z.asHomogeneousIdeal.toIdeal))) P

/-- The normalized original coordinates generate their entire field. -/
theorem projectivePrimeRatioCoordinate_adjoin_eq_top
    (z : ProjectiveSpectrum (homogeneousSubmodule sigma F)) (a : sigma) :
    IntermediateField.adjoin F (Set.range (projectivePrimeRatioCoordinate z a)) = ⊤ := by
  let J := IntermediateField.adjoin F (Set.range (projectivePrimeRatioCoordinate z a))
  have hpoly (P : MvPolynomial sigma F) : aeval (projectivePrimeRatioCoordinate z a) P ∈ J := by
    induction P using MvPolynomial.induction_on with
    | C c => rw [aeval_C]; exact J.algebraMap_mem c
    | add P Q hP hQ => rw [map_add]; exact J.add_mem hP hQ
    | mul_X P i hP =>
      rw [map_mul, aeval_X]
      exact J.mul_mem hP (IntermediateField.subset_adjoin F _ ⟨i, rfl⟩)
  apply top_unique
  intro x _
  obtain ⟨P, Q, he⟩ := (IntermediateField.mem_adjoin_range_iff F
    (fun i => projectivePrimeCoordinate z i / projectivePrimeCoordinate z a) (x :
      FractionRing (MvPolynomial sigma F ⧸ z.asHomogeneousIdeal.toIdeal))).mp x.property
  have hx : x = aeval (projectivePrimeRatioCoordinate z a) P / aeval (projectivePrimeRatioCoordinate z a) Q := by
    apply Subtype.ext
    change (x : FractionRing (MvPolynomial sigma F ⧸ z.asHomogeneousIdeal.toIdeal)) =
      (aeval (projectivePrimeRatioCoordinate z a) P : FractionRing _) /
        (aeval (projectivePrimeRatioCoordinate z a) Q : FractionRing _)
    rw [projectivePrimeRatioCoordinate_aeval_coe, projectivePrimeRatioCoordinate_aeval_coe]
    exact he
  rw [hx]
  exact J.div_mem (hpoly P) (hpoly Q)

/-- Algebraicity of every normalized coordinate makes its whole
actual generated field algebraic; no algebraicity of the radial field is needed. -/
theorem projectivePrimeRatioField_isAlgebraic_of_coordinates
    (z : ProjectiveSpectrum (homogeneousSubmodule sigma F)) (a : sigma)
    (halg : ∀ i, IsAlgebraic F (projectivePrimeRatioCoordinate z a i)) :
    Algebra.IsAlgebraic F (projectivePrimeRatioField z a) := by
  have hle : IntermediateField.adjoin F (Set.range (projectivePrimeRatioCoordinate z a)) ≤
      algebraicClosure F (projectivePrimeRatioField z a) := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    exact mem_algebraicClosure_iff.mpr (halg i)
  rw [projectivePrimeRatioCoordinate_adjoin_eq_top] at hle
  exact ⟨fun x => mem_algebraicClosure_iff.mp (hle (by trivial))⟩

end DimensionFourDependence
