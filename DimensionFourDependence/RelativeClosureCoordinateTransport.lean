import DimensionFourDependence.RationalClosedGaussCover
import DimensionFourDependence.LinearPolynomialConjugacy

/-! # Relative algebraic closedness survives actual source-coordinate transport

The intermediate coefficient field and the entire source are transported
together by the actual original source automorphism. Algebraicity is
compared through the induced coefficient-field equivalence. This retains
relative closedness for the same changed Gauss parameter after conjugacy.
-/

namespace DimensionFourDependence

set_option maxHeartbeats 3000000
set_option synthInstance.maxHeartbeats 100000

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- An actual source-field automorphism preserves relative algebraic
closedness of the entire transported original coefficient field. -/
theorem relatively_closed_intermediate_field_map_source_equiv
    (J : IntermediateField K L) (hJ : algebraicClosure J L = ⊥) (f : L ≃ₐ[K] L) :
    algebraicClosure (J.map f.toAlgHom) L = ⊥ := by
  let e := IntermediateField.intermediateFieldMap f J
  have hcompat : (algebraMap (J.map f.toAlgHom) L).comp e.toRingHom =
      f.toRingHom.comp (algebraMap J L) := by
    ext c
    rfl
  apply le_antisymm ?_ bot_le
  intro x hx
  have halg : IsAlgebraic (J.map f.toAlgHom) (f (f.symm x)) := by
    simpa only [f.apply_symm_apply] using mem_algebraicClosure_iff.mp hx
  have halg₀ : IsAlgebraic J (f.symm x) :=
    (isAlgebraic_ringHom_iff_of_comp_eq e.toRingEquiv f.toRingHom f.injective hcompat).mp halg
  have hm : f.symm x ∈ algebraicClosure J L := mem_algebraicClosure_iff.mpr halg₀
  rw [hJ] at hm
  obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hm
  apply IntermediateField.mem_bot.mpr
  refine ⟨e c, ?_⟩
  change f (algebraMap J L c) = x
  rw [hc, f.apply_symm_apply]

variable (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)

/-- The exact field generated by the transported actual closed Gauss
parameter remains relatively algebraically closed in the original source
fraction field, after any original constant coordinate automorphism. -/
theorem actual_conjugated_closed_gauss_parameter_field_relatively_closed
    (e : RatFunc K ≃ₐ[K] closedGaussParameterField H I)
    (f : FractionRing (MvPolynomial (Fin 4) K) ≃ₐ[K] FractionRing (MvPolynomial (Fin 4) K)) :
    algebraicClosure
      (IntermediateField.adjoin K {f (closedGaussParameterSourceHom H I e RatFunc.X)})
      (FractionRing (MvPolynomial (Fin 4) K)) = ⊥ := by
  have hgen := congrArg (IntermediateField.map f.toAlgHom) (closedGaussParameterSourceHom_X_adjoin H I e)
  rw [IntermediateField.adjoin_map, Set.image_singleton] at hgen
  have hclosed := relatively_closed_intermediate_field_map_source_equiv (closedGaussParameterField H I)
    (closedGaussParameterField_relatively_closed H I) f
  exact Eq.mpr (congrArg (fun J : IntermediateField K (FractionRing (MvPolynomial (Fin 4) K)) =>
    algebraicClosure J (FractionRing (MvPolynomial (Fin 4) K)) = ⊥) hgen) hclosed

end DimensionFourDependence
