import DimensionFourDependence.ActualInfinityPrimeAlgebraicity

/-! # Algebraicity over the actual mapped parameter reflects to the original field -/

namespace DimensionFourDependence

universe u
set_option maxHeartbeats 1500000
set_option synthInstance.maxHeartbeats 100000

variable {K E F : Type u} [Field K] [Field E] [Field F] [Algebra K E] [Algebra K F]

/-- A specified compatible field embedding reflects algebraicity over
the field generated by the specified original parameter. The original
parameter field and its actual mapped image are compared explicitly. -/
theorem algebraic_over_mapped_parameter_reflects
    (φ : E →ₐ[K] F) (t x : E)
    (hx : IsAlgebraic (IntermediateField.adjoin K ({φ t} : Set F)) (φ x)) :
    IsAlgebraic (IntermediateField.adjoin K ({t} : Set E)) x := by
  let J := IntermediateField.adjoin K ({t} : Set E)
  let g : J →ₐ[K] F := φ.comp J.val
  let : Algebra J F := g.toRingHom.toAlgebra
  let : IsScalarTower K J F := IsScalarTower.of_algebraMap_eq (fun r => (g.commutes r).symm)
  have hJ : IntermediateField.adjoin K ({φ t} : Set F) ≤
      (IsScalarTower.toAlgHom K J F).fieldRange := by
    apply IntermediateField.adjoin_le_iff.mpr
    intro z hz
    rw [Set.mem_singleton_iff] at hz
    subst z
    exact ⟨⟨t, IntermediateField.subset_adjoin K _ (by rfl)⟩, rfl⟩
  have ha : IsAlgebraic J (φ x) :=
    isAlgebraic_of_subfield_le_coefficient_image _ hJ _ hx
  let ψ : E →ₐ[J] F := { φ.toRingHom with commutes' := by intro r; rfl }
  exact (isAlgebraic_algHom_iff ψ ψ.injective).mp ha

end DimensionFourDependence
