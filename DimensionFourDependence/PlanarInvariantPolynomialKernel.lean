import DimensionFourDependence.ConstantKernelSourceReduction
import DimensionFourDependence.Tame

/-! # The kernel of the constant active derivation is the polynomial algebra in its invariant -/

namespace DimensionFourDependence.Shear

open MvPolynomial

set_option maxHeartbeats 1400000

variable {L : Type*} [Field L] [CharZero L]
local notation "A₂" => MvPolynomial (Fin 2) L

/-- Over a characteristic-zero field, the polynomial kernel of
`b ∂x - a ∂y` with `a ≠ 0` is generated by `a x+b y`. -/
theorem planar_constant_direction_kernel_is_polynomial_in_invariant
    (a b : L) (ha : a ≠ 0) (q : A₂)
    (hq : C b * pderiv 0 q - C a * pderiv 1 q = 0) :
    ∃ f : Polynomial L, q = Polynomial.aeval (C a * X 0 + C b * X 1 : A₂) f := by
  let S : A₂ := C a * X 0 + C b * X 1
  let U : Fin 2 → A₂ := ![C a⁻¹ * (X 0 - C b * X 1), X 1]
  let v : Fin 2 → A₂ := ![S, X 1]
  let A : A₂ →ₐ[L] A₂ := aeval U
  let B : A₂ →ₐ[L] A₂ := aeval v
  have hCa : (C a : A₂) ≠ 0 := C_ne_zero.mpr ha
  have hainv : (C a⁻¹ : A₂) * C a = 1 := by rw [← map_mul, inv_mul_cancel₀ ha, map_one]
  have hrestore : B.comp A = AlgHom.id L _ := by
    apply MvPolynomial.algHom_ext
    intro j
    simp only [AlgHom.comp_apply, AlgHom.id_apply, A, aeval_X]
    fin_cases j
    · change B (C a⁻¹ * (X 0 - C b * X 1)) = X 0
      have hBC (c : L) : B (C c) = C c := B.commutes c
      have hB0 : B (X 0) = S := aeval_X v 0
      have hB1 : B (X 1) = X 1 := aeval_X v 1
      rw [map_mul, map_sub, map_mul, hBC, hBC, hB0, hB1]
      change C a⁻¹ * (C a * X 0 + C b * X 1 - C b * X 1) = X 0
      rw [add_sub_cancel_right, ← mul_assoc, hainv, one_mul]
    · simp [U, B, v]
  have hpartial : pderiv 1 (A q) = 0 := by
    have h₀ : pderiv (1 : Fin 2) (U 0) = -(C a⁻¹ * C b) := by
      simp [U, pderiv_X, Finsupp.single_apply]
    have h₁ : pderiv (1 : Fin 2) (U 1) = 1 := by simp [U]
    have he : pderiv 1 q = (C a⁻¹ * C b) * pderiv 0 q := by
      apply mul_left_cancel₀ hCa
      calc
        C a * pderiv 1 q = C b * pderiv 0 q := (sub_eq_zero.mp hq).symm
        _ = C a * (C a⁻¹ * C b * pderiv 0 q) := by
          rw [← mul_assoc, ← mul_assoc, mul_comm (C a), hainv, one_mul]
    change pderiv 1 (aeval U q) = 0
    rw [pderiv_aeval, Fin.sum_univ_two, h₀, h₁, he]
    simp only [map_mul, aeval_C, algebraMap_eq, mul_one]
    ring
  have hlast : pderiv (Fin.last 1) (A q) = 0 := hpartial
  obtain ⟨p, hp⟩ := zero_last_partial_constructs_smaller_source_polynomial (A q) hlast
  let E := uniqueAlgEquiv L (Fin 1)
  have he : B.comp (rename Fin.castSucc) = (Polynomial.aeval S).comp E.toAlgHom := by
    apply MvPolynomial.algHom_ext
    intro i
    have hi : i = 0 := Subsingleton.elim _ _
    subst i
    simp only [AlgHom.comp_apply, rename_X, B, aeval_X, v]
    have heX : E (X (0 : Fin 1)) = Polynomial.X := by
      change eval₂ Polynomial.C (fun _ : Fin 1 => Polynomial.X) (X 0 : MvPolynomial (Fin 1) L) = _
      rw [eval₂_X]
    change S = Polynomial.aeval S (E (X 0))
    rw [heX, Polynomial.aeval_X]
  refine ⟨E p, ?_⟩
  calc
    q = B (A q) := (AlgHom.congr_fun hrestore q).symm
    _ = B (rename Fin.castSucc p) := by rw [hp]
    _ = Polynomial.aeval S (E p) := AlgHom.congr_fun he p

end DimensionFourDependence.Shear
