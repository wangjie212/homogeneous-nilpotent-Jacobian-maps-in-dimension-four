import DimensionFourDependence.ProjectiveChartOverlaps
import DimensionFourDependence.NormalizationLocalization

/-! # The common actual function field of the projective pencil charts

All chart fractions generate the same intermediate field in the source.
The canonical normalization of a chart is identified with its integral
closure in this actual chart field, so the principal-localization theorem
applies to the actual normalization rather than to an unrelated ring.
-/

namespace DimensionFourDependence

open MvPolynomial
open scoped IntermediateField.algebraAdjoinAdjoin

variable {C F : Type*} [Field C] [Field F] [Algebra C F]

/-- The actual field generated by a projective source chart's ratios. -/
noncomputable def projectiveCoordinateChartField (x : Fin 4 → F) (a : Fin 4) : IntermediateField C F :=
  IntermediateField.adjoin C (Set.range (fun i => x i / x a))

/-- The actual chart coordinate algebra includes into its actual field. -/
@[instance_reducible]
noncomputable def projectiveCoordinateChartFieldAlgebra (x : Fin 4 → F) (a : Fin 4) :
    Algebra (projectiveCoordinateChartAlgebra (C := C) x a)
      (projectiveCoordinateChartField (C := C) x a) := by
  change Algebra (Algebra.adjoin C (Set.range (fun i => x i / x a)))
    (IntermediateField.adjoin C (Set.range (fun i => x i / x a)))
  infer_instance

attribute [instance] projectiveCoordinateChartFieldAlgebra

/-- Changing the nonzero projective coordinate preserves the entire
actual chart function field inside the source. -/
theorem projectiveCoordinateChartField_independent (x : Fin 4 → F) (a b : Fin 4)
    (ha : x a ≠ 0) (hb : x b ≠ 0) :
    projectiveCoordinateChartField (C := C) x a = projectiveCoordinateChartField (C := C) x b := by
  have half (a b : Fin 4) (ha : x a ≠ 0) (hb : x b ≠ 0) :
      projectiveCoordinateChartField (C := C) x a ≤ projectiveCoordinateChartField (C := C) x b := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    have hi : x i / x b ∈ projectiveCoordinateChartField (C := C) x b :=
      IntermediateField.subset_adjoin C _ ⟨i, rfl⟩
    have hab : x a / x b ∈ projectiveCoordinateChartField (C := C) x b :=
      IntermediateField.subset_adjoin C _ ⟨a, rfl⟩
    have he : x i / x a = (x i / x b) / (x a / x b) := by field_simp
    dsimp only
    rw [he]
    exact IntermediateField.div_mem _ hi hab
  exact le_antisymm (half a b ha hb) (half b a hb ha)

/-- The actual projective chart field is a fraction field of its actual
coordinate algebra, with the original field inclusions. -/
theorem projectiveCoordinateChartField_isFractionRing (x : Fin 4 → F) (a : Fin 4) :
    IsFractionRing (projectiveCoordinateChartAlgebra (C := C) x a)
      (projectiveCoordinateChartField (C := C) x a) := by
  change IsFractionRing (Algebra.adjoin C (Set.range (fun i => x i / x a)))
    (IntermediateField.adjoin C (Set.range (fun i => x i / x a)))
  infer_instance

attribute [instance] projectiveCoordinateChartField_isFractionRing

/-- The canonical normalization is the integral closure in the actual
chart function field, compatibly over the entire coordinate algebra. -/
noncomputable def projectiveChartNormalizationActualFieldEquiv (x : Fin 4 → F) (a : Fin 4) :
    normalizationRing (projectiveCoordinateChartAlgebra (C := C) x a) ≃ₐ[projectiveCoordinateChartAlgebra (C := C) x a]
      integralClosure (projectiveCoordinateChartAlgebra (C := C) x a)
        (projectiveCoordinateChartField (C := C) x a) :=
  (IsLocalization.algEquiv (nonZeroDivisors (projectiveCoordinateChartAlgebra (C := C) x a))
    (FractionRing (projectiveCoordinateChartAlgebra (C := C) x a))
      (projectiveCoordinateChartField (C := C) x a)).mapIntegralClosure

variable {K : Type*} [Field K]

/-- The existing three-coordinate actual pencil chart equals the full
ratio-generated chart, including its coordinate equal to one. -/
theorem closedGaussPencilChartAlgebra_eq_projectiveCoordinateChart
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (s : Fin 4 ≃ Option (Fin 3)) :
    closedGaussPencilChartAlgebra H I s =
      projectiveCoordinateChartAlgebra (C := closedGaussParameterField H I)
        (rationalCoordinate (K := K) (n := 4)) (s.symm none) := by
  let C := closedGaussParameterField H I
  let x := rationalCoordinate (K := K) (n := 4)
  have hx : x (s.symm none) ≠ 0 := by
    simpa only [x, rationalCoordinate, map_zero] using
      (IsFractionRing.injective (MvPolynomial (Fin 4) K) (FractionRing (MvPolynomial (Fin 4) K))).ne
        (X_ne_zero (s.symm none))
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    exact projectiveCoordinateChartAlgebra_ratio_mem (C := C) x (s.symm none) (s.symm (some i))
  · apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    dsimp only
    rcases hsi : s i with _ | j
    · have hi : i = s.symm none := by rw [← hsi, s.symm_apply_apply]
      rw [hi, div_self hx]
      exact Subalgebra.one_mem _
    · have hi : i = s.symm (some j) := by rw [← hsi, s.symm_apply_apply]
      rw [hi]
      exact Algebra.subset_adjoin ⟨j, rfl⟩

/-- The actual closed Gauss pencil source charts have identical overlap
rings inside the original rational source field in either chart order. -/
theorem actual_closed_gauss_pencil_chart_overlap_identity
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (s t : Fin 4 ≃ Option (Fin 3)) :
    projectiveChartOverlap (C := closedGaussParameterField H I)
      (rationalCoordinate (K := K) (n := 4)) (s.symm none) (t.symm none) =
    projectiveChartOverlap (C := closedGaussParameterField H I)
      (rationalCoordinate (K := K) (n := 4)) (t.symm none) (s.symm none) := by
  have hx (i : Fin 4) : rationalCoordinate (K := K) i ≠ 0 := by
    simpa only [rationalCoordinate, map_zero] using
      (IsFractionRing.injective (MvPolynomial (Fin 4) K) (FractionRing (MvPolynomial (Fin 4) K))).ne
        (X_ne_zero i)
  exact projectiveChartOverlapAlgebra_symm (C := closedGaussParameterField H I) _ _ _
    (hx (s.symm none)) (hx (t.symm none))

/-- Every actual projective pencil chart has the same original-source
function field, independent of the selected nonzero source coordinate. -/
theorem actual_closed_gauss_pencil_chart_function_field_independent
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (s t : Fin 4 ≃ Option (Fin 3)) :
    projectiveCoordinateChartField (C := closedGaussParameterField H I)
      (rationalCoordinate (K := K) (n := 4)) (s.symm none) =
    projectiveCoordinateChartField (C := closedGaussParameterField H I)
      (rationalCoordinate (K := K) (n := 4)) (t.symm none) := by
  have hx (i : Fin 4) : rationalCoordinate (K := K) i ≠ 0 := by
    simpa only [rationalCoordinate, map_zero] using
      (IsFractionRing.injective (MvPolynomial (Fin 4) K) (FractionRing (MvPolynomial (Fin 4) K))).ne
        (X_ne_zero i)
  exact projectiveCoordinateChartField_independent (C := closedGaussParameterField H I) _ _ _
    (hx (s.symm none)) (hx (t.symm none))

end DimensionFourDependence
