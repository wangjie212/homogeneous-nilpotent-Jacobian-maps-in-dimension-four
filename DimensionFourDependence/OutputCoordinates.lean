import DimensionFourDependence.AlgebraicPartial

/-! # Identifying `K(Y)` with the field of the independent output coordinates -/

namespace DimensionFourDependence

open MvPolynomial

variable {K F : Type*} [Field K] [Field F] [Algebra K F] {n : ℕ}

/-- Algebraic independence of the outputs embeds the abstract rational
function field into the ambient source field. -/
noncomputable def rationalOutputHom (Y : Fin n → F) (hY : AlgebraicIndependent K Y) :
    FractionRing (MvPolynomial (Fin n) K) →ₐ[K] F :=
  IsFractionRing.liftAlgHom (algebraicIndependent_iff_injective_aeval.mp hY)

theorem rationalOutputHom_coordinate (Y : Fin n → F) (hY : AlgebraicIndependent K Y) (j : Fin n) :
    rationalOutputHom Y hY (rationalCoordinate (K := K) j) = Y j := by
  simp [rationalOutputHom, rationalCoordinate, IsFractionRing.lift_algebraMap]

/-- The embedding has exactly the field generated by the outputs as its
range. This verifies the identification written `K(Y)` in Lemma 2.2. -/
theorem rationalOutputHom_fieldRange (Y : Fin n → F) (hY : AlgebraicIndependent K Y) :
    (rationalOutputHom Y hY).fieldRange = IntermediateField.adjoin K (Set.range Y) := by
  apply IsFractionRing.liftAlgHom_fieldRange_eq_of_range_eq
  exact (Algebra.adjoin_range_eq_range_aeval K Y).symm

noncomputable def rationalOutputEquiv (Y : Fin n → F) (hY : AlgebraicIndependent K Y) :
    FractionRing (MvPolynomial (Fin n) K) ≃ₐ[K] IntermediateField.adjoin K (Set.range Y) :=
  (rationalOutputHom Y hY).equivFieldRange.trans
    (IntermediateField.equivOfEq (rationalOutputHom_fieldRange Y hY))

/-- Transport a derivation across an algebra isomorphism. -/
noncomputable def transportDerivation {E : Type*} [Field E] [Algebra K E]
    (e : E ≃ₐ[K] F) (D : Derivation K E E) : Derivation K F F where
  toLinearMap := e.toLinearMap.comp (D.toLinearMap.comp e.symm.toLinearMap)
  map_one_eq_zero' := by simp
  leibniz' := by
    intro x y
    change e (D (e.symm (x * y))) = x * e (D (e.symm y)) + y * e (D (e.symm x))
    rw [map_mul e.symm, D.leibniz]
    simp only [smul_eq_mul, map_add, map_mul, e.apply_symm_apply]

theorem transportDerivation_apply {E : Type*} [Field E] [Algebra K E]
    (e : E ≃ₐ[K] F) (D : Derivation K E E) (x : F) :
    transportDerivation e D x = e (D (e.symm x)) := rfl

theorem transportDerivation_apply_image {E : Type*} [Field E] [Algebra K E]
    (e : E ≃ₐ[K] F) (D : Derivation K E E) (x : E) :
    transportDerivation e D (e x) = e (D x) := by
  simp [transportDerivation_apply]

/-- The output coordinate, as an element of the output field. -/
noncomputable def outputCoordinate (Y : Fin n → F) (j : Fin n) :
    IntermediateField.adjoin K (Set.range Y) :=
  ⟨Y j, IntermediateField.subset_adjoin K (Set.range Y) ⟨j, rfl⟩⟩

theorem rationalOutputEquiv_coordinate (Y : Fin n → F) (hY : AlgebraicIndependent K Y)
    (j : Fin n) :
    rationalOutputEquiv Y hY (rationalCoordinate (K := K) j) = outputCoordinate Y j := by
  apply Subtype.ext
  exact rationalOutputHom_coordinate Y hY j

/-- The actual partial derivative on the subfield `K(Y)` of the source
field, rather than on an abstract isomorphic copy. -/
noncomputable def outputPartial (Y : Fin n → F) (hY : AlgebraicIndependent K Y) (i : Fin n) :
    Derivation K (IntermediateField.adjoin K (Set.range Y)) (IntermediateField.adjoin K (Set.range Y)) :=
  transportDerivation (rationalOutputEquiv Y hY) (rationalPartial (K := K) i)

theorem outputPartial_coordinate (Y : Fin n → F) (hY : AlgebraicIndependent K Y) (i j : Fin n) :
    outputPartial Y hY i (outputCoordinate Y j) = if j = i then 1 else 0 := by
  rw [← rationalOutputEquiv_coordinate Y hY j]
  change transportDerivation _ _ _ = _
  rw [transportDerivation_apply_image, rationalPartial_coordinate]
  by_cases hji : j = i <;> simp [hji]

theorem outputPartials_commute (Y : Fin n → F) (hY : AlgebraicIndependent K Y)
    (i j : Fin n) (x : IntermediateField.adjoin K (Set.range Y)) :
    outputPartial Y hY i (outputPartial Y hY j x) =
      outputPartial Y hY j (outputPartial Y hY i x) := by
  simp only [outputPartial, transportDerivation_apply, AlgEquiv.symm_apply_apply]
  rw [rationalPartials_commute]

end DimensionFourDependence
