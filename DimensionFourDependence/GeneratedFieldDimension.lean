import DimensionFourDependence.GeneratedAlgebraDimension

/-! # Dimension of fields generated by actual coordinate sets

The generated field is the fraction field of the generated algebra, so
both have the same transcendence degree. Consequently joint coordinate
fields satisfy the same dimension bound as the actual generator algebras.
-/

namespace DimensionFourDependence

universe u

variable {K F : Type u} [Field K] [Field F] [Algebra K F]

open scoped IntermediateField.algebraAdjoinAdjoin

/-- The actual field and actual algebra generated by the same coordinate
set have identical transcendence degrees over the original field. -/
theorem generatedField_trdeg_eq_generatedAlgebra (S : Set F) :
    Algebra.trdeg K (IntermediateField.adjoin K S) = Algebra.trdeg K (Algebra.adjoin K S) := by
  have he := trdeg_add_eq (A := IntermediateField.adjoin K S) K (Algebra.adjoin K S)
  simpa only [trdeg_eq_zero, add_zero] using he.symm

/-- The joint generated coordinate field has dimension at most the sum
of the two original generated coordinate field dimensions. -/
theorem generatedField_union_trdeg_le_sum (S T : Set F) :
    Algebra.trdeg K (IntermediateField.adjoin K (S ∪ T)) ≤
      Algebra.trdeg K (IntermediateField.adjoin K S) +
      Algebra.trdeg K (IntermediateField.adjoin K T) := by
  rw [generatedField_trdeg_eq_generatedAlgebra, generatedField_trdeg_eq_generatedAlgebra,
    generatedField_trdeg_eq_generatedAlgebra]
  exact adjoin_union_trdeg_le_sum S T

/-- A field generated by one actual scalar has transcendence degree at most one. -/
theorem generatedField_singleton_trdeg_le_one (a : F) :
    Algebra.trdeg K (IntermediateField.adjoin K {a}) ≤ 1 := by
  rw [generatedField_trdeg_eq_generatedAlgebra, adjoin_trdeg_eq_algebraic_matroid_rank]
  exact ((AlgebraicIndependent.matroid K F).cRk_le_cardinalMk {a}).trans_eq (by simp)

end DimensionFourDependence
