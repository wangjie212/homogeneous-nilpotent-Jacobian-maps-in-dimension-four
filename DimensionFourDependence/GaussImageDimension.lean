import DimensionFourDependence.GaussNormalChart
import DimensionFourDependence.CoefficientGaussRank
import DimensionFourDependence.FiberCoordinateRing

/-! # The Gauss-image function field and the coefficient Hessian rank

The field generated by the actual projective normal ratios is independent
of the chosen nonzero normal coordinate. Its transcendence degree is the
Gauss-image dimension. The genuine graph chart identifies this field with
the field generated by the actual coefficient gradient, whose dimension
has already been identified with the coefficient Hessian rank.
-/

namespace DimensionFourDependence

variable {K F : Type*} [Field K] [Field F] [Algebra K F] {n : ℕ}

/-- The function field of a projective coordinate image in a chosen affine chart. -/
noncomputable def projectiveRatioField (ν : Fin n → F) (a : Fin n) : IntermediateField K F :=
  IntermediateField.adjoin K (Set.range (fun i => ν i / ν a))

/-- The projective-ratio field is the actual fraction field of the
affine chart's coordinate ring, with its prime ideal of actual relations. -/
noncomputable def projectiveRatioCoordinateFunctionFieldEquiv (ν : Fin n → F) (a : Fin n) :
    FractionRing (MvPolynomial (Fin n) K ⧸ fiberVanishingIdeal (L := K) (fun i => ν i / ν a)) ≃ₐ[K]
      projectiveRatioField (K := K) ν a :=
  (IsFractionRing.algEquivOfAlgEquiv
    (K := FractionRing (MvPolynomial (Fin n) K ⧸ fiberVanishingIdeal (L := K) (fun i => ν i / ν a)))
    (L := FractionRing (fiberCoordinateAlgebra (L := K) (fun i => ν i / ν a)))
    (fiberCoordinateQuotientEquiv (L := K) (fun i => ν i / ν a))).trans
      ((fiberCoordinateFractionHom (L := K) (fun i => ν i / ν a)).equivFieldRange.trans
        (IntermediateField.equivOfEq (fiberCoordinateFractionHom_fieldRange (L := K) (fun i => ν i / ν a))))

/-- Changing a nonzero projective denominator does not change the actual image field. -/
theorem projectiveRatioField_chart_eq
    (ν : Fin n → F) (a b : Fin n) (ha : ν a ≠ 0) (hb : ν b ≠ 0) :
    projectiveRatioField (K := K) ν a = projectiveRatioField (K := K) ν b := by
  have hle (a b : Fin n) (ha : ν a ≠ 0) (hb : ν b ≠ 0) :
      projectiveRatioField (K := K) ν a ≤ projectiveRatioField (K := K) ν b := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    change ν i / ν a ∈ projectiveRatioField (K := K) ν b
    have he : ν i / ν a = (ν i / ν b) / (ν a / ν b) := by field_simp [ha, hb]
    rw [he]
    exact (projectiveRatioField (K := K) ν b).div_mem
      (IntermediateField.subset_adjoin K _ ⟨i, rfl⟩)
      (IntermediateField.subset_adjoin K _ ⟨a, rfl⟩)
  exact le_antisymm (hle a b ha hb) (hle b a hb ha)

/-- A genuine graph-normal chart has the function field of its negative gradient;
the last ratio is one and adds no generator. -/
theorem projectiveRatioField_graph_chart
    (ν : Fin 4 → F) (p : Equiv.Perm (Fin 4)) (z : Fin 3 → F)
    (hlast : ν (p 3) ≠ 0) (hcoord : ∀ i : Fin 3, ν (p i.castSucc) / ν (p 3) = -z i) :
    projectiveRatioField (K := K) ν (p 3) = IntermediateField.adjoin K (Set.range z) := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨j, rfl⟩
    obtain ⟨i, rfl⟩ := p.surjective j
    refine Fin.lastCases ?_ (fun i => ?_) i
    · change ν (p 3) / ν (p 3) ∈ _
      rw [div_self hlast]
      exact (IntermediateField.adjoin K (Set.range z)).one_mem
    · change ν (p i.castSucc) / ν (p 3) ∈ IntermediateField.adjoin K (Set.range z)
      rw [hcoord]
      exact (IntermediateField.adjoin K (Set.range z)).neg_mem (IntermediateField.subset_adjoin K _ ⟨i, rfl⟩)
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    change z i ∈ projectiveRatioField (K := K) ν (p 3)
    have he : ν (p i.castSucc) / ν (p 3) ∈ projectiveRatioField (K := K) ν (p 3) :=
      IntermediateField.subset_adjoin K _ ⟨p i.castSucc, rfl⟩
    rw [hcoord] at he
    simpa only [neg_neg] using (projectiveRatioField (K := K) ν (p 3)).neg_mem he

omit [Field F] [Algebra K F] in
/-- A genuine coordinate of the actual polynomial image normal. -/
noncomputable def imageNormalPivot (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H) : Fin 4 :=
  Classical.choose (show ∃ i, imageRelationNormal H I.equation i ≠ 0 from by
    simpa only [ne_eq, funext_iff, Pi.zero_apply, not_forall] using I.normal_ne_zero)

omit [Field F] [Algebra K F] in
/-- The chosen normal coordinate remains nonzero in the actual source field. -/
theorem imageNormalPivot_ne_zero
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H) :
    rationalImageNormal H I.equation (imageNormalPivot H I) ≠ 0 := by
  have hp := Classical.choose_spec (show ∃ i, imageRelationNormal H I.equation i ≠ 0 from by
    simpa only [ne_eq, funext_iff, Pi.zero_apply, not_forall] using I.normal_ne_zero)
  simpa only [rationalImageNormal, imageNormalPivot, map_zero] using
    (IsFractionRing.injective (MvPolynomial (Fin 4) K) (FractionRing (MvPolynomial (Fin 4) K))).ne hp

omit [Field F] [Algebra K F] in
/-- The dimension of the actual Gauss image, defined from its projective
normal-ratio function field, independently of an auxiliary graph chart. -/
noncomputable def gaussImageDimension
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H) : Cardinal :=
  Algebra.trdeg K (projectiveRatioField (K := K) (rationalImageNormal H I.equation) (imageNormalPivot H I))

omit [Field F] [Algebra K F] in
/-- The Gauss dimension is the transcendence degree of the actual
Gauss-chart coordinate-ring fraction field, not a differential-rank definition. -/
theorem gaussImageDimension_eq_coordinate_function_field_trdeg
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H) :
    gaussImageDimension H I = fiberCoordinateFunctionFieldTrdeg (L := K)
      (fun i => rationalImageNormal H I.equation i / rationalImageNormal H I.equation (imageNormalPivot H I)) := by
  exact (projectiveRatioCoordinateFunctionFieldEquiv (K := K)
    (rationalImageNormal H I.equation) (imageNormalPivot H I)).trdeg_eq.symm

variable [CharZero K]

omit [Field F] [Algebra K F] in
/-- The actual Gauss-image dimension is the rank of the actual
coefficient Hessian. Its chart, normal ratios and Jacobian criterion are derived. -/
theorem ImageRelationWitness.gauss_image_dimension_eq_hessian
    (H : Fin 4 → MvPolynomial (Fin 4) K) (p : Equiv.Perm (Fin 4))
    (hY : AlgebraicIndependent K (fun i : Fin 3 => algebraMap (MvPolynomial (Fin 4) K)
      (FractionRing (MvPolynomial (Fin 4) K)) (H (p i.castSucc))))
    (h : coefficientField (K := K) (fun i : Fin 3 => algebraMap (MvPolynomial (Fin 4) K)
      (FractionRing (MvPolynomial (Fin 4) K)) (H (p i.castSucc))))
    (hh : (h : FractionRing (MvPolynomial (Fin 4) K)) = algebraMap (MvPolynomial (Fin 4) K) _ (H (p 3)))
    (I : ImageRelationWitness H) :
    gaussImageDimension H I = (coefficientHessian
      (fun i : Fin 3 => algebraMap (MvPolynomial (Fin 4) K)
        (FractionRing (MvPolynomial (Fin 4) K)) (H (p i.castSucc))) hY h).rank := by
  obtain ⟨hlast, hcoord⟩ := I.gauss_chart_ratios H p hY h hh
  have he := projectiveRatioField_chart_eq (K := K) (rationalImageNormal H I.equation)
    (imageNormalPivot H I) (p 3) (imageNormalPivot_ne_zero H I) hlast
  unfold gaussImageDimension
  rw [he, projectiveRatioField_graph_chart _ p _ hlast hcoord]
  exact coefficient_gradient_image_trdeg _ hY h

omit [Field F] [Algebra K F] in
/-- The two-dimensional Gauss-image hypothesis supplies exactly the
rank-two coefficient Hessian required by the two-line construction. -/
theorem ImageRelationWitness.gauss_dimension_two_iff_hessian_rank_two
    (H : Fin 4 → MvPolynomial (Fin 4) K) (p : Equiv.Perm (Fin 4))
    (hY : AlgebraicIndependent K (fun i : Fin 3 => algebraMap (MvPolynomial (Fin 4) K)
      (FractionRing (MvPolynomial (Fin 4) K)) (H (p i.castSucc))))
    (h : coefficientField (K := K) (fun i : Fin 3 => algebraMap (MvPolynomial (Fin 4) K)
      (FractionRing (MvPolynomial (Fin 4) K)) (H (p i.castSucc))))
    (hh : (h : FractionRing (MvPolynomial (Fin 4) K)) = algebraMap (MvPolynomial (Fin 4) K) _ (H (p 3)))
    (I : ImageRelationWitness H) :
    gaussImageDimension H I = 2 ↔ (coefficientHessian
      (fun i : Fin 3 => algebraMap (MvPolynomial (Fin 4) K)
        (FractionRing (MvPolynomial (Fin 4) K)) (H (p i.castSucc))) hY h).rank = 2 := by
  rw [I.gauss_image_dimension_eq_hessian H p hY h hh]
  norm_cast

end DimensionFourDependence
