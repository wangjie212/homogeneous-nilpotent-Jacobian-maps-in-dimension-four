import DimensionFourDependence.GaussImageDimension
import DimensionFourDependence.GeneratedFieldDimension

/-! # The affine output field over its actual projective ratio field

One nonzero output coordinate and the actual ratios generate exactly
the original output field. If that output is transcendental over the
ratio field, the affine output field has one more transcendence degree.
-/

namespace DimensionFourDependence

universe u

variable {K F : Type u} [Field K] [Field F] [Algebra K F]

/-- The original affine output field is obtained from the actual
projective ratio field by adjoining any nonzero output coordinate. -/
theorem projectiveRatioField_adjoin_output_eq_full
    (Y : Fin 4 → F) (a : Fin 4) (ha : Y a ≠ 0) :
    (IntermediateField.adjoin (projectiveRatioField (K := K) Y a) {Y a}).restrictScalars K =
      fullOutputField (K := K) Y := by
  rw [projectiveRatioField, IntermediateField.adjoin_adjoin_left]
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    rcases hx with ⟨i, rfl⟩ | rfl
    · exact (fullOutputField (K := K) Y).div_mem
        (IntermediateField.subset_adjoin K _ ⟨i, rfl⟩)
        (IntermediateField.subset_adjoin K _ ⟨a, rfl⟩)
    · exact IntermediateField.subset_adjoin K _ ⟨a, rfl⟩
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    rw [← div_mul_cancel₀ (Y i) ha]
    exact (IntermediateField.adjoin K (Set.range (fun i => Y i / Y a) ∪ {Y a})).mul_mem
      (IntermediateField.subset_adjoin K _ (Or.inl ⟨i, rfl⟩))
      (IntermediateField.subset_adjoin K _ (Or.inr rfl))

/-- The field generated by one transcendental element has transcendence
degree exactly one, using its actual subfield in the ambient field. -/
theorem generatedField_singleton_trdeg_one_of_transcendental
    (x : F) (hx : Transcendental K x) :
    Algebra.trdeg K (IntermediateField.adjoin K {x}) = 1 := by
  let J := IntermediateField.adjoin K {x}
  have hzero : Algebra.trdeg K J ≠ 0 := by
    intro hz
    let : Algebra.IsAlgebraic K J := trdeg_eq_zero_iff.mp hz
    have hm : x ∈ J := IntermediateField.subset_adjoin K _ rfl
    have ha := Algebra.IsAlgebraic.isAlgebraic (R := K) (⟨x, hm⟩ : J)
    exact hx (ha.algHom (IsScalarTower.toAlgHom K J F))
  exact (Cardinal.le_one_iff.mp (generatedField_singleton_trdeg_le_one (K := K) x)).resolve_left hzero

/-- A transcendental nonzero output adds exactly one to the actual
projective ratio field's transcendence degree over the original field. -/
theorem fullOutputField_trdeg_eq_projectiveRatioField_add_one
    (Y : Fin 4 → F) (a : Fin 4) (ha : Y a ≠ 0)
    (ht : Transcendental (projectiveRatioField (K := K) Y a) (Y a)) :
    Algebra.trdeg K (fullOutputField (K := K) Y) =
      Algebra.trdeg K (projectiveRatioField (K := K) Y a) + 1 := by
  let R := projectiveRatioField (K := K) Y a
  let J := IntermediateField.adjoin R {Y a}
  have hd : Algebra.trdeg R J = 1 :=
    generatedField_singleton_trdeg_one_of_transcendental (K := R) (Y a) ht
  let : FaithfulSMul K R :=
    (faithfulSMul_iff_algebraMap_injective K R).mpr (algebraMap K R).injective
  let : FaithfulSMul R J :=
    (faithfulSMul_iff_algebraMap_injective R J).mpr (algebraMap R J).injective
  have he := trdeg_add_eq (A := J) K R
  rw [hd] at he
  calc
    _ = Algebra.trdeg K (J.restrictScalars K) := by
      rw [projectiveRatioField_adjoin_output_eq_full Y a ha]
    _ = Algebra.trdeg K J := rfl
    _ = _ := he.symm

end DimensionFourDependence
