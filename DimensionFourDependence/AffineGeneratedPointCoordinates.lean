import DimensionFourDependence.ProjectiveChartFunctionField

/-! # Original affine coordinates form a projective point in their own generated field -/

namespace DimensionFourDependence

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The projective point with unit selected coordinate and prescribed
three affine ratios, valued in the field generated by those ratios. -/
noncomputable def affineGeneratedPointCoordinate
    (y : Fin 3 → L) (s : Fin 4 ≃ Option (Fin 3)) (i : Fin 4) :
    IntermediateField.adjoin K (Set.range y) :=
  (s i).elim 1 (fun j => ⟨y j, IntermediateField.subset_adjoin K _ (Set.mem_range_self j)⟩)

/-- The selected coordinate is the actual unit in the point field. -/
theorem affineGeneratedPointCoordinate_pivot
    (y : Fin 3 → L) (s : Fin 4 ≃ Option (Fin 3)) :
    affineGeneratedPointCoordinate (K := K) y s (s.symm none) = 1 := by
  simp [affineGeneratedPointCoordinate]

/-- Every original affine value is preserved in its original coordinate label. -/
theorem affineGeneratedPointCoordinate_affine
    (y : Fin 3 → L) (s : Fin 4 ≃ Option (Fin 3)) (j : Fin 3) :
    (affineGeneratedPointCoordinate (K := K) y s (s.symm (some j)) : L) = y j := by
  simp [affineGeneratedPointCoordinate]

/-- The original projective ratios generate the whole point field;
no generation assumption on that point field is necessary. -/
theorem affineGeneratedPointCoordinate_chartField_top
    (y : Fin 3 → L) (s : Fin 4 ≃ Option (Fin 3)) :
    projectiveCoordinateChartField (C := K) (affineGeneratedPointCoordinate (K := K) y s)
      (s.symm none) = ⊤ := by
  let F := IntermediateField.adjoin K (Set.range y)
  let x := affineGeneratedPointCoordinate (K := K) y s
  let G := projectiveCoordinateChartField (C := K) x (s.symm none)
  have htop : (⊤ : IntermediateField K F).map F.val = F := by
    ext z
    constructor
    · rintro ⟨w, _, rfl⟩
      exact w.property
    · intro hz
      exact ⟨⟨z, hz⟩, by trivial, rfl⟩
  have hmap : G.map F.val = F := by
    apply le_antisymm
    · rintro z ⟨w, _, rfl⟩
      exact w.property
    · apply IntermediateField.adjoin_le_iff.mpr
      rintro _ ⟨j, rfl⟩
      have hmem : x (s.symm (some j)) / x (s.symm none) ∈ G :=
        IntermediateField.subset_adjoin K _ (Set.mem_range_self (s.symm (some j)))
      refine ⟨x (s.symm (some j)), ?_, affineGeneratedPointCoordinate_affine (K := K) y s j⟩
      change x (s.symm (some j)) ∈ G
      rwa [show x (s.symm none) = 1 from affineGeneratedPointCoordinate_pivot (K := K) y s,
        div_one] at hmem
  exact IntermediateField.map_injective F.val (hmap.trans htop.symm)

end DimensionFourDependence
