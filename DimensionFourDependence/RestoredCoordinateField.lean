import DimensionFourDependence.Defs

/-! # Restoring a projective frame preserves the actual affine source point field -/

namespace DimensionFourDependence

/-- A projective tuple is determined by its unit frame and the
three affine coordinates, in the prescribed original labels. -/
theorem restored_projective_coordinates_eq_of_frame_and_affine
    {F σ τ : Type*} [One F] (s : σ ≃ Option τ) (z : σ → F) (y : τ → F)
    (a : σ) (ha : s.symm none = a) (hframe : z a = 1)
    (haffine : ∀ j, z (s.symm (some j)) = y j) :
    z = fun i => (s i).elim 1 y := by
  have h (o : Option τ) : z (s.symm o) = o.elim 1 y := by
    cases o with
    | none => simpa only [ha, Option.elim_none] using hframe
    | some j => exact haffine j
  funext i
  exact (congrArg z (s.symm_apply_apply i)).symm.trans (h (s i))

variable {K F σ τ : Type*} [Field K] [Field F] [Algebra K F]

/-- Any property witnessed by an affine coordinate is witnessed
by a coordinate of the restored tuple with its original labels. -/
theorem exists_restored_projective_coordinate_of_affine
    (P : F → Prop) (s : σ ≃ Option τ) (y : τ → F) (h : ∃ j, P (y j)) :
    ∃ i, P ((s i).elim 1 y) := by
  obtain ⟨j, hj⟩ := h
  exact ⟨s.symm (some j), by simpa only [s.apply_symm_apply, Option.elim_some] using hj⟩

/-- Restoring the unit projective frame in the original coordinate
labels does not change the field generated by the affine coordinates. -/
theorem adjoin_restored_projective_coordinates_eq
    (s : σ ≃ Option τ) (y : τ → F) :
    IntermediateField.adjoin K (Set.range (fun i => (s i).elim 1 y)) =
      IntermediateField.adjoin K (Set.range y) := by
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    change (s i).elim 1 y ∈ IntermediateField.adjoin K (Set.range y)
    cases s i with
    | none => exact IntermediateField.one_mem _
    | some j => exact IntermediateField.subset_adjoin K _ (Set.mem_range_self j)
  · apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨j, rfl⟩
    exact IntermediateField.subset_adjoin K _
      ⟨s.symm (some j), by simp only [s.apply_symm_apply, Option.elim_some]⟩

end DimensionFourDependence
