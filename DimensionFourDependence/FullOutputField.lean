import DimensionFourDependence.FullSourceDegree

/-! # Relating the coefficient field to the full output field `K(H)`

Every output is algebraic over any independent output triple in rank
three. The three-output field and the full output field therefore have
the same relative algebraic closure in the actual source function field.
-/

namespace DimensionFourDependence

variable {K F : Type*} [Field K] [Field F] [Algebra K F] {m : ℕ}

/-- The actual field generated by all output coordinates. -/
@[reducible] noncomputable def fullOutputField (H : Fin m → F) : IntermediateField K F :=
  IntermediateField.adjoin K (Set.range H)

theorem outputTripleField_le_full (H : Fin 4 → F) (p : Equiv.Perm (Fin 4)) :
    IntermediateField.adjoin K (Set.range (fun i : Fin 3 => H (p i.castSucc))) ≤ fullOutputField (K := K) H := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro _ ⟨i, rfl⟩
  exact IntermediateField.subset_adjoin K _ ⟨p i.castSucc, rfl⟩

variable [CharZero K]

/-- Any independent triple in a rank-three rational map makes every output algebraic. -/
theorem outputs_algebraic_over_independent_triple
    (H : Fin 4 → FractionRing (MvPolynomial (Fin 4) K))
    (hrank : (rationalJacobian H).rank = 3) (p : Equiv.Perm (Fin 4))
    (hY : AlgebraicIndependent K (fun i : Fin 3 => H (p i.castSucc))) :
    ∀ j, IsAlgebraic (IntermediateField.adjoin K (Set.range (fun i : Fin 3 => H (p i.castSucc)))) (H j) := by
  let Y := fun i : Fin 3 => H (p i.castSucc)
  have hlast : IsAlgebraic (IntermediateField.adjoin K (Set.range Y)) (H (p (Fin.last 3))) := by
    by_contra ht
    have hopt := (hY.option_iff_transcendental (H (p (Fin.last 3)))).mpr
      (IntermediateField.transcendental_adjoin_iff.mp ht)
    let e := finSuccEquiv' (Fin.last 3)
    have hind : AlgebraicIndependent K (H ∘ p) := by
      convert hopt.comp e e.injective using 1
      funext j
      refine Fin.lastCases ?_ (fun i => ?_) j
      · simp [e]
      · simp only [e, finSuccEquiv'_below (Fin.castSucc_lt_last i), Option.elim_some, Function.comp_apply]
    have hfull : AlgebraicIndependent K H := by
      simpa only [Function.comp_def, Equiv.apply_symm_apply] using hind.comp p.symm p.symm.injective
    exact not_independent_of_jacobian_rank_three H hrank hfull
  have hfirst (i : Fin 3) : IsAlgebraic (IntermediateField.adjoin K (Set.range Y)) (H (p i.castSucc)) := by
    have hm : H (p i.castSucc) ∈ IntermediateField.adjoin K (Set.range Y) :=
      IntermediateField.subset_adjoin K _ ⟨i, rfl⟩
    change IsAlgebraic (IntermediateField.adjoin K (Set.range Y))
      (algebraMap (IntermediateField.adjoin K (Set.range Y)) (FractionRing (MvPolynomial (Fin 4) K))
        (⟨H (p i.castSucc), hm⟩ : IntermediateField.adjoin K (Set.range Y)))
    exact isAlgebraic_algebraMap _
  intro j
  rw [← p.apply_symm_apply j]
  exact Fin.lastCases hlast hfirst (p.symm j)

/-- Every element of `K(H)` is algebraic over the selected three-output field. -/
theorem fullOutputField_value_algebraic
    (H : Fin 4 → FractionRing (MvPolynomial (Fin 4) K))
    (hrank : (rationalJacobian H).rank = 3) (p : Equiv.Perm (Fin 4))
    (hY : AlgebraicIndependent K (fun i : Fin 3 => H (p i.castSucc)))
    (a : fullOutputField (K := K) H) :
    IsAlgebraic (IntermediateField.adjoin K (Set.range (fun i : Fin 3 => H (p i.castSucc))))
      (a : FractionRing (MvPolynomial (Fin 4) K)) := by
  let B := IntermediateField.adjoin K (Set.range (fun i : Fin 3 => H (p i.castSucc)))
  rcases a with ⟨a, ha⟩
  induction ha using IntermediateField.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    exact outputs_algebraic_over_independent_triple H hrank p hY j
  | algebraMap k =>
    have hk : algebraMap K (FractionRing (MvPolynomial (Fin 4) K)) k ∈ B := B.algebraMap_mem k
    change IsAlgebraic B (algebraMap B (FractionRing (MvPolynomial (Fin 4) K))
      (⟨algebraMap K (FractionRing (MvPolynomial (Fin 4) K)) k, hk⟩ : B))
    exact isAlgebraic_algebraMap _
  | add x y hx hy ihx ihy => exact ihx.add ihy
  | mul x y hx hy ihx ihy => exact ihx.mul ihy
  | inv x hx ih => exact ih.inv

theorem fullOutputField_mem_coefficientField
    (H : Fin 4 → FractionRing (MvPolynomial (Fin 4) K))
    (hrank : (rationalJacobian H).rank = 3) (p : Equiv.Perm (Fin 4))
    (hY : AlgebraicIndependent K (fun i : Fin 3 => H (p i.castSucc)))
    (a : fullOutputField (K := K) H) :
    (a : FractionRing (MvPolynomial (Fin 4) K)) ∈
      coefficientField (K := K) (fun i : Fin 3 => H (p i.castSucc)) :=
  mem_algebraicClosure_iff.mpr (fullOutputField_value_algebraic H hrank p hY a)

/-- Algebraicity over the full output field characterizes exactly the
actual coefficient field used by the fiber equations. -/
theorem fullOutput_algebraic_iff_coefficientField
    (H : Fin 4 → FractionRing (MvPolynomial (Fin 4) K))
    (hrank : (rationalJacobian H).rank = 3) (p : Equiv.Perm (Fin 4))
    (hY : AlgebraicIndependent K (fun i : Fin 3 => H (p i.castSucc)))
    (a : FractionRing (MvPolynomial (Fin 4) K)) :
    IsAlgebraic (fullOutputField (K := K) H) a ↔
      a ∈ coefficientField (K := K) (fun i : Fin 3 => H (p i.castSucc)) := by
  let B := IntermediateField.adjoin K (Set.range (fun i : Fin 3 => H (p i.castSucc)))
  let M := fullOutputField (K := K) H
  let : Algebra B M := (IntermediateField.inclusion (outputTripleField_le_full (K := K) H p)).toRingHom.toAlgebra
  let : IsScalarTower B M (FractionRing (MvPolynomial (Fin 4) K)) :=
    IsScalarTower.of_algebraMap_eq (by intro b; rfl)
  have : Algebra.IsAlgebraic B M := ⟨fun b => by
    apply (isAlgebraic_algebraMap_iff (algebraMap M (FractionRing (MvPolynomial (Fin 4) K))).injective).mp
    exact fullOutputField_value_algebraic H hrank p hY b⟩
  change IsAlgebraic M a ↔ a ∈ algebraicClosure B (FractionRing (MvPolynomial (Fin 4) K))
  rw [mem_algebraicClosure_iff]
  exact ⟨fun h => h.restrictScalars B, fun h => h.tower_top M⟩

end DimensionFourDependence
