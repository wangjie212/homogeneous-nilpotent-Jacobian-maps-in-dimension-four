import DimensionFourDependence.PrimeQuotientCodimensionOne
import DimensionFourDependence.GeneratedFieldDimension
import DimensionFourDependence.FiberCoordinateRing

/-! # The actual generated point field determines the height of its source prime -/

namespace DimensionFourDependence

universe u

variable {k L : Type u} [Field k] [Field L] [Algebra k L]

/-- The original polynomial relation quotient has precisely the
dimension of the actual field generated by the same coordinate values. -/
theorem coordinate_relation_quotient_trdeg_eq_generated_point_field
    (y : Fin 3 → L) :
    Algebra.trdeg k (MvPolynomial (Fin 3) k ⧸ fiberVanishingIdeal (L := k) y) =
      Algebra.trdeg k (IntermediateField.adjoin k (Set.range y)) :=
  (fiberCoordinateQuotientEquiv (L := k) y).trdeg_eq.trans
    (generatedField_trdeg_eq_generatedAlgebra (Set.range y)).symm

/-- A point whose three original affine values generate a
two-dimensional field has a genuine height-one prime of original
polynomial relations. -/
theorem coordinate_relation_prime_height_one_of_generated_field_trdeg_two
    (y : Fin 3 → L)
    (hy : Algebra.trdeg k (IntermediateField.adjoin k (Set.range y)) = 2) :
    (fiberVanishingIdeal (L := k) y).height = 1 :=
  prime_height_eq_one_of_quotient_trdeg_two (by simp) _
    ((coordinate_relation_quotient_trdeg_eq_generated_point_field y).trans hy)

variable {A : Type u} [CommRing A]

/-- The canonical action of the original ring on its prime residue
fraction field, fixed before substituting a nested coordinate ring. -/
@[instance_reducible]
noncomputable def primeQuotientFractionOriginalAlgebra
    (Q : Ideal A) [Q.IsPrime] : Algebra A (FractionRing (A ⧸ Q)) := inferInstance

/-- The kernel of the actual prime residue fraction map is exactly
the original prime, before choosing coordinates or a local model. -/
theorem prime_quotient_fraction_algebraMap_ker
    (Q : Ideal A) [Q.IsPrime] :
    RingHom.ker (algebraMap A (FractionRing (A ⧸ Q))) = Q := by
  ext a
  change algebraMap A (FractionRing (A ⧸ Q)) a = 0 ↔ a ∈ Q
  rw [IsScalarTower.algebraMap_apply A (A ⧸ Q) (FractionRing (A ⧸ Q))]
  change algebraMap (A ⧸ Q) (FractionRing (A ⧸ Q)) (Ideal.Quotient.mk Q a) = 0 ↔ _
  rw [← map_zero (algebraMap (A ⧸ Q) (FractionRing (A ⧸ Q))),
    (IsFractionRing.injective (A ⧸ Q) (FractionRing (A ⧸ Q))).eq_iff]
  exact Ideal.Quotient.eq_zero_iff_mem

/-- The canonical residue fraction map retains the original
coordinate inclusion through the actual normalization. -/
theorem normalization_prime_residue_source_value
    (Q : Ideal (normalizationRing A)) [Q.IsPrime] (a : A) :
    algebraMap (normalizationRing A) (FractionRing (normalizationRing A ⧸ Q))
        (algebraMap A (normalizationRing A) a) =
      algebraMap A (FractionRing (normalizationRing A ⧸ Q)) a :=
  (IsScalarTower.algebraMap_apply A (normalizationRing A)
    (FractionRing (normalizationRing A ⧸ Q)) a).symm

end DimensionFourDependence
