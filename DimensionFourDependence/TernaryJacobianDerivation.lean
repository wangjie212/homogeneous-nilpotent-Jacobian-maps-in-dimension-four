import DimensionFourDependence.TernaryGraphCrossIdentities
import DimensionFourDependence.RectangularJacobianRank
import Mathlib.LinearAlgebra.CrossProduct

/-! # The actual Jacobian derivation and its constants for the embedded ternary curve -/

namespace DimensionFourDependence

open MvPolynomial Matrix

variable {K : Type*} [Field K] [CharZero K]
local notation "F" => FractionRing (MvPolynomial (Fin 3) K)

noncomputable def ternaryRationalGradient (f : F) : Fin 3 → F :=
  fun i => rationalPartial (K := K) i f

noncomputable def ternaryJacobianDirection (u v : F) : Fin 3 → F :=
  ternaryCrossProduct (ternaryRationalGradient u) (ternaryRationalGradient v)

noncomputable def ternaryJacobianDerivation (u v : F) : Derivation K F F :=
  sourceVectorDerivation (ternaryJacobianDirection u v)

theorem ternaryJacobianDirection_ne_zero
    (Y : Fin 2 → F) (hY : AlgebraicIndependent K Y) :
    ternaryJacobianDirection (Y 0) (Y 1) ≠ 0 := by
  have h := rationalJacobian_rows_independent Y hY
  have hrow : (rationalJacobian Y).row = ![ternaryRationalGradient (Y 0), ternaryRationalGradient (Y 1)] := by
    funext i
    fin_cases i <;> rfl
  rw [hrow] at h
  unfold ternaryJacobianDirection
  change crossProduct (ternaryRationalGradient (Y 0)) (ternaryRationalGradient (Y 1)) ≠ 0
  exact crossProduct_ne_zero_iff_linearIndependent.mpr h

theorem ternaryJacobianDerivation_apply_coordinate (u v : F) (j : Fin 3) :
    ternaryJacobianDerivation u v (rationalCoordinate (K := K) j) = ternaryJacobianDirection u v j :=
  sourceVectorDerivation_coordinate _ _

theorem ternaryJacobianDerivation_kills_pair (Y : Fin 2 → F) (i : Fin 2) :
    ternaryJacobianDerivation (Y 0) (Y 1) (Y i) = 0 := by
  rw [ternaryJacobianDerivation, sourceVectorDerivation_apply]
  change ternaryJacobianDirection (Y 0) (Y 1) ⬝ᵥ ternaryRationalGradient (Y i) = 0
  fin_cases i
  · exact ternaryCrossProduct_dot_left _ _
  · exact ternaryCrossProduct_dot_right _ _

/-- The constant field of the actual nonzero cross-product derivation
is the relative algebraic closure of the field generated by the pair. -/
theorem ternaryJacobianDerivation_constants (Y : Fin 2 → F) (hY : AlgebraicIndependent K Y) :
    derivationConstants (ternaryJacobianDerivation (Y 0) (Y 1)) =
      (coefficientField (K := K) Y).restrictScalars K := by
  apply vertical_constants_eq_coefficient_field Y _
    (sourceVectorDerivation_ne_zero _ (ternaryJacobianDirection_ne_zero Y hY))
    (ternaryJacobianDerivation_kills_pair Y)
  apply relative_trdeg_le_one_of_independent_outputs Y hY
  rw [rationalSource_trdeg_eq (n := 3)]
  norm_num

end DimensionFourDependence
