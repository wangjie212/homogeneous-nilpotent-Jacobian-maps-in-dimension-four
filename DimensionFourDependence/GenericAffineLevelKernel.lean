import DimensionFourDependence.GenericSourcePencilKernel
import Mathlib.RingTheory.MvPolynomial.Localization

/-! # The whole relation kernel of an actual affine polynomial level

Algebraic independence of the actual source coordinates and the identity
t=P(x) give the full rational-parameter kernel, generated by P-T. Parameter
coefficient denominators are cleared, and the factor theorem is applied
to the independent polynomial parameter before returning to K(T)[x].
-/

namespace DimensionFourDependence

open MvPolynomial

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 100000

variable {K F : Type*} [Field K] [Field F] [Algebra K F] {n : ℕ}

/-- The affine level equation over the independent rational parameter field. -/
noncomputable def genericAffineLevelEquation (P : MvPolynomial (Fin n) K) :
    MvPolynomial (Fin n) (RatFunc K) :=
  MvPolynomial.map (algebraMap K (RatFunc K)) P - C RatFunc.X

/-- Swapping the source and polynomial parameter preserves every original
source polynomial as a constant in the independent parameter. -/
theorem parameterSourceSwap_generic_map_source (P : MvPolynomial (Fin n) K) :
    parameterSourceSwap K n (MvPolynomial.map Polynomial.C P) = Polynomial.C P := by
  induction P using MvPolynomial.induction_on with
  | C k => rw [MvPolynomial.map_C, parameterSourceSwap_C_C]
  | add p q hp hq => rw [map_add, map_add, hp, hq, Polynomial.C_add]
  | mul_X p i hp =>
    rw [map_mul, MvPolynomial.map_X, map_mul, hp, parameterSourceSwap_X, Polynomial.C_mul]

/-- The source/parameter swap has the exact actual value for arbitrary
original coordinate values and the given rational parameter embedding. -/
theorem parameterSourceSwap_generic_evaluation
    (f : RatFunc K →ₐ[K] F) (x : Fin n → F) (A : MvPolynomial (Fin n) (Polynomial K)) :
    Polynomial.eval₂ (aeval x).toRingHom (f RatFunc.X) (parameterSourceSwap K n A) =
      MvPolynomial.eval₂ f.toRingHom x (MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K)) A) := by
  induction A using MvPolynomial.induction_on with
  | C r =>
    rw [parameterSourceSwap_C, Polynomial.eval₂_map, MvPolynomial.map_C, eval₂_C]
    have hc : (aeval x).toRingHom.comp C = algebraMap K F := by
      ext c
      simp
    rw [hc]
    exact (rational_function_algHom_polynomial_value f r).symm
  | add A B hA hB => simp only [map_add, Polynomial.eval₂_add, eval₂_add, hA, hB]
  | mul_X A i hA =>
    rw [map_mul, parameterSourceSwap_X, Polynomial.eval₂_mul, Polynomial.eval₂_C,
      map_mul, MvPolynomial.map_X, eval₂_mul, eval₂_X, hA]
    change _ * aeval x (X i) = _
    rw [aeval_X]

/-- The actual polynomial-parameter lift maps to the full affine level equation. -/
theorem genericAffineLevelEquation_lift (P : MvPolynomial (Fin n) K) :
    MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K))
      (MvPolynomial.map Polynomial.C P - C Polynomial.X) = genericAffineLevelEquation P := by
  simp only [map_sub, MvPolynomial.map_C, MvPolynomial.map_map, genericAffineLevelEquation,
    RatFunc.algebraMap_X]
  rfl

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- The entire actual relation kernel over the rational parameter is
exactly divisibility by P-T, with original source independence explicit. -/
theorem generic_affine_level_dvd_iff_actual_evaluation_zero
    (P : MvPolynomial (Fin n) K) (x : Fin n → F) (hx : AlgebraicIndependent K x)
    (f : RatFunc K →ₐ[K] F) (ht : f RatFunc.X = aeval x P)
    (B : MvPolynomial (Fin n) (RatFunc K)) :
    genericAffineLevelEquation P ∣ B ↔ MvPolynomial.eval₂ f.toRingHom x B = 0 := by
  let v := MvPolynomial.eval₂Hom f.toRingHom x
  let L : MvPolynomial (Fin n) (Polynomial K) := MvPolynomial.map Polynomial.C P - C Polynomial.X
  have hsource (p : MvPolynomial (Fin n) K) :
      MvPolynomial.eval₂ f.toRingHom x (MvPolynomial.map (algebraMap K (RatFunc K)) p) = aeval x p := by
    have hc : f.toRingHom.comp (algebraMap K (RatFunc K)) = algebraMap K F := by
      ext c
      exact f.commutes c
    rw [eval₂_map, hc]
    rfl
  have hv : v (genericAffineLevelEquation P) = 0 := by
    change MvPolynomial.eval₂ f.toRingHom x (genericAffineLevelEquation P) = 0
    rw [genericAffineLevelEquation, eval₂_sub, hsource, eval₂_C]
    change aeval x P - f RatFunc.X = 0
    rw [ht, sub_self]
  constructor
  · rintro ⟨A, rfl⟩
    change v (genericAffineLevelEquation P * A) = 0
    rw [map_mul, hv, zero_mul]
  · intro hB
    let S := (nonZeroDivisors (Polynomial K)).map
      (C : Polynomial K →+* MvPolynomial (Fin n) (Polynomial K))
    obtain ⟨d, A, hA⟩ := IsLocalization.exists_integer_multiple S B
    obtain ⟨r, hr, hdr⟩ := d.property
    have hAr : MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K)) A =
        C (algebraMap (Polynomial K) (RatFunc K) r) * B := by
      change algebraMap (MvPolynomial (Fin n) (Polynomial K)) (MvPolynomial (Fin n) (RatFunc K)) A = _
      rw [hA, Algebra.smul_def, ← hdr, MvPolynomial.algebraMap_def, MvPolynomial.map_C]
    have hAz : Polynomial.eval₂ (aeval x).toRingHom (f RatFunc.X) (parameterSourceSwap K n A) = 0 := by
      rw [parameterSourceSwap_generic_evaluation, hAr, eval₂_mul, hB, mul_zero]
    have hroot : Polynomial.eval P (parameterSourceSwap K n A) = 0 := by
      apply algebraicIndependent_iff_injective_aeval.mp hx
      rw [map_zero]
      rw [ht] at hAz
      change Polynomial.eval₂ (aeval x).toRingHom ((aeval x).toRingHom P) _ = 0 at hAz
      rw [Polynomial.eval₂_at_apply] at hAz
      exact hAz
    have hdiv : Polynomial.X - Polynomial.C P ∣ parameterSourceSwap K n A :=
      Polynomial.dvd_iff_isRoot.mpr hroot
    have hL : parameterSourceSwap K n L = -(Polynomial.X - Polynomial.C P) := by
      rw [map_sub, parameterSourceSwap_generic_map_source, parameterSourceSwap_C_X]
      ring
    have hLA : L ∣ A := by
      obtain ⟨D, hD⟩ : parameterSourceSwap K n L ∣ parameterSourceSwap K n A := by
        rw [hL]
        exact neg_dvd.mpr hdiv
      refine ⟨(parameterSourceSwap K n).symm D, ?_⟩
      apply (parameterSourceSwap K n).injective
      rw [map_mul, AlgEquiv.apply_symm_apply]
      exact hD
    have hdivB : genericAffineLevelEquation P ∣ C (algebraMap (Polynomial K) (RatFunc K) r) * B := by
      rw [← hAr, ← genericAffineLevelEquation_lift]
      exact map_dvd (MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K))) hLA
    have hr0 : algebraMap (Polynomial K) (RatFunc K) r ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hr
    have hunit : IsUnit (C (algebraMap (Polynomial K) (RatFunc K) r) : MvPolynomial (Fin n) (RatFunc K)) :=
      (isUnit_iff_ne_zero.mpr hr0).map C
    exact hunit.dvd_mul_left.mp hdivB

/-- The full original affine relation ideal is principal with its
actual independent-parameter level equation as generator. -/
theorem generic_affine_level_actual_evaluation_kernel
    (P : MvPolynomial (Fin n) K) (x : Fin n → F) (hx : AlgebraicIndependent K x)
    (f : RatFunc K →ₐ[K] F) (ht : f RatFunc.X = aeval x P) :
    RingHom.ker (MvPolynomial.eval₂Hom f.toRingHom x) = Ideal.span {genericAffineLevelEquation P} := by
  ext B
  change MvPolynomial.eval₂ f.toRingHom x B = 0 ↔ _
  rw [Ideal.mem_span_singleton, generic_affine_level_dvd_iff_actual_evaluation_zero P x hx f ht B]

end DimensionFourDependence
