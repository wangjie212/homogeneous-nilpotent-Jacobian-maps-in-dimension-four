import DimensionFourDependence.StableShear

/-! # Polynomial tame automorphisms

The tame subgroup is generated by affine automorphisms and elementary shears
whose added polynomial does not contain the moved variable. Automorphisms act
on the polynomial algebra, so multiplication is composition of substitutions.
This reverses the order of composition of the corresponding point maps.
-/

namespace DimensionFourDependence.Tame

open MvPolynomial

variable {R : Type*} [CommRing R] {n : ℕ}

/-- An affine polynomial algebra automorphism has affine coordinate images. -/
def IsAffine (e : MvPolynomial (Fin n) R ≃ₐ[R] MvPolynomial (Fin n) R) : Prop :=
  ∀ i, (e (X i)).totalDegree ≤ 1

/-- Elementary coordinate additions, with actual variable independence. -/
def IsElementary (e : MvPolynomial (Fin n) R ≃ₐ[R] MvPolynomial (Fin n) R) : Prop :=
  ∃ (i : Fin n) (p : MvPolynomial (Fin n) R), i ∉ p.vars ∧
    ∀ j, e (X j) = X j + if j = i then p else 0

/-- The usual tame subgroup of polynomial algebra automorphisms. -/
noncomputable def subgroup (R : Type*) [CommRing R] (n : ℕ) :
    Subgroup (MvPolynomial (Fin n) R ≃ₐ[R] MvPolynomial (Fin n) R) :=
  Subgroup.closure {e | IsAffine e ∨ IsElementary e}

@[irreducible] noncomputable def elementarySubstitution
    (i : Fin n) (p : MvPolynomial (Fin n) R) :
    MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin n) R :=
  aeval (fun j => X j + if j = i then p else 0)

theorem elementarySubstitution_X (i : Fin n) (p : MvPolynomial (Fin n) R) (j : Fin n) :
    elementarySubstitution i p (X j) = X j + if j = i then p else 0 := by
  simp [elementarySubstitution]

theorem elementarySubstitution_fixed (i : Fin n) (p q : MvPolynomial (Fin n) R)
    (hq : i ∉ q.vars) : elementarySubstitution i p q = q := by
  unfold elementarySubstitution
  change eval₂Hom C (fun j => X j + if j = i then p else 0) q = q
  calc
    _ = eval₂Hom C (fun j => X j) q := by
      apply eval₂Hom_congr' rfl _ rfl
      intro j hj _
      have hji : j ≠ i := fun h => hq (h ▸ hj)
      simp [hji]
    _ = q := by simp

theorem elementarySubstitution_add (i : Fin n) (p q : MvPolynomial (Fin n) R)
    (hq : i ∉ q.vars) :
    (elementarySubstitution i p).comp (elementarySubstitution i q) =
      elementarySubstitution i (p + q) := by
  apply MvPolynomial.algHom_ext
  intro j
  simp only [AlgHom.comp_apply, elementarySubstitution_X]
  by_cases hji : j = i
  · subst j
    simp only [ite_true]
    rw [map_add, elementarySubstitution_X, elementarySubstitution_fixed i p q hq]
    simp [add_assoc]
  · simp [hji, elementarySubstitution_X]

theorem elementarySubstitution_zero (i : Fin n) :
    elementarySubstitution i (0 : MvPolynomial (Fin n) R) = AlgHom.id R _ := by
  apply MvPolynomial.algHom_ext
  intro j
  simp [elementarySubstitution_X]

/-- An elementary shear is a polynomial automorphism; its inverse subtracts
the same polynomial. -/
noncomputable def elementary (i : Fin n) (p : MvPolynomial (Fin n) R)
    (hp : i ∉ p.vars) : MvPolynomial (Fin n) R ≃ₐ[R] MvPolynomial (Fin n) R :=
  AlgEquiv.ofAlgHom (elementarySubstitution i p) (elementarySubstitution i (-p))
    (by rw [elementarySubstitution_add i p (-p) (by simpa [vars_neg] using hp),
      add_neg_cancel, elementarySubstitution_zero])
    (by rw [elementarySubstitution_add i (-p) p hp,
      neg_add_cancel, elementarySubstitution_zero])

theorem elementary_X (i : Fin n) (p : MvPolynomial (Fin n) R)
    (hp : i ∉ p.vars) (j : Fin n) :
    elementary i p hp (X j) = X j + if j = i then p else 0 :=
  elementarySubstitution_X i p j

theorem elementary_inv_X (i : Fin n) (p : MvPolynomial (Fin n) R)
    (hp : i ∉ p.vars) (j : Fin n) :
    (elementary i p hp)⁻¹ (X j) = X j + if j = i then -p else 0 :=
  elementarySubstitution_X i (-p) j

theorem elementary_mem (i : Fin n) (p : MvPolynomial (Fin n) R) (hp : i ∉ p.vars) :
    elementary i p hp ∈ subgroup R n :=
  Subgroup.subset_closure (Or.inr ⟨i, p, hp, elementary_X i p hp⟩)

theorem elementary_fixed (i : Fin n) (p q : MvPolynomial (Fin n) R)
    (hp : i ∉ p.vars) (hq : i ∉ q.vars) : elementary i p hp q = q :=
  elementarySubstitution_fixed i p q hq

theorem elementary_inv_fixed (i : Fin n) (p q : MvPolynomial (Fin n) R)
    (hp : i ∉ p.vars) (hq : i ∉ q.vars) : (elementary i p hp)⁻¹ q = q :=
  elementarySubstitution_fixed i (-p) q hq

/-- Substitution preserves independence of a variable when every substituted
coordinate is independent of that variable. -/
theorem notMem_vars_aeval {m : ℕ} (g : Fin m → MvPolynomial (Fin n) R)
    (f : MvPolynomial (Fin m) R) (i : Fin n) (hg : ∀ j, i ∉ (g j).vars) :
    i ∉ (aeval g f).vars := by
  induction f using MvPolynomial.induction_on with
  | C c => simp [vars_C]
  | add p q hp hq =>
    rw [map_add]
    intro h
    exact (Finset.mem_union.mp (vars_add_subset _ _ h)).elim hp hq
  | mul_X p j hp =>
    rw [map_mul, aeval_X]
    intro h
    exact (Finset.mem_union.mp (vars_mul _ _ h)).elim hp (hg j)

/-- The universal property of the polynomial algebra, in pointwise form. -/
theorem algHom_aeval {m s : ℕ}
    (e : MvPolynomial (Fin n) R →ₐ[R] MvPolynomial (Fin s) R)
    (g : Fin m → MvPolynomial (Fin n) R) (f : MvPolynomial (Fin m) R) :
    e (aeval g f) = aeval (fun j => e (g j)) f := by
  have h : e.comp (aeval g) = aeval (fun j => e (g j)) := by
    apply MvPolynomial.algHom_ext
    intro j
    simp
  exact AlgHom.congr_fun h f

/-- An abstract computation for the active coordinates of the commutator
in (6.11). Its hypotheses name every invariance needed by the computation. -/
theorem commutator_active {A : Type*} [CommRing A] [Algebra R A]
    (u v : A ≃ₐ[R] A) (x d w p : A)
    (hux : u x = x + d * w) (huix : u⁻¹ x = x - d * w)
    (hvx : v x = x) (hvix : v⁻¹ x = x)
    (hvd : v d = d) (huid : u⁻¹ d = d) (hvid : v⁻¹ d = d)
    (hvw : v w = w + p) (huiw : u⁻¹ w = w)
    (huip : u⁻¹ p = p) (hvip : v⁻¹ p = p) :
    (v⁻¹ * u⁻¹ * v * u) x = x + d * p := by
  simp only [AlgEquiv.mul_apply, hux, map_add, map_mul, hvx, hvd, hvw,
    huix, huid, huiw, huip, map_sub, hvix, hvid, hvip]
  ring

/-- The same abstract computation fixes the auxiliary coordinate. -/
theorem commutator_aux {A : Type*} [CommRing A] [Algebra R A]
    (u v : A ≃ₐ[R] A) (w p : A)
    (huw : u w = w) (huiw : u⁻¹ w = w)
    (hvw : v w = w + p) (hviw : v⁻¹ w = w - p)
    (huip : u⁻¹ p = p) (hvip : v⁻¹ p = p) :
    (v⁻¹ * u⁻¹ * v * u) w = w := by
  simp only [AlgEquiv.mul_apply, huw, hvw, map_add, huiw, huip, hviw, hvip]
  ring

theorem commutator_fixed {A : Type*} [CommRing A] [Algebra R A]
    (u v : A ≃ₐ[R] A) (z : A) (hu : u z = z) (hv : v z = z) :
    (v⁻¹ * u⁻¹ * v * u) z = z := by
  have hui : u⁻¹ z = z := by apply u.injective; simp [hu]
  have hvi : v⁻¹ z = z := by apply v.injective; simp [hv]
  simp only [AlgEquiv.mul_apply, hu, hv, hui, hvi]

theorem algHom_shear_add {A : Type*} [CommRing A] [Algebra R A]
    (e : A →ₐ[R] A) (x d p q : A) (hx : e x = x + d * p)
    (hd : e d = d) (hq : e q = q) : e (x + d * q) = x + d * (p + q) := by
  rw [map_add, map_mul, hx, hd, hq]
  ring

theorem algHom_shear_sub {A : Type*} [CommRing A] [Algebra R A]
    (e : A →ₐ[R] A) (x d p q : A) (hx : e x = x - d * p)
    (hd : e d = d) (hq : e q = q) : e (x - d * q) = x - d * (p + q) := by
  rw [map_sub, map_mul, hx, hd, hq]
  ring

/-- Composition of shear coordinates in an arbitrary commutative algebra. -/
theorem comp_shear_coordinates {A : Type*} [CommRing A] [Algebra R A]
    (u v t : A →ₐ[R] A) (x : Fin 4 → A) (a b p q : A)
    (hu : ∀ j, u (x j) = ![x 0 + b * p, x 1 - a * p, x 2, x 3] j)
    (hv : ∀ j, v (x j) = ![x 0 + b * q, x 1 - a * q, x 2, x 3] j)
    (ht : ∀ j, t (x j) = ![x 0 + b * (p + q), x 1 - a * (p + q), x 2, x 3] j)
    (ha : u a = a) (hb : u b = b) (hq : u q = q) : ∀ j, u (v (x j)) = t (x j) := by
  intro j
  refine Fin.cases ?_ (Fin.cases ?_ (Fin.cases ?_ (Fin.cases ?_ (fun i => Fin.elim0 i)))) j
  · exact (congrArg u (hv 0)).trans
      ((algHom_shear_add u (x 0) b p q (hu 0) hb hq).trans (ht 0).symm)
  · exact (congrArg u (hv 1)).trans
      ((algHom_shear_sub u (x 1) a p q (hu 1) ha hq).trans (ht 1).symm)
  · exact (congrArg u (hv 2)).trans ((hu 2).trans (ht 2).symm)
  · exact (congrArg u (hv 3)).trans ((hu 3).trans (ht 3).symm)

/-- Composition of the corresponding polynomial algebra substitutions. -/
theorem comp_shear4
    (u v t : MvPolynomial (Fin 4) R →ₐ[R] MvPolynomial (Fin 4) R)
    (a b p q : MvPolynomial (Fin 4) R)
    (hu : ∀ j, u (X j) = ![X 0 + b * p, X 1 - a * p, X 2, X 3] j)
    (hv : ∀ j, v (X j) = ![X 0 + b * q, X 1 - a * q, X 2, X 3] j)
    (ht : ∀ j, t (X j) = ![X 0 + b * (p + q), X 1 - a * (p + q), X 2, X 3] j)
    (ha : u a = a) (hb : u b = b) (hq : u q = q) : u.comp v = t :=
  MvPolynomial.algHom_ext (comp_shear_coordinates u v t X a b p q hu hv ht ha hb hq)

end DimensionFourDependence.Tame
