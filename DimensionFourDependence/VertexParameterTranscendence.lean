import DimensionFourDependence.ReducedPencilVertexDifferential
import DimensionFourDependence.RectangularJacobianRank

/-! # A vertex-dependent reduced pencil is transcendental over the transverse field

The actual rational vertex derivative is nonzero. Its coordinate
derivation kills the entire field generated by the transverse source
coordinates, so the parameter cannot be algebraic over that field.
The original transverse coordinates together with the actual parameter
are therefore algebraically independent over the original constants.
-/

namespace DimensionFourDependence

open MvPolynomial

variable {K : Type*} [Field K] [CharZero K] {n : ℕ}

/-- The actual original reduced homogeneous parameter quotient has
a nonzero rational derivative in every genuinely occurring vertex variable. -/
theorem reduced_vertex_parameter_rational_partial_ne_zero
    (p q : MvPolynomial (Fin n) K) (hp0 : p ≠ 0) (hq0 : q ≠ 0) (hrel : IsRelPrime p q)
    {d e : ℕ} (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous e) (i : Fin n)
    (hvertex : 0 < p.degreeOf i ∨ 0 < q.degreeOf i) :
    rationalPartial (K := K) i
      (algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K)) p /
        algebraMap (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K)) q) ≠ 0 := by
  let S := MvPolynomial (Fin n) K
  let F := FractionRing S
  have hWr := reduced_homogeneous_vertex_dependent_pencil_wronskian_ne_zero p q hp0 hrel hp hq i hvertex
  have hqF : algebraMap S F q ≠ 0 := by
    simpa only [map_zero] using (IsFractionRing.injective S F).ne hq0
  intro hz
  rw [Derivation.leibniz_div, rationalPartial_polynomial, rationalPartial_polynomial] at hz
  simp only [smul_eq_mul] at hz
  have hnum := (mul_eq_zero.mp hz).resolve_left (pow_ne_zero 2 (inv_ne_zero hqF))
  apply hWr
  apply IsFractionRing.injective S F
  simpa only [map_sub, map_mul, map_zero] using hnum

variable {F σ : Type*} [Field F] [Algebra K F]

/-- A derivation killing specified coordinates but not a parameter
proves transcendence over their entire actual generated field. -/
theorem nonzero_derivation_value_transcendental_over_coordinate_field
    (D : Derivation K F F) (x : σ → F) (hx : ∀ i, D (x i) = 0)
    (t : F) (ht : D t ≠ 0) :
    Transcendental (IntermediateField.adjoin K (Set.range x)) t := by
  let J := IntermediateField.adjoin K (Set.range x)
  have hJ : J ≤ derivationConstants D := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    exact hx i
  let : CharZero J := charZero_of_injective_algebraMap (algebraMap K J).injective
  let δ := derivationOverConstantSubfield D J hJ
  intro halg
  exact ht (derivation_zero_of_isAlgebraic δ t halg)

omit [Field F] [Algebra K F] in
/-- The original reduced vertex-dependent pencil parameter is
transcendental over the entire actual transverse source coordinate field. -/
theorem reduced_vertex_parameter_transcendental_over_transverse_field
    (p q : MvPolynomial (Fin (n + 1)) K) (hp0 : p ≠ 0) (hq0 : q ≠ 0) (hrel : IsRelPrime p q)
    {d e : ℕ} (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous e)
    (hvertex : 0 < p.degreeOf (Fin.last n) ∨ 0 < q.degreeOf (Fin.last n)) :
    Transcendental
      (IntermediateField.adjoin K (Set.range (fun i : Fin n => rationalCoordinate (K := K) i.castSucc)))
      (algebraMap (MvPolynomial (Fin (n + 1)) K) (FractionRing (MvPolynomial (Fin (n + 1)) K)) p /
        algebraMap (MvPolynomial (Fin (n + 1)) K) (FractionRing (MvPolynomial (Fin (n + 1)) K)) q) := by
  have hkill (i : Fin n) : rationalPartial (K := K) (Fin.last n)
      (rationalCoordinate (K := K) i.castSucc) = 0 := by
    rw [rationalPartial_coordinate]
    simp
  exact nonzero_derivation_value_transcendental_over_coordinate_field
    (rationalPartial (K := K) (Fin.last n)) _ hkill _
    (reduced_vertex_parameter_rational_partial_ne_zero p q hp0 hq0 hrel hp hq (Fin.last n) hvertex)

omit [Field F] [Algebra K F] in
/-- The original transverse source coordinates and the actual reduced
vertex-dependent parameter form an independent family over K. -/
theorem reduced_vertex_parameter_and_transverse_coordinates_independent
    (p q : MvPolynomial (Fin (n + 1)) K) (hp0 : p ≠ 0) (hq0 : q ≠ 0) (hrel : IsRelPrime p q)
    {d e : ℕ} (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous e)
    (hvertex : 0 < p.degreeOf (Fin.last n) ∨ 0 < q.degreeOf (Fin.last n)) :
    AlgebraicIndependent K (fun j : Option (Fin n) => j.elim
      (algebraMap (MvPolynomial (Fin (n + 1)) K) (FractionRing (MvPolynomial (Fin (n + 1)) K)) p /
        algebraMap (MvPolynomial (Fin (n + 1)) K) (FractionRing (MvPolynomial (Fin (n + 1)) K)) q)
      (fun i => rationalCoordinate (K := K) i.castSucc)) := by
  have hx : AlgebraicIndependent K (fun i : Fin n => rationalCoordinate (K := K) i.castSucc) :=
    (rationalCoordinates_algebraicIndependent (K := K) (n := n + 1)).comp Fin.castSucc (Fin.castSucc_injective n)
  apply (hx.option_iff_transcendental _).mpr
  have ht := reduced_vertex_parameter_transcendental_over_transverse_field p q hp0 hq0 hrel hp hq hvertex
  intro halg
  exact ht (IntermediateField.isAlgebraic_adjoin_iff.mpr halg)

end DimensionFourDependence
