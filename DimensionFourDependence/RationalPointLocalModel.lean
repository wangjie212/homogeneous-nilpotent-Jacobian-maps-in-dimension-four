import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.MvPolynomial.Ideal
import Mathlib.RingTheory.LocalRing.ResidueField.Basic
import Mathlib.RingTheory.Length
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.Tactic

/-! # Local rings of polynomial quotients at the rational origin

For an ideal whose equations vanish at the origin, the quotient
evaluation defines a prime. Its actual localization has maximal ideal
generated by the coordinate images and the original coefficient field
as residue field. These conclusions are constructed from the quotient,
rather than supplied as hypotheses of a local intersection estimate.
-/

namespace DimensionFourDependence

open MvPolynomial

variable {F A : Type*} [Field F] [CommRing A] [Algebra F A] [IsLocalRing A]

omit [IsLocalRing A] in
/-- Restricting scalars to the coefficient field bounds the local
algebra's module length by its coefficient dimension. -/
theorem local_algebra_length_le_coefficient_dimension [Module.Finite F A] :
    Module.length A A ≤ (Module.finrank F A : ℕ∞) := by
  have hlen := (⊤ : Submodule A A).length_le_length_restrictScalars F
  rw [Module.length_top, Submodule.restrictScalars_top, Module.length_top,
    Module.length_eq_finrank] at hlen
  exact hlen

/-- A rational-point evaluation on a local algebra identifies its
residue field with the coefficient field in the required surjective form. -/
theorem rational_local_algebra_coefficient_residue_surjective (ev : A →ₐ[F] F) :
    Function.Surjective (algebraMap F (A ⧸ IsLocalRing.maximalIdeal A)) := by
  have hsurj : Function.Surjective ev := fun c => ⟨algebraMap F A c, ev.commutes c⟩
  have hker : RingHom.ker ev.toRingHom = IsLocalRing.maximalIdeal A :=
    IsLocalRing.ker_eq_maximalIdeal ev.toRingHom hsurj
  intro z
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
  refine ⟨ev a, ?_⟩
  change Ideal.Quotient.mk (IsLocalRing.maximalIdeal A) (algebraMap F A (ev a)) =
    Ideal.Quotient.mk (IsLocalRing.maximalIdeal A) a
  apply Ideal.Quotient.eq.mpr
  rw [← hker]
  change ev (algebraMap F A (ev a) - a) = 0
  simp

/-- A local algebra element is a unit exactly when its rational-point
value is nonzero. -/
theorem rational_local_algebra_isUnit_iff (ev : A →ₐ[F] F) (x : A) :
    IsUnit x ↔ ev x ≠ 0 := by
  have hsurj : Function.Surjective ev := fun c => ⟨algebraMap F A c, ev.commutes c⟩
  have hker : RingHom.ker ev.toRingHom = IsLocalRing.maximalIdeal A :=
    IsLocalRing.ker_eq_maximalIdeal ev.toRingHom hsurj
  rw [← IsLocalRing.notMem_maximalIdeal, ← hker]
  rfl

/-- A surviving element of the maximal ideal gives a nontrivial
submodule and a nontrivial residue quotient, hence local length at least two. -/
theorem nonzero_maximal_ideal_element_local_length_ge_two
    (u : A) (hu : u ∈ IsLocalRing.maximalIdeal A) (hu0 : u ≠ 0) :
    2 ≤ Module.length A A := by
  let m := IsLocalRing.maximalIdeal A
  have hune : (⟨u, hu⟩ : m) ≠ 0 := by
    intro he
    exact hu0 (congrArg Subtype.val he)
  let : Nontrivial m := nontrivial_of_ne (⟨u, hu⟩ : m) 0 hune
  have hm : 1 ≤ Module.length A m := Order.one_le_iff_pos.mpr Module.length_pos
  have hq : 1 ≤ Module.length A (A ⧸ m) := Order.one_le_iff_pos.mpr Module.length_pos
  rw [Module.length_eq_add_of_exact m.subtype m.mkQ m.subtype_injective m.mkQ_surjective
    (LinearMap.exact_subtype_mkQ m)]
  calc
    (2 : ℕ∞) = 1 + 1 := by norm_num
    _ ≤ Module.length A m + Module.length A (A ⧸ m) := add_le_add hm hq

variable {sigma : Type*}

/-- The full ideal of the rational origin is generated by the variables. -/
theorem zero_polynomial_evaluation_kernel :
    RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom =
      Ideal.span (Set.range (X : sigma → MvPolynomial sigma F)) := by
  let I : Ideal (MvPolynomial sigma F) := Ideal.span (Set.range X)
  have hrep (p : MvPolynomial sigma F) : p - C (aeval (fun _ : sigma => (0 : F)) p) ∈ I := by
    induction p using MvPolynomial.induction_on with
    | C a => simp
    | add p q hp hq =>
        have he : p + q - C (aeval (fun _ : sigma => (0 : F)) (p + q)) =
            (p - C (aeval (fun _ : sigma => (0 : F)) p)) +
              (q - C (aeval (fun _ : sigma => (0 : F)) q)) := by
          rw [map_add, map_add]
          ring
        rw [he]
        exact I.add_mem hp hq
    | mul_X p i _ =>
        simpa only [map_mul, aeval_X, mul_zero, map_zero, sub_zero] using
          I.mul_mem_left p (Ideal.subset_span ⟨i, rfl⟩)
  apply le_antisymm
  · intro p hp
    change aeval (fun _ : sigma => (0 : F)) p = 0 at hp
    simpa only [hp, map_zero, sub_zero] using hrep p
  · apply Ideal.span_le.mpr
    rintro _ ⟨i, rfl⟩
    change aeval (fun _ : sigma => (0 : F)) (X i) = 0
    simp

/-- The original rational-origin evaluation on an actual polynomial quotient. -/
noncomputable def zeroPointQuotientEvaluation
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) :
    (MvPolynomial sigma F ⧸ J) →ₐ[F] F :=
  Ideal.Quotient.liftₐ J (aeval (fun _ : sigma => (0 : F))) hJ

/-- The actual origin prime in the quotient by the given equations. -/
noncomputable def zeroPointQuotientPrime
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) :
    Ideal (MvPolynomial sigma F ⧸ J) :=
  RingHom.ker (zeroPointQuotientEvaluation J hJ).toRingHom

instance zeroPointQuotientPrime_isPrime
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) :
    (zeroPointQuotientPrime J hJ).IsPrime := RingHom.ker_isPrime _

/-- The quotient origin ideal is the image of the original coordinate ideal. -/
theorem zeroPointQuotientPrime_eq_coordinate_image
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) :
    zeroPointQuotientPrime J hJ =
      (Ideal.span (Set.range (X : sigma → MvPolynomial sigma F))).map (Ideal.Quotient.mk J) := by
  unfold zeroPointQuotientPrime zeroPointQuotientEvaluation
  change RingHom.ker (Ideal.Quotient.lift J
    (aeval (fun _ : sigma => (0 : F))).toRingHom hJ) = _
  rw [Ideal.ker_quotient_lift, zero_polynomial_evaluation_kernel]

/-- The actual coordinates in the localization of the polynomial quotient
at its rational origin prime. -/
noncomputable def zeroPointLocalCoordinate
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) (i : sigma) :
    Localization.AtPrime (zeroPointQuotientPrime J hJ) :=
  algebraMap (MvPolynomial sigma F ⧸ J) _ (Ideal.Quotient.mk J (X i))

/-- The specified polynomial presentation of the localized quotient. -/
noncomputable def zeroPointLocalPolynomialHom
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) :
    MvPolynomial sigma F →ₐ[F] Localization.AtPrime (zeroPointQuotientPrime J hJ) :=
  (IsScalarTower.toAlgHom F (MvPolynomial sigma F ⧸ J)
    (Localization.AtPrime (zeroPointQuotientPrime J hJ))).comp (Ideal.Quotient.mkₐ F J)

/-- Each variable retains its original coordinate image in the local ring. -/
theorem zeroPointLocalPolynomialHom_X
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) (i : sigma) :
    zeroPointLocalPolynomialHom J hJ (X i) = zeroPointLocalCoordinate J hJ i := rfl

/-- Every original quotient equation vanishes in the actual local ring. -/
theorem zeroPointLocalPolynomialHom_relation
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom)
    (p : MvPolynomial sigma F) (hp : p ∈ J) : zeroPointLocalPolynomialHom J hJ p = 0 := by
  change algebraMap (MvPolynomial sigma F ⧸ J) (Localization.AtPrime (zeroPointQuotientPrime J hJ))
    (Ideal.Quotient.mk J p) = 0
  rw [Ideal.Quotient.eq_zero_iff_mem.mpr hp, map_zero]

/-- Evaluation extends to the actual local ring, because every denominator
outside the rational-origin prime evaluates to a nonzero scalar. -/
noncomputable def zeroPointLocalEvaluation
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) :
    Localization.AtPrime (zeroPointQuotientPrime J hJ) →ₐ[F] F :=
  IsLocalization.liftAlgHom (f := zeroPointQuotientEvaluation J hJ)
    (fun y : (zeroPointQuotientPrime J hJ).primeCompl =>
      isUnit_iff_ne_zero.mpr (fun he => y.property he))

/-- The local evaluation retains the original polynomial value. -/
theorem zeroPointLocalEvaluation_polynomial
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom)
    (p : MvPolynomial sigma F) :
    zeroPointLocalEvaluation J hJ
      (algebraMap (MvPolynomial sigma F ⧸ J) (Localization.AtPrime (zeroPointQuotientPrime J hJ))
        (Ideal.Quotient.mk J p)) = aeval (fun _ : sigma => (0 : F)) p := by
  rw [zeroPointLocalEvaluation, IsLocalization.liftAlgHom_apply, IsLocalization.lift_eq]
  rfl

/-- The original coordinates have zero rational-origin values in the local ring. -/
theorem zeroPointLocalEvaluation_coordinate
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) (i : sigma) :
    zeroPointLocalEvaluation J hJ (zeroPointLocalCoordinate J hJ i) = 0 := by
  rw [zeroPointLocalCoordinate, zeroPointLocalEvaluation_polynomial]
  simp

/-- The maximal ideal of the actual local ring is generated by its
original polynomial coordinate images. -/
theorem zeroPointLocal_maximalIdeal
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) :
    IsLocalRing.maximalIdeal (Localization.AtPrime (zeroPointQuotientPrime J hJ)) =
      Ideal.span (Set.range (zeroPointLocalCoordinate J hJ)) := by
  let loc := algebraMap (MvPolynomial sigma F ⧸ J)
    (Localization.AtPrime (zeroPointQuotientPrime J hJ))
  calc
    _ = Ideal.map loc (zeroPointQuotientPrime J hJ) := Localization.AtPrime.map_eq_maximalIdeal.symm
    _ = Ideal.map loc ((Ideal.span (Set.range (X : sigma → MvPolynomial sigma F))).map
        (Ideal.Quotient.mk J)) := congrArg (Ideal.map loc) (zeroPointQuotientPrime_eq_coordinate_image J hJ)
    _ = _ := by rw [Ideal.map_map, Ideal.map_span, ← Set.range_comp]; rfl

/-- The actual local ring has the original coefficient field as residue field. -/
theorem zeroPointLocal_coefficient_residue_surjective
    (J : Ideal (MvPolynomial sigma F))
    (hJ : J ≤ RingHom.ker (aeval (fun _ : sigma => (0 : F))).toRingHom) :
    Function.Surjective (algebraMap F
      (IsLocalRing.ResidueField (Localization.AtPrime (zeroPointQuotientPrime J hJ)))) :=
  rational_local_algebra_coefficient_residue_surjective (zeroPointLocalEvaluation J hJ)

end DimensionFourDependence
