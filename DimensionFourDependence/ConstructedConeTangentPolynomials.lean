import DimensionFourDependence.AffineConeJacobianMatrix
import DimensionFourDependence.ConeWronskianHorizontalIndependence

/-! # Constructing the entire cone tangent from the original nilpotent Jacobian

The trace-square elimination gives explicit polynomial coefficients in
the actual parameter. Their two horizontal members are independent over
the original coefficient field whenever the three original scalar curve
coordinates are independent. No supplied slope or direction is used.
-/

namespace DimensionFourDependence

open MvPolynomial

set_option maxHeartbeats 4000000
set_option synthInstance.maxHeartbeats 100000

variable {K : Type*} [Field K]

/-- The two actual horizontal tangent coefficients, as original
univariate parameter polynomials. -/
noncomputable def coneTriangularHorizontalPolynomials (d : ℕ) (A : Fin 3 → Polynomial K) :
    Fin 2 → Polynomial K :=
  ![(d : Polynomial K) * (A 1 * (A 0).derivative - (A 1).derivative * A 0),
    (d : Polynomial K) * (A 1 * (A 2).derivative - (A 1).derivative * A 2)]

/-- All three actual vertical affine coefficients, in constant,x,z
order, constructed solely from the original parameter polynomials. -/
noncomputable def coneTriangularVerticalPolynomials (d : ℕ) (A B : Fin 3 → Polynomial K) :
    Fin 3 → Polynomial K :=
  ![(d : Polynomial K) * A 1 * (B 1).derivative -
      ((d : Polynomial K) - 1) * (A 1).derivative * B 1 - ∑ i : Fin 3, B i * (A i).derivative,
    (d : Polynomial K) * A 1 * (B 0).derivative - ((d : Polynomial K) - 1) * (A 1).derivative * B 0,
    (d : Polynomial K) * A 1 * (B 2).derivative - ((d : Polynomial K) - 1) * (A 1).derivative * B 2]

variable [CharZero K]

/-- The original four affine cone formulas and nilpotence construct the
complete triangular tangent identity for the same actual polynomial P.
All five parameter-polynomial coefficients are explicit conclusions. -/
theorem nilpotent_cone_affine_forms_construct_polynomial_tangent_identity
    (H : Fin 4 → MvPolynomial (Fin 4) K) {d : ℕ} (hH : IsHomogMap H d)
    (hN : IsNilpotent (jac H)) (P : MvPolynomial (Fin 3) K) (A B : Fin 3 → Polynomial K)
    (hfirst : ∀ i : Fin 3, secondCoordinateAffineChart (H i.castSucc) = Polynomial.aeval P (A i))
    (hlast : secondCoordinateAffineChart (H (Fin.last 3)) = affineConeMixedPolynomial P B) :
    Polynomial.aeval P (coneTriangularHorizontalPolynomials d A 0) * pderiv 0 P +
      Polynomial.aeval P (coneTriangularHorizontalPolynomials d A 1) * pderiv 1 P +
      (Polynomial.aeval P (coneTriangularVerticalPolynomials d A B 0) +
        Polynomial.aeval P (coneTriangularVerticalPolynomials d A B 1) * X 0 +
        Polynomial.aeval P (coneTriangularVerticalPolynomials d A B 2) * X 1) * pderiv 2 P = 0 := by
  have hn := actual_nilpotent_cone_affine_jacobian_matrix H hH hN P A B hfirst hlast
  have he := nilpotent_cone_chart_constructs_triangular_tangency
    (d : MvPolynomial (Fin 3) K) (fun i => Polynomial.aeval P (A i))
    (fun i => Polynomial.aeval P (A i).derivative) (fun i => Polynomial.aeval P (B i))
    (affineConeMixedPolynomial P B) (affineConeMixedPolynomial P (fun i => (B i).derivative))
    (affineConeParameterGradient P) hn
  simp [coneTriangularHorizontalPolynomials, coneTriangularVerticalPolynomials,
    Fin.sum_univ_succ]
  simp [affineConeMixedPolynomial, affineConeParameterGradient] at he
  linear_combination he

/-- The horizontal tangent coefficients over the actual rational
parameter field are independent over the original field. -/
theorem independent_scalar_curve_constructed_horizontal_polynomials_independent
    {d : ℕ} (hd : 0 < d) (A : Fin 3 → Polynomial K) (hA : LinearIndependent K A) :
    LinearIndependent K (fun i : Fin 2 => algebraMap (Polynomial K) (RatFunc K)
      (coneTriangularHorizontalPolynomials d A i)) := by
  let v : Fin 3 → RatFunc K := fun i => algebraMap (Polynomial K) (RatFunc K) (A i)
  have hv : LinearIndependent K v := hA.map'
    (IsScalarTower.toAlgHom K (Polynomial K) (RatFunc K)).toLinearMap
    (LinearMap.ker_eq_bot.mpr (IsFractionRing.injective (Polynomial K) (RatFunc K)))
  have hdK : (d : K) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hd
  have he := independent_three_coordinates_horizontal_wronskians_independent
    (rationalParameterDerivative K)
    (fun r hr => (rationalParameterDerivative_eq_zero_iff_scalar r).mp hr) v hv (d : K) hdK
  convert he using 1
  funext i
  fin_cases i <;> simp [coneTriangularHorizontalPolynomials, v, rationalParameterDerivative_polynomial]

/-- The same constructed horizontal pair stays independent in the
actual field generated by any transcendental realization of the parameter. -/
theorem actual_parameter_constructed_horizontal_polynomials_independent
    {F : Type*} [Field F] [Algebra K F]
    (t : F) (ht : Transcendental K t) {d : ℕ} (hd : 0 < d)
    (A : Fin 3 → Polynomial K) (hA : LinearIndependent K A) :
    LinearIndependent K (fun i : Fin 2 =>
      Polynomial.aeval (IntermediateField.AdjoinSimple.gen K t)
        (coneTriangularHorizontalPolynomials d A i)) := by
  let e := RatFunc.algEquivOfTranscendental t ht
  have he := (independent_scalar_curve_constructed_horizontal_polynomials_independent hd A hA).map'
    e.toLinearMap (LinearMap.ker_eq_bot.mpr e.injective)
  simpa only [e, Function.comp_def, AlgEquiv.toLinearMap_apply,
    RatFunc.algEquivOfTranscendental_algebraMap] using he

end DimensionFourDependence
