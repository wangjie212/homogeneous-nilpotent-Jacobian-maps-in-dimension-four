import DimensionFourDependence.GenericAffineLevelKernel
import DimensionFourDependence.FiberCoordinateRing
import Mathlib.FieldTheory.RatFunc.AsPolynomial

/-! # The full affine level ideal over the actual parameter field

The independent rational parameter is identified with the actual field K(t).
This transports the whole relation kernel, rather than only a known relation,
to the literal equation P-t over the actual parameter field.
-/

namespace DimensionFourDependence

open MvPolynomial

set_option maxHeartbeats 2000000
set_option synthInstance.maxHeartbeats 100000

variable {K F : Type*} [Field K] [Field F] [Algebra K F] {n : ℕ}

/-- The actual affine level equation with coefficient parameter in K(t). -/
noncomputable def actualAffineLevelEquation (t : F) (P : MvPolynomial (Fin n) K) :
    MvPolynomial (Fin n) (IntermediateField.adjoin K {t}) :=
  MvPolynomial.map (algebraMap K (IntermediateField.adjoin K {t})) P -
    C (IntermediateField.AdjoinSimple.gen K t)

/-- The independent rational-parameter equation becomes the literal actual
parameter-field equation under the canonical transcendental identification. -/
theorem genericAffineLevelEquation_map_actual_parameter
    (t : F) (ht : Transcendental K t) (P : MvPolynomial (Fin n) K) :
    MvPolynomial.map (RatFunc.algEquivOfTranscendental t ht).toRingHom
      (genericAffineLevelEquation P) = actualAffineLevelEquation t P := by
  let e := RatFunc.algEquivOfTranscendental t ht
  have hc : e.toRingHom.comp (algebraMap K (RatFunc K)) =
      algebraMap K (IntermediateField.adjoin K {t}) := by
    apply RingHom.ext
    intro c
    exact e.commutes c
  have hX : e RatFunc.X = IntermediateField.AdjoinSimple.gen K t := by
    apply Subtype.ext
    exact RatFunc.algEquivOfTranscendental_X t ht
  change MvPolynomial.map e.toRingHom _ = _
  simp only [genericAffineLevelEquation, actualAffineLevelEquation, map_sub,
    MvPolynomial.map_C, MvPolynomial.map_map, hc]
  change _ - C (e RatFunc.X) = _
  rw [hX]

/-- Independent actual source coordinates and t=P(x) identify every
relation over the actual parameter field as a multiple of P-t. -/
theorem actual_affine_level_parameter_field_relation_ideal
    (t : F) (ht : Transcendental K t) (x : Fin n → F)
    (hx : AlgebraicIndependent K x) (P : MvPolynomial (Fin n) K)
    (hvalue : t = aeval x P) :
    fiberVanishingIdeal (L := IntermediateField.adjoin K {t}) x =
      Ideal.span {actualAffineLevelEquation t P} := by
  let e := RatFunc.algEquivOfTranscendental t ht
  let E := MvPolynomial.mapEquiv (Fin n) e.toRingEquiv
  let f := (IntermediateField.adjoin K {t}).val.comp e.toAlgHom
  have hf : f RatFunc.X = aeval x P := by
    change (e RatFunc.X : F) = _
    rw [RatFunc.algEquivOfTranscendental_X]
    exact hvalue
  ext B
  let B0 := E.symm B
  have hB : E B0 = B := E.apply_symm_apply B
  have heval : MvPolynomial.eval₂ f.toRingHom x B0 = aeval x B := by
    rw [← hB]
    change _ = MvPolynomial.eval₂ (algebraMap (IntermediateField.adjoin K {t}) F) x
      (MvPolynomial.map e.toRingHom B0)
    rw [eval₂_map]
    rfl
  have hdiv : E (genericAffineLevelEquation P) ∣ B ↔ genericAffineLevelEquation P ∣ B0 := by
    constructor
    · intro h
      simpa only [RingEquiv.symm_apply_apply] using map_dvd E.symm h
    · intro h
      simpa only [hB] using map_dvd E h
  have heq : E (genericAffineLevelEquation P) = actualAffineLevelEquation t P :=
    genericAffineLevelEquation_map_actual_parameter t ht P
  change aeval x B = 0 ↔ _
  rw [Ideal.mem_span_singleton, ← heval,
    ← generic_affine_level_dvd_iff_actual_evaluation_zero P x hx f hf B0, ← heq]
  exact hdiv.symm

/-- The literal actual affine level quotient is the actual coordinate
subalgebra generated by the source coordinates over K(t). -/
noncomputable def actualAffineLevelCoordinateEquiv
    (t : F) (ht : Transcendental K t) (x : Fin n → F)
    (hx : AlgebraicIndependent K x) (P : MvPolynomial (Fin n) K)
    (hvalue : t = aeval x P) :
    (MvPolynomial (Fin n) (IntermediateField.adjoin K {t}) ⧸
      Ideal.span {actualAffineLevelEquation t P}) ≃ₐ[IntermediateField.adjoin K {t}]
        fiberCoordinateAlgebra (L := IntermediateField.adjoin K {t}) x := by
  rw [← actual_affine_level_parameter_field_relation_ideal t ht x hx P hvalue]
  exact fiberCoordinateQuotientEquiv x

end DimensionFourDependence
