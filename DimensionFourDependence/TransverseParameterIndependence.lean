import DimensionFourDependence.VertexParameterTranscendence
import DimensionFourDependence.GeneratedFieldDimension
import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure

/-! # The transverse source coordinates are independent over the actual parameter field

Joint independence of a parameter and the transverse coordinates first
gives independence over its polynomial algebra. Passing to the actual
generated fraction field preserves that independence. The reduced
vertex-dependent original pencil supplies the required joint family.
-/

namespace DimensionFourDependence

open scoped IntermediateField.algebraAdjoinAdjoin

variable {K E σ : Type*} [Field K] [Field E] [Algebra K E]

/-- Joint independence gives independence over the actual field
generated by the parameter, with its canonical action in the ambient field. -/
theorem joint_parameter_coordinates_independent_over_parameter_field
    (t : E) (x : σ → E)
    (h : AlgebraicIndependent K (fun j : Option σ => j.elim t x)) :
    AlgebraicIndependent (IntermediateField.adjoin K {t}) x := by
  let r : σ ⊕ Unit → Option σ := Sum.elim some (fun _ => none)
  have hr : Function.Injective r := by
    intro i j hij
    cases i <;> cases j <;> simp_all [r]
  have hs := h.comp r hr
  have hpoint : (fun j : σ ⊕ Unit => (r j).elim t x) = Sum.elim x (fun _ : Unit => t) := by
    funext j
    cases j <;> rfl
  change AlgebraicIndependent K (fun j : σ ⊕ Unit => (r j).elim t x) at hs
  rw [hpoint] at hs
  have hpoly : AlgebraicIndependent (Algebra.adjoin K {t}) x := by
    have he := (AlgebraicIndependent.sumElim_iff (R := K) (x := fun _ : Unit => t) (y := x)).mp hs
    have hrange : Set.range (fun _ : Unit => t) = ({t} : Set E) := by ext z; simp
    have hp := he.2
    rw [hrange] at hp
    exact hp
  exact hpoly.extendScalars (IntermediateField.adjoin K {t})

variable [CharZero K] {n : ℕ}

omit [Field E] [Algebra K E] in
/-- A reduced original homogeneous pencil with genuine vertex
dependence constructs independence of all transverse source coordinates
over its entire actual rational parameter field. -/
theorem reduced_vertex_pencil_transverse_coordinates_independent_over_parameter_field
    (p q : MvPolynomial (Fin (n + 1)) K) (hp0 : p ≠ 0) (hq0 : q ≠ 0) (hrel : IsRelPrime p q)
    {d e : ℕ} (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous e)
    (hvertex : 0 < p.degreeOf (Fin.last n) ∨ 0 < q.degreeOf (Fin.last n)) :
    AlgebraicIndependent
      (IntermediateField.adjoin K
        {algebraMap (MvPolynomial (Fin (n + 1)) K) (FractionRing (MvPolynomial (Fin (n + 1)) K)) p /
          algebraMap (MvPolynomial (Fin (n + 1)) K) (FractionRing (MvPolynomial (Fin (n + 1)) K)) q})
      (fun i : Fin n => rationalCoordinate (K := K) i.castSucc) := by
  apply joint_parameter_coordinates_independent_over_parameter_field
  exact reduced_vertex_parameter_and_transverse_coordinates_independent p q hp0 hq0 hrel hp hq hvertex

end DimensionFourDependence
