import DimensionFourDependence.ParabolaFromAffineSquare
import DimensionFourDependence.ConstantPlaneProjection
import DimensionFourDependence.FiberCoordinateRing
import Mathlib.RingTheory.Smooth.Basic

/-! # The actual parabola coordinate algebra is a smooth polynomial algebra

The independent original linear and quadratic directions construct a
left inverse. It recovers the actual parameter by an affine-linear
polynomial in the original source coordinates. The entire generated
coordinate algebra is consequently the polynomial algebra in that
transcendental parameter, including its quotient presentation by the
entire original relation ideal. Smoothness is transported through the
constructed algebra isomorphism.
-/

namespace DimensionFourDependence

open MvPolynomial Matrix

variable {L F : Type*} [Field L] [Field F] [Algebra L F]

/-- The actual parabola parameter is an affine-linear polynomial
in the original four source coordinates, constructed from the independent directions. -/
theorem parabola_parameter_affine_linear_recovery
    (x : Fin 4 → F) (a b c : Fin 4 → L) (hbc : LinearIndependent L ![b, c])
    (t : F) (hx : ∀ i, x i = algebraMap L F (a i) + algebraMap L F (b i) * t +
      algebraMap L F (c i) * t ^ 2) :
    ∃ T : MvPolynomial (Fin 4) L, T.totalDegree ≤ 1 ∧ aeval x T = t := by
  obtain ⟨C, hC⟩ := directionPlaneMatrix_has_left_inverse b c hbc
  have hb : ∑ i : Fin 4, C 0 i * b i = 1 := by
    have he := congrArg (fun M : Matrix (Fin 2) (Fin 2) L => M 0 0) hC
    simpa [Matrix.mul_apply, directionPlaneMatrix] using he
  have hc : ∑ i : Fin 4, C 0 i * c i = 0 := by
    have he := congrArg (fun M : Matrix (Fin 2) (Fin 2) L => M 0 1) hC
    simpa [Matrix.mul_apply, directionPlaneMatrix] using he
  let T : MvPolynomial (Fin 4) L := ∑ i, MvPolynomial.C (C 0 i) * (X i - MvPolynomial.C (a i))
  have hT : T.totalDegree ≤ 1 := by
    apply totalDegree_finsetSum_le
    intro i _
    apply (totalDegree_mul _ _).trans
    simpa only [totalDegree_C, zero_add] using
      (totalDegree_sub_C_le (X (R := L) i) (a i)).trans (by simp)
  refine ⟨T, hT, ?_⟩
  change aeval x (∑ i, MvPolynomial.C (C 0 i) * (X i - MvPolynomial.C (a i))) = t
  simp only [map_sum, map_mul, map_sub, aeval_C, aeval_X]
  have hterm (i : Fin 4) : algebraMap L F (C 0 i) * (x i - algebraMap L F (a i)) =
      algebraMap L F (C 0 i * b i) * t + algebraMap L F (C 0 i * c i) * t ^ 2 := by
    rw [hx i, map_mul, map_mul]
    ring
  simp only [hterm, Finset.sum_add_distrib, ← Finset.sum_mul, ← map_sum, hb, hc,
    map_one, map_zero, one_mul, zero_mul, add_zero]

/-- The entire actual generated coordinate algebra is exactly the
algebra generated by its constructed parabola parameter. -/
theorem parabola_coordinate_algebra_eq_adjoin_parameter
    (x : Fin 4 → F) (a b c : Fin 4 → L) (hbc : LinearIndependent L ![b, c])
    (t : F) (hx : ∀ i, x i = algebraMap L F (a i) + algebraMap L F (b i) * t +
      algebraMap L F (c i) * t ^ 2) :
    fiberCoordinateAlgebra (L := L) x = Algebra.adjoin L ({t} : Set F) := by
  obtain ⟨T, _hT, hTvalue⟩ := parabola_parameter_affine_linear_recovery x a b c hbc t hx
  have htmem : t ∈ fiberCoordinateAlgebra (L := L) x := by
    rw [fiberCoordinateAlgebra, Algebra.adjoin_range_eq_range_aeval]
    exact ⟨T, hTvalue⟩
  apply le_antisymm
  · change Algebra.adjoin L (Set.range x) ≤ Algebra.adjoin L ({t} : Set F)
    apply Algebra.adjoin_le
    rintro _ ⟨i, rfl⟩
    rw [hx i]
    let A := Algebra.adjoin L ({t} : Set F)
    have htA : t ∈ A := Algebra.subset_adjoin (by simp)
    exact A.add_mem (A.add_mem (A.algebraMap_mem (a i))
      (A.mul_mem (A.algebraMap_mem (b i)) htA))
      (A.mul_mem (A.algebraMap_mem (c i)) (A.pow_mem htA 2))
  · exact Algebra.adjoin_le (Set.singleton_subset_iff.mpr htmem)

/-- The actual original parabola coordinate algebra is isomorphic
over its original coefficient field to a one-variable polynomial ring. -/
theorem parabola_coordinate_algebra_polynomial_equiv
    (x : Fin 4 → F) (hx : LiesInAffineParabola (L := L) x) :
    Nonempty (Polynomial L ≃ₐ[L] fiberCoordinateAlgebra (L := L) x) := by
  obtain ⟨a, b, c, hbc, t, ht, hpoint⟩ := hx
  have hA := parabola_coordinate_algebra_eq_adjoin_parameter x a b c hbc t hpoint
  have hrange : (Polynomial.aeval t : Polynomial L →ₐ[L] F).range = fiberCoordinateAlgebra (L := L) x :=
    (Algebra.adjoin_singleton_eq_range_aeval L t).symm.trans hA.symm
  exact ⟨(AlgEquiv.ofInjective (Polynomial.aeval t) (transcendental_iff_injective.mp ht)).trans
    (Subalgebra.equivOfEq _ _ hrange)⟩

/-- This identifies the quotient by the entire actual original
affine relation ideal, not merely an abstract parametrized image algebra. -/
theorem parabola_coordinate_quotient_polynomial_equiv
    (x : Fin 4 → F) (hx : LiesInAffineParabola (L := L) x) :
    Nonempty (Polynomial L ≃ₐ[L] (MvPolynomial (Fin 4) L ⧸ fiberVanishingIdeal (L := L) x)) := by
  obtain ⟨e⟩ := parabola_coordinate_algebra_polynomial_equiv x hx
  exact ⟨e.trans (fiberCoordinateQuotientEquiv (L := L) x).symm⟩

/-- The actual generated coordinate algebra of the original parabola is smooth. -/
theorem parabola_coordinate_algebra_smooth
    (x : Fin 4 → F) (hx : LiesInAffineParabola (L := L) x) :
    Algebra.Smooth L (fiberCoordinateAlgebra (L := L) x) := by
  obtain ⟨e⟩ := parabola_coordinate_algebra_polynomial_equiv x hx
  let : Algebra.Smooth L (Polynomial L) := {}
  exact Algebra.Smooth.of_equiv e

/-- The actual affine fiber scheme's coordinate quotient is smooth
over the original coefficient field. -/
theorem parabola_coordinate_quotient_smooth
    (x : Fin 4 → F) (hx : LiesInAffineParabola (L := L) x) :
    Algebra.Smooth L (MvPolynomial (Fin 4) L ⧸ fiberVanishingIdeal (L := L) x) := by
  obtain ⟨e⟩ := parabola_coordinate_quotient_polynomial_equiv x hx
  let : Algebra.Smooth L (Polynomial L) := {}
  exact Algebra.Smooth.of_equiv e

end DimensionFourDependence
