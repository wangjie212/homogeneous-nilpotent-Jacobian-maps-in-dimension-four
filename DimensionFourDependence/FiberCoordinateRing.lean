import DimensionFourDependence.FiberCoordinateField

/-! # The prime coordinate ideal and its actual function field

The coordinate algebra is the actual subalgebra generated by the projected
source coordinates. It is identified with the quotient by the prime
vanishing ideal, and its fraction field is identified with the source field.
-/

namespace DimensionFourDependence

open MvPolynomial

variable {L F : Type*} [Field L] [Field F] [Algebra L F] {n : ℕ}

/-- The coordinate algebra inside the actual source function field. -/
noncomputable def fiberCoordinateAlgebra (x : Fin n → F) : Subalgebra L F :=
  Algebra.adjoin L (Set.range x)

/-- The prime ideal of polynomial relations among the projected coordinates. -/
noncomputable def fiberVanishingIdeal (x : Fin n → F) : Ideal (MvPolynomial (Fin n) L) :=
  RingHom.ker (aeval x : MvPolynomial (Fin n) L →ₐ[L] F)

@[instance]
theorem fiberVanishingIdeal_isPrime (x : Fin n → F) : (fiberVanishingIdeal (L := L) x).IsPrime :=
  RingHom.ker_isPrime (aeval x : MvPolynomial (Fin n) L →ₐ[L] F)

/-- The quotient presentation of the actual coordinate algebra. -/
noncomputable def fiberCoordinateQuotientEquiv (x : Fin n → F) :
    (MvPolynomial (Fin n) L ⧸ fiberVanishingIdeal (L := L) x) ≃ₐ[L] fiberCoordinateAlgebra (L := L) x :=
  (Ideal.quotientKerEquivRange (aeval x : MvPolynomial (Fin n) L →ₐ[L] F)).trans
    (Subalgebra.equivOfEq _ _ (Algebra.adjoin_range_eq_range_aeval L x).symm)

/-- The canonical embedding of the coordinate algebra's fraction field. -/
noncomputable def fiberCoordinateFractionHom (x : Fin n → F) :
    FractionRing (fiberCoordinateAlgebra (L := L) x) →ₐ[L] F :=
  IsFractionRing.liftAlgHom (show Function.Injective (fiberCoordinateAlgebra (L := L) x).val
    from Subtype.val_injective)

theorem fiberCoordinateFractionHom_fieldRange (x : Fin n → F) :
    (fiberCoordinateFractionHom (L := L) x).fieldRange = IntermediateField.adjoin L (Set.range x) := by
  unfold fiberCoordinateFractionHom
  apply IsFractionRing.liftAlgHom_fieldRange_eq_of_range_eq
  exact (fiberCoordinateAlgebra (L := L) x).range_val

/-- If the projected coordinates generate the source field, the canonical
fraction-field embedding is an isomorphism over the coefficient field. -/
noncomputable def fiberCoordinateFractionEquiv (x : Fin n → F)
    (hx : IntermediateField.adjoin L (Set.range x) = ⊤) :
    FractionRing (fiberCoordinateAlgebra (L := L) x) ≃ₐ[L] F :=
  AlgEquiv.ofBijective (fiberCoordinateFractionHom (L := L) x)
    ⟨(fiberCoordinateFractionHom (L := L) x).injective,
      AlgHom.fieldRange_eq_top.mp (by rw [fiberCoordinateFractionHom_fieldRange, hx])⟩

/-- The fraction field of the prime quotient is the same source field. -/
noncomputable def fiberQuotientFractionEquiv (x : Fin n → F)
    (hx : IntermediateField.adjoin L (Set.range x) = ⊤) :
    FractionRing (MvPolynomial (Fin n) L ⧸ fiberVanishingIdeal (L := L) x) ≃ₐ[L] F :=
  (IsFractionRing.algEquivOfAlgEquiv (fiberCoordinateQuotientEquiv (L := L) x)).trans
    (fiberCoordinateFractionEquiv x hx)

/-- The generic type of function-field identifications. Keeping the
coefficient structures here avoids repeatedly reconstructing the nested
specialized algebra structures in subsequent geometric statements. -/
noncomputable def FiberQuotientFunctionFieldEquiv (x : Fin n → F) : Type _ :=
  FractionRing (MvPolynomial (Fin n) L ⧸ fiberVanishingIdeal (L := L) x) ≃ₐ[L] F

/-- The relative transcendence degree of the actual prime quotient's fraction field. -/
noncomputable def fiberCoordinateFunctionFieldTrdeg (x : Fin n → F) : Cardinal :=
  Algebra.trdeg L (FractionRing (MvPolynomial (Fin n) L ⧸ fiberVanishingIdeal (L := L) x))

variable {K : Type*} [Field K] [CharZero K]

/-- The actual projected fiber's prime quotient has the original source
rational function field as its fraction field. -/
noncomputable def fiber_witness_functionFieldEquiv
    (H : Fin 4 → FractionRing (MvPolynomial (Fin 4) K)) (W : FiberEquationWitness H) :
    FiberQuotientFunctionFieldEquiv
      (L := coefficientField (K := K) (fun i : Fin 3 => H (W.chart i.castSucc)))
      (fun i : Fin 3 => rationalCoordinate (K := K) (W.chart i.castSucc)) :=
  fiberQuotientFractionEquiv _ (fiber_witness_coordinate_field_eq_top H W)

/-- The prime quotient is a function field of one variable over the
actual coefficient field, under the original nilpotent rank-three hypotheses. -/
theorem fiber_witness_coordinate_functionField_trdeg
    (H : Fin 4 → FractionRing (MvPolynomial (Fin 4) K))
    (hN : IsNilpotent (rationalJacobian H)) (hrank : (rationalJacobian H).rank = 3)
    (W : FiberEquationWitness H) :
    fiberCoordinateFunctionFieldTrdeg
      (L := coefficientField (K := K) (fun i : Fin 3 => H (W.chart i.castSucc)))
      (fun i : Fin 3 => rationalCoordinate (K := K) (W.chart i.castSucc)) = 1 := by
  unfold fiberCoordinateFunctionFieldTrdeg
  rw [(fiber_witness_functionFieldEquiv H W).trdeg_eq]
  exact fiber_witness_trdeg_eq_one H hN hrank W

omit [CharZero K] in
/-- Both verified fiber equations lie in the actual prime relation ideal. -/
theorem fiber_witness_equations_mem_prime
    (H : Fin 4 → FractionRing (MvPolynomial (Fin 4) K)) (W : FiberEquationWitness H) :
    W.quadric ∈ fiberVanishingIdeal
        (L := coefficientField (K := K) (fun i : Fin 3 => H (W.chart i.castSucc)))
        (fun i : Fin 3 => rationalCoordinate (K := K) (W.chart i.castSucc)) ∧
      W.cubic ∈ fiberVanishingIdeal
        (L := coefficientField (K := K) (fun i : Fin 3 => H (W.chart i.castSucc)))
        (fun i : Fin 3 => rationalCoordinate (K := K) (W.chart i.castSucc)) :=
  ⟨W.quadric_zero, W.cubic_zero⟩

end DimensionFourDependence
