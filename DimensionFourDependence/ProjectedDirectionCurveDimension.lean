import DimensionFourDependence.ProjectiveRatioEmbedding

/-! # A finite ruling-algebraic nonconstant direction has curve dimension one

The entire original projective direction field embeds in the actual
field generated by the same ratios over the ruling field. The latter
is finite over a one-dimensional ruling field and has the same
transcendence degree. Nonconstancy therefore makes the original
projective direction image exactly one-dimensional.
-/

namespace DimensionFourDependence

universe u

variable {K L E : Type u} [Field K] [Field L] [Field E]
    [Algebra K L] [Algebra L E] [Algebra K E] [IsScalarTower K L E] {n : ℕ}

/-- Finiteness of the actual ruling-field coordinate extension
bounds the entire original projective direction field by dimension one. -/
theorem original_projective_direction_trdeg_le_one_of_finite_ruling_extension
    (A : Fin n → E) (j : Fin n) (hL : Algebra.trdeg K L = 1)
    (hfinite : Module.Finite L (IntermediateField.adjoin L (Set.range (fun i => A i / A j)))) :
    Algebra.trdeg K (projectiveRatioField (K := K) A j) ≤ 1 := by
  let R := projectiveRatioField (K := K) A j
  let T := IntermediateField.adjoin L (Set.range (fun i => A i / A j))
  let : Module.Finite L T := hfinite
  have hT : Algebra.trdeg K T = 1 := by
    have he := trdeg_add_eq (A := T) K L
    simpa only [hL, trdeg_eq_zero, add_zero] using he.symm
  have hRT : R ≤ T.restrictScalars K := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro z ⟨i, rfl⟩
    exact IntermediateField.subset_adjoin L _ ⟨i, rfl⟩
  let f : R →ₐ[K] T.restrictScalars K := IntermediateField.inclusion hRT
  exact (trdeg_le_of_injective f f.injective).trans_eq hT

/-- The original nonconstant projective direction field has
dimension exactly one, with its actual original coordinate generators. -/
theorem original_projective_direction_trdeg_one_of_finite_ruling_extension
    (A : Fin n → E) (j : Fin n) (hL : Algebra.trdeg K L = 1)
    (hfinite : Module.Finite L (IntermediateField.adjoin L (Set.range (fun i => A i / A j))))
    (hpositive : Algebra.trdeg K (projectiveRatioField (K := K) A j) ≠ 0) :
    Algebra.trdeg K (projectiveRatioField (K := K) A j) = 1 :=
  le_antisymm
    (original_projective_direction_trdeg_le_one_of_finite_ruling_extension A j hL hfinite)
    (Cardinal.one_le_iff_ne_zero.mpr hpositive)

end DimensionFourDependence
