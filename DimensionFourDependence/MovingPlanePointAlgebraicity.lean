import DimensionFourDependence.MovingPlaneBinaryRestriction

/-! # Actual intersection directions are algebraic over the moving-line field

The original proper ternary equation gives a nonzero homogeneous binary
equation on the moving line. Its actual roots have algebraic binary
coordinate ratios. The exact line equation gives the third coordinate,
and every nonzero original coordinate can serve as normalization. The
actual field generated by all those projective ratios is finite.
-/

namespace DimensionFourDependence

open MvPolynomial

universe u

variable {K : Type*} [Field K] [Infinite K]
    {L F : Type u} [Field L] [Field F] [Algebra K L] [Algebra L F]
    [Algebra K F] [IsScalarTower K L F]

/-- An actual root of a fixed proper ternary equation on a moving
line has a projective normalization algebraic over the line's field. -/
theorem moving_plane_original_equation_point_ratios_isAlgebraic
    (a b : L) (ha : Transcendental K a)
    (P : MvPolynomial (Option (Fin 2)) K) (hP0 : P ≠ 0)
    {D : ℕ} (hP : P.IsHomogeneous D)
    (A : Option (Fin 2) → F) (hA : A ≠ 0)
    (hline : A (some 1) = algebraMap L F a * A (some 0) + algebraMap L F b * A none)
    (hzero : aeval A P = 0) :
    ∃ k : Option (Fin 2), A k ≠ 0 ∧ ∀ i, IsAlgebraic L (A i / A k) := by
  let : Infinite L := Infinite.of_injective (algebraMap K L) (algebraMap K L).injective
  let v : Fin 2 → F := ![A (some 0), A none]
  have hv : v ≠ 0 := by
    intro hz
    have hy : A (some 0) = 0 := by simpa [v] using congrFun hz 0
    have hz' : A none = 0 := by simpa [v] using congrFun hz 1
    have hw : A (some 1) = 0 := by simp only [hy, hz', mul_zero, add_zero] at hline; exact hline
    apply hA
    funext o
    cases o with
    | none => exact hz'
    | some i => fin_cases i <;> assumption
  have hcoords : (fun o : Option (Fin 2) => o.elim (v 1)
      (![v 0, algebraMap L F a * v 0 + algebraMap L F b * v 1] : Fin 2 → F)) = A := by
    funext o
    cases o with
    | none => rfl
    | some i =>
      fin_cases i
      · rfl
      · exact hline.symm
  have hroot : aeval v (movingPlaneBinaryRestriction a b P) = 0 := by
    rw [movingPlaneBinaryRestriction_aeval, hcoords, hzero]
  obtain ⟨j, hj, hratios⟩ := homogeneous_binary_root_ratios_isAlgebraic
    (movingPlaneBinaryRestriction a b P) (movingPlaneBinaryRestriction_isHomogeneous a b P hP)
    (movingPlaneBinaryRestriction_ne_zero a b ha P hP0 hP) v hv hroot
  let k : Option (Fin 2) := (![some 0, none] : Fin 2 → Option (Fin 2)) j
  have hk : A k = v j := by fin_cases j <;> rfl
  refine ⟨k, hk.symm ▸ hj, ?_⟩
  intro o
  rw [hk]
  cases o with
  | none => exact hratios 1
  | some i =>
    fin_cases i
    · exact hratios 0
    · change IsAlgebraic L (A (some (1 : Fin 2)) / v j)
      rw [hline, add_div, mul_div_assoc, mul_div_assoc]
      exact ((isAlgebraic_algebraMap a).mul (hratios 0)).add
        ((isAlgebraic_algebraMap b).mul (hratios 1))

/-- Every specified nonzero original coordinate gives algebraic
projective ratios, so the conclusion is independent of the chart. -/
theorem moving_plane_original_equation_all_chart_ratios_isAlgebraic
    (a b : L) (ha : Transcendental K a)
    (P : MvPolynomial (Option (Fin 2)) K) (hP0 : P ≠ 0)
    {D : ℕ} (hP : P.IsHomogeneous D)
    (A : Option (Fin 2) → F) (hA : A ≠ 0)
    (hline : A (some 1) = algebraMap L F a * A (some 0) + algebraMap L F b * A none)
    (hzero : aeval A P = 0)
    (j : Option (Fin 2)) (hj : A j ≠ 0) : ∀ i, IsAlgebraic L (A i / A j) := by
  obtain ⟨k, hk, hratios⟩ := moving_plane_original_equation_point_ratios_isAlgebraic
    a b ha P hP0 hP A hA hline hzero
  intro i
  have he : A i / A j = (A i / A k) / (A j / A k) := by field_simp
  rw [he]
  simpa only [div_eq_mul_inv] using (hratios i).mul (hratios j).inv

/-- The entire actual original projective-coordinate field of the
intersection direction is a finite extension of the moving-line field. -/
theorem moving_plane_original_direction_coordinate_field_finite
    (a b : L) (ha : Transcendental K a)
    (P : MvPolynomial (Option (Fin 2)) K) (hP0 : P ≠ 0)
    {D : ℕ} (hP : P.IsHomogeneous D)
    (A : Option (Fin 2) → F) (hA : A ≠ 0)
    (hline : A (some 1) = algebraMap L F a * A (some 0) + algebraMap L F b * A none)
    (hzero : aeval A P = 0)
    (j : Option (Fin 2)) (hj : A j ≠ 0) :
    Module.Finite L (IntermediateField.adjoin L (Set.range (fun i => A i / A j))) := by
  have halg := moving_plane_original_equation_all_chart_ratios_isAlgebraic
    a b ha P hP0 hP A hA hline hzero j hj
  apply IntermediateField.finiteDimensional_adjoin
  rintro z ⟨i, rfl⟩
  exact (halg i).isIntegral

end DimensionFourDependence
