import DimensionFourDependence.ScaledProjectionCoordinateIntegrality
import DimensionFourDependence.GeneratedCoordinateFractionField

/-! # The actual projection fiber generates the original function field

An invertible linear change preserves the field generated by the actual
original coordinates. If its two projection coordinates are the specified
images from the base field, the remaining fiber coordinate generates the
entire function-field extension. The original affine algebra generators
also construct the original field-generation hypothesis.
-/

namespace DimensionFourDependence

universe u

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1000000

variable {k L : Type u} [Field k] [Field L] [Algebra k L] {n : ℕ}

/-- The actual invertible linear projection coordinate change preserves
generation of the entire original function field. -/
theorem linearProjectionCoordinate_field_adjoin_eq_top
    (T : (Fin n → k) ≃ₗ[k] (Fin n → k)) (x : Fin n → L)
    (hx : IntermediateField.adjoin k (Set.range x) = ⊤) :
    IntermediateField.adjoin k (Set.range (linearProjectionCoordinate T x)) = ⊤ := by
  let U := IntermediateField.adjoin k (Set.range (linearProjectionCoordinate T x))
  apply top_unique
  rw [← hx]
  apply IntermediateField.adjoin_le_iff.mpr
  rintro _ ⟨i, rfl⟩
  rw [original_coordinate_eq_projection_sum T x i]
  apply U.sum_mem
  intro j _
  exact U.mul_mem (U.algebraMap_mem _) (IntermediateField.subset_adjoin k _ ⟨j, rfl⟩)

variable {K : Type u} [Field K] [Algebra k K] [Algebra K L] [IsScalarTower k K L]

/-- The original field generators and their actual changed coordinate
values construct the single fiber generator over the specified projection
field. No generation assumption on the changed coordinates is supplied. -/
theorem projection_fiber_generator_of_original_coordinates
    (T : (Fin 3 → k) ≃ₗ[k] (Fin 3 → k)) (x : Fin 3 → L)
    (hx : IntermediateField.adjoin k (Set.range x) = ⊤)
    (v : L) (b : Fin 2 → K)
    (hcoordinates : linearProjectionCoordinate T x =
      ![v, algebraMap K L (b 0), algebraMap K L (b 1)]) :
    IntermediateField.adjoin K {v} = ⊤ := by
  have hgen := linearProjectionCoordinate_field_adjoin_eq_top T x hx
  let U := IntermediateField.adjoin K {v}
  have hle : IntermediateField.adjoin k (Set.range (linearProjectionCoordinate T x)) ≤
      U.restrictScalars k := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    rw [congrFun hcoordinates i]
    fin_cases i
    · exact IntermediateField.subset_adjoin K _ (Set.mem_singleton v)
    · exact U.algebraMap_mem (b 0)
    · exact U.algebraMap_mem (b 1)
  apply IntermediateField.restrictScalars_injective k
  rw [IntermediateField.restrictScalars_top]
  apply top_unique
  rw [← hgen]
  exact hle

variable {A : Type u} [CommRing A] [Algebra k A] [Algebra A L] [IsFractionRing A L]
  [IsScalarTower k A L]

/-- Original affine algebra generation constructs the actual
function-field fiber generator after the specified linear projection.
No function-field generation hypothesis is supplied separately. -/
theorem projection_fiber_generator_of_original_affine_algebra
    (T : (Fin 3 → k) ≃ₗ[k] (Fin 3 → k)) (x : Fin 3 → A)
    (hx : Algebra.adjoin k (Set.range x) = ⊤)
    (v : L) (b : Fin 2 → K)
    (hcoordinates : linearProjectionCoordinate T (fun i => algebraMap A L (x i)) =
      ![v, algebraMap K L (b 0), algebraMap K L (b 1)]) :
    IntermediateField.adjoin K {v} = ⊤ := by
  exact projection_fiber_generator_of_original_coordinates T _
    (fraction_field_adjoin_original_coordinates x hx) v b hcoordinates

end DimensionFourDependence
