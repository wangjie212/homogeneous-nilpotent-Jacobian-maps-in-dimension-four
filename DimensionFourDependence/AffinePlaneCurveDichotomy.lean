import DimensionFourDependence.FixedLastGeometricPlaneChart

/-! # The degree-one chart is a line and the degree-two chart is a plane conic -/

namespace DimensionFourDependence

open MvPolynomial Matrix

universe u
set_option maxHeartbeats 4100000

variable {E F : Type u} [Field E] [Field F] [Algebra E F] {n : ℕ}

/-- A plane conic is given by a faithful affine plane chart whose
entire relation ideal is generated by an irreducible quadratic. -/
def LiesOnAffinePlaneConic (y : Fin n → F) : Prop :=
  ∃ W : AffinePlaneCurveChart (E := E) y, W.equation.totalDegree = 2

private theorem degree_one_binary_relation_constructs_line_parameter
    (x : Fin 2 → F) (P : MvPolynomial (Fin 2) E) (hd : P.totalDegree = 1)
    (hP : aeval x P = 0) :
    ∃ a b : Fin 2 → E, ∃ j : Fin 2, b j = 1 ∧ ∀ i,
      x i = algebraMap E F (a i) + algebraMap E F (b i) * x j := by
  let p := P.coeff 0
  let u := (pderiv 0 P).coeff 0
  let v := (pderiv 1 P).coeff 0
  have hx := affine_polynomial_expansion P hd.le
  rw [Fin.sum_univ_two] at hx
  change P = C p + (C u * X 0 + C v * X 1) at hx
  have he : algebraMap E F p + (algebraMap E F u * x 0 + algebraMap E F v * x 1) = 0 := by
    have h := congrArg (aeval x) hx
    simpa only [hP, map_add, map_mul, aeval_C, aeval_X] using h.symm
  by_cases hv : v = 0
  · have hu : u ≠ 0 := by
      intro hz
      rw [hz, hv, map_zero, zero_mul, zero_mul, add_zero, add_zero] at hx
      have h := congrArg totalDegree hx
      rw [totalDegree_C] at h
      omega
    have huF : algebraMap E F u ≠ 0 := fun h => hu ((algebraMap E F).injective (h.trans (map_zero _).symm))
    have hx₀ : x 0 = algebraMap E F (-(p / u)) := by
      rw [map_neg, map_div₀]
      rw [hv, map_zero, zero_mul, add_zero] at he
      field_simp [huF]
      linear_combination he
    refine ⟨![-(p / u), 0], ![0, 1], 1, rfl, ?_⟩
    intro i
    fin_cases i
    · change x 0 = algebraMap E F (-(p / u)) + algebraMap E F 0 * x 1
      simpa only [map_zero, zero_mul, add_zero] using hx₀
    · change x 1 = algebraMap E F 0 + algebraMap E F 1 * x 1
      simp
  · have hvF : algebraMap E F v ≠ 0 := fun h => hv ((algebraMap E F).injective (h.trans (map_zero _).symm))
    have hx₁ : x 1 = algebraMap E F (-(p / v)) + algebraMap E F (-(u / v)) * x 0 := by
      rw [map_neg, map_div₀, map_neg, map_div₀]
      field_simp [hvF]
      linear_combination he
    refine ⟨![0, -(p / v)], ![1, -(u / v)], 0, rfl, ?_⟩
    intro i
    fin_cases i
    · change x 0 = algebraMap E F 0 + algebraMap E F 1 * x 0
      simp
    · exact hx₁

/-- A chart with linear relation is an actual affine line in the
original coordinates, with nonzero direction given by its projection. -/
theorem AffinePlaneCurveChart.liesInAffineLine_of_degree_one {y : Fin n → F}
    (W : AffinePlaneCurveChart (E := E) y) (hd : W.equation.totalDegree = 1) :
    LiesInAffineLine (E := E) y := by
  let x := fun j : Fin 2 => y (W.projection j)
  have hP : aeval x W.equation = 0 := by
    change W.equation ∈ fiberVanishingIdeal (L := E) x
    exact W.relation_ideal.symm ▸ Ideal.subset_span (Set.mem_singleton _)
  obtain ⟨a, b, j, hj, hx⟩ := degree_one_binary_relation_constructs_line_parameter x W.equation hd hP
  let u : Fin n → E := fun i => (W.coordinate i).coeff 0 +
    ∑ k : Fin 2, (pderiv k (W.coordinate i)).coeff 0 * a k
  let v : Fin n → E := fun i => ∑ k : Fin 2, (pderiv k (W.coordinate i)).coeff 0 * b k
  have hv : v (W.projection j) = 1 := by
    dsimp only [v]
    rw [W.projection_identity]
    rw [show (∑ k : Fin 2, ((pderiv k) (X j : MvPolynomial (Fin 2) E)).coeff 0 * b k) = b j by
      fin_cases j <;> simp [Fin.sum_univ_two, pderiv_X, Pi.single_apply]]
    exact hj
  refine ⟨u, v, fun h => one_ne_zero (hv.symm.trans (congrFun h (W.projection j))), x j, ?_⟩
  intro i
  have h := congrArg (aeval x) (affine_polynomial_expansion (W.coordinate i) (W.degree_le_one i))
  have hval := W.coordinate_value i
  change aeval x (W.coordinate i) = _ at hval
  simp only [map_add, map_sum, map_mul, aeval_C, aeval_X, hval] at h
  rw [h]
  simp only [u, v, map_add, map_sum, map_mul]
  rw [Finset.sum_mul, add_assoc, ← Finset.sum_add_distrib]
  congr 1
  apply Finset.sum_congr rfl
  intro k _
  rw [hx k]
  ring

/-- The actual affine plane chart gives the alternatives of Corollary 5.3. -/
theorem AffinePlaneCurveChart.line_or_plane_conic {y : Fin n → F}
    (W : AffinePlaneCurveChart (E := E) y) :
    LiesInAffineLine (E := E) y ∨ LiesOnAffinePlaneConic (E := E) y := by
  rcases W.equation_degree with h | h
  · exact Or.inl (W.liesInAffineLine_of_degree_one h)
  · exact Or.inr ⟨W, h⟩

end DimensionFourDependence
