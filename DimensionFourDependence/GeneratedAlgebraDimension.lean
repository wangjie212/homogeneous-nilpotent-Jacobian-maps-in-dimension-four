import DimensionFourDependence.TranscendenceDegreeSpecialization

/-! # Dimension bounds for algebras generated by two coordinate families

The transcendence degree of a generated subalgebra is the cardinal rank
of its generators in the algebraic-independence matroid. Submodularity
then bounds the dimension of the joint algebra by the sum of the two
coordinate-family dimensions. This supplies the upper bound for actual
pairs of covering-curve parameters.
-/

namespace DimensionFourDependence

open AlgebraicIndependent

universe u

variable {K A B : Type u} [Field K] [CommRing A] [IsDomain A] [CommRing B] [IsDomain B]
variable [Algebra K A] [Algebra K B]

/-- An injective algebra map identifies the algebraic matroid of its
domain with the pullback of the target's algebraic matroid. -/
theorem algebraic_matroid_comap_injective
    (g : A →ₐ[K] B) (hg : Function.Injective g) :
    (AlgebraicIndependent.matroid K B).comap g = AlgebraicIndependent.matroid K A := by
  apply Matroid.ext_indep (by simp)
  intro I _
  rw [Matroid.comap_indep_iff, matroid_indep_iff, matroid_indep_iff,
    and_iff_left hg.injOn]
  exact (algebraicIndependent_image hg.injOn).symm.trans
    (AlgHom.algebraicIndependent_iff g hg)

/-- A subalgebra's transcendence degree is its cardinal rank as a set
in the actual ambient algebraic-independence matroid. -/
theorem subalgebra_trdeg_eq_algebraic_matroid_rank (S : Subalgebra K A) :
    Algebra.trdeg K S = (AlgebraicIndependent.matroid K A).cRk (S : Set A) := by
  calc
    _ = (AlgebraicIndependent.matroid K S).cRk Set.univ := by
      rw [← matroid_cRank_eq, ← matroid_e (R := K) (A := S), Matroid.cRk_ground]
    _ = ((AlgebraicIndependent.matroid K A).comap S.val).cRk Set.univ := by
      rw [algebraic_matroid_comap_injective S.val Subtype.val_injective]
    _ = _ := by
      rw [Matroid.cRk_comap]
      congr 1
      ext a
      simp

/-- Adjoining a generator set does not change its algebraic matroid rank. -/
theorem adjoin_trdeg_eq_algebraic_matroid_rank (S : Set A) :
    Algebra.trdeg K (Algebra.adjoin K S) = (AlgebraicIndependent.matroid K A).cRk S := by
  rw [subalgebra_trdeg_eq_algebraic_matroid_rank]
  have hc : (AlgebraicIndependent.matroid K A).closure S =
      (AlgebraicIndependent.matroid K A).closure (Algebra.adjoin K S : Set A) := by
    rw [matroid_closure_eq, matroid_closure_eq, Algebra.adjoin_eq]
  exact ((AlgebraicIndependent.matroid K A).cRk_closure_congr hc).symm

/-- The joint generated algebra has dimension at most the sum of the
dimensions of the two actual generator algebras. -/
theorem adjoin_union_trdeg_le_sum (S T : Set A) :
    Algebra.trdeg K (Algebra.adjoin K (S ∪ T)) ≤
      Algebra.trdeg K (Algebra.adjoin K S) + Algebra.trdeg K (Algebra.adjoin K T) := by
  rw [adjoin_trdeg_eq_algebraic_matroid_rank, adjoin_trdeg_eq_algebraic_matroid_rank,
    adjoin_trdeg_eq_algebraic_matroid_rank]
  exact (self_le_add_left _ _).trans
    ((AlgebraicIndependent.matroid K A).cRk_inter_add_cRk_union_le S T)

end DimensionFourDependence
