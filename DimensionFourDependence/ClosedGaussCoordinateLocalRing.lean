import DimensionFourDependence.ClosedGaussCoordinateIntegrality
import DimensionFourDependence.SourceLocalNormalization
import DimensionFourDependence.SourceDivisorLocalization
import Mathlib.RingTheory.Localization.LocalizationLocalization

/-! # Actual Gauss coordinate algebras inside the source divisor local ring

Whenever the actual closed Gauss field embeds compatibly into the source
divisor local ring, the algebra generated by the original coordinates
also embeds there. Its contracted-prime localization is exactly the
original source divisor local ring. All coordinate maps are constructed
inside the original source function field.
-/

namespace DimensionFourDependence

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1000000

variable {K : Type*} [Field K]

local notation "R" => MvPolynomial (Fin 4) K
local notation "F" => FractionRing (MvPolynomial (Fin 4) K)

/-- The original polynomial source maps into its actual coordinate
algebra over the closed Gauss field by its original four coordinates. -/
noncomputable def sourceToClosedGaussCoordinateHom
    (H : Fin 4 → R) (I : ImageRelationWitness H) :
    R →ₐ[K] closedGaussCoordinateAlgebra H I :=
  MvPolynomial.aeval fun i =>
    ⟨rationalCoordinate i, Algebra.subset_adjoin ⟨i, rfl⟩⟩

/-- The constructed coordinate map is the canonical source inclusion
after realizing its values in the original rational function field. -/
theorem sourceToClosedGaussCoordinateHom_source
    (H : Fin 4 → R) (I : ImageRelationWitness H) (r : R) :
    (sourceToClosedGaussCoordinateHom H I r : F) = algebraMap R F r := by
  have h : ((closedGaussCoordinateAlgebra H I).val.restrictScalars K).comp
      (sourceToClosedGaussCoordinateHom H I) = Algebra.algHom K R F := by
    apply MvPolynomial.algHom_ext
    intro i
    simp only [AlgHom.comp_apply, sourceToClosedGaussCoordinateHom, MvPolynomial.aeval_X]
    rfl
  exact AlgHom.congr_fun h r

variable (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
  (Q : Ideal (MvPolynomial (Fin 4) K)) [Q.IsPrime]
  [Algebra (closedGaussParameterField H I) (Localization.AtPrime Q)]
  [IsScalarTower (closedGaussParameterField H I) (Localization.AtPrime Q)
    (FractionRing (MvPolynomial (Fin 4) K))]

/-- The actual coordinate algebra lies in the image of the source divisor
local ring, because its parameter field and all original coordinates do. -/
theorem closedGaussCoordinateAlgebra_le_local_range :
    closedGaussCoordinateAlgebra H I ≤
      (IsScalarTower.toAlgHom (closedGaussParameterField H I) (Localization.AtPrime Q) F).range := by
  apply Algebra.adjoin_le
  rintro _ ⟨i, rfl⟩
  refine ⟨algebraMap R (Localization.AtPrime Q) (MvPolynomial.X i), ?_⟩
  exact (IsScalarTower.algebraMap_apply R (Localization.AtPrime Q) F (MvPolynomial.X i)).symm

/-- The actual closed Gauss coordinate algebra embeds into the source
divisor local ring by the compatible original function-field inclusion. -/
noncomputable def closedGaussCoordinateLocalHom :
    closedGaussCoordinateAlgebra H I →ₐ[closedGaussParameterField H I] Localization.AtPrime Q :=
  (AlgEquiv.ofInjective
    (IsScalarTower.toAlgHom (closedGaussParameterField H I) (Localization.AtPrime Q) F)
    (IsFractionRing.injective (Localization.AtPrime Q) F)).symm.toAlgHom.comp
      (Subalgebra.inclusion (closedGaussCoordinateAlgebra_le_local_range H I Q))

/-- The local coordinate embedding preserves the same original source
rational functions, rather than merely giving an abstract ring map. -/
theorem closedGaussCoordinateLocalHom_source (x : closedGaussCoordinateAlgebra H I) :
    algebraMap (Localization.AtPrime Q) F (closedGaussCoordinateLocalHom H I Q x) = x.val := by
  exact congrArg Subtype.val
    ((AlgEquiv.ofInjective
      (IsScalarTower.toAlgHom (closedGaussParameterField H I) (Localization.AtPrime Q) F)
      (IsFractionRing.injective (Localization.AtPrime Q) F)).apply_symm_apply
        (Subalgebra.inclusion (closedGaussCoordinateAlgebra_le_local_range H I Q) x))

/-- The actual coordinate local map is injective. -/
theorem closedGaussCoordinateLocalHom_injective :
    Function.Injective (closedGaussCoordinateLocalHom H I Q) := by
  intro x y hxy
  apply Subtype.ext
  rw [← closedGaussCoordinateLocalHom_source H I Q x,
    ← closedGaussCoordinateLocalHom_source H I Q y, hxy]

/-- The two constructed coordinate maps recover the original source
localization map on every original polynomial. -/
theorem sourceToClosedGaussCoordinateHom_local (r : R) :
    closedGaussCoordinateLocalHom H I Q (sourceToClosedGaussCoordinateHom H I r) =
      algebraMap R (Localization.AtPrime Q) r := by
  apply IsFractionRing.injective (Localization.AtPrime Q) F
  rw [closedGaussCoordinateLocalHom_source, sourceToClosedGaussCoordinateHom_source]
  exact IsScalarTower.algebraMap_apply R (Localization.AtPrime Q) F r

/-- The actual coordinate local map has the required original-source
function-field scalar tower. -/
theorem closedGaussCoordinateLocalHom_scalarTower :
    letI : Algebra (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
      (closedGaussCoordinateLocalHom H I Q).toRingHom.toAlgebra
    IsScalarTower (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) F := by
  let : Algebra (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
    (closedGaussCoordinateLocalHom H I Q).toRingHom.toAlgebra
  exact IsScalarTower.of_algebraMap_eq
    (fun x => (closedGaussCoordinateLocalHom_source H I Q x).symm)

/-- The actual closed Gauss coordinate algebra has exactly the original
source local ring at the contracted source divisor prime. -/
theorem actual_closed_gauss_coordinate_source_localization :
    letI : Algebra (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
      (closedGaussCoordinateLocalHom H I Q).toRingHom.toAlgebra
    IsLocalization.AtPrime (Localization.AtPrime Q)
      ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).under (closedGaussCoordinateAlgebra H I)) := by
  let : Algebra R (closedGaussCoordinateAlgebra H I) :=
    (sourceToClosedGaussCoordinateHom H I).toRingHom.toAlgebra
  let : Algebra (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
    (closedGaussCoordinateLocalHom H I Q).toRingHom.toAlgebra
  let : IsScalarTower R (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
    IsScalarTower.of_algebraMap_eq (fun r => (sourceToClosedGaussCoordinateHom_local H I Q r).symm)
  let : FaithfulSMul (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (closedGaussCoordinateLocalHom_injective H I Q)
  exact intermediate_algebra_source_localization Q

/-- The normalization of the actual closed Gauss coordinate algebra
also recovers the original source divisor DVR at its contracted prime.
Normality is supplied by the actual principal source divisor, and the
normalization map preserves its original function-field realization. -/
theorem actual_closed_gauss_coordinate_normalization_source_localization
    (f : R) (hf : Prime f) (hQ : Q = Ideal.span {f}) :
    letI : Algebra (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
      (closedGaussCoordinateLocalHom H I Q).toRingHom.toAlgebra
    letI : IsScalarTower (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) F :=
      closedGaussCoordinateLocalHom_scalarTower H I Q
    letI : IsDiscreteValuationRing (Localization.AtPrime Q) :=
      principal_prime_localization_isDVR Q f hf hQ
    letI : Algebra (integralClosure (closedGaussCoordinateAlgebra H I) F) (Localization.AtPrime Q) :=
      (integralClosureToNormalLocalHom (S := closedGaussCoordinateAlgebra H I)
        (A := Localization.AtPrime Q) («F» := F)).toRingHom.toAlgebra
    IsLocalization.AtPrime (Localization.AtPrime Q)
      ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).under
        (integralClosure (closedGaussCoordinateAlgebra H I) F)) := by
  let : Algebra (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
    (closedGaussCoordinateLocalHom H I Q).toRingHom.toAlgebra
  let : IsScalarTower (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) F :=
    closedGaussCoordinateLocalHom_scalarTower H I Q
  let : IsDiscreteValuationRing (Localization.AtPrime Q) :=
    principal_prime_localization_isDVR Q f hf hQ
  let : Algebra (integralClosure (closedGaussCoordinateAlgebra H I) F) (Localization.AtPrime Q) :=
    (integralClosureToNormalLocalHom (S := closedGaussCoordinateAlgebra H I)
      (A := Localization.AtPrime Q) («F» := F)).toRingHom.toAlgebra
  let : FaithfulSMul (closedGaussCoordinateAlgebra H I) (Localization.AtPrime Q) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr (closedGaussCoordinateLocalHom_injective H I Q)
  let : IsLocalization.AtPrime (Localization.AtPrime Q)
      ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).under (closedGaussCoordinateAlgebra H I)) :=
    actual_closed_gauss_coordinate_source_localization H I Q
  exact normalized_intermediate_algebra_source_localization
    («R» := closedGaussCoordinateAlgebra H I) (S := closedGaussCoordinateAlgebra H I)
    ((IsLocalRing.maximalIdeal (Localization.AtPrime Q)).under (closedGaussCoordinateAlgebra H I))

end DimensionFourDependence
