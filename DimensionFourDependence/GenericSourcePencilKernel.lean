import DimensionFourDependence.GaussPencilDegreeBound
import Mathlib.RingTheory.MvPolynomial.Localization

/-! # The single equation of the generic source pencil

Localizing the parameter-polynomial coefficient ring clears every rational
parameter denominator. The previously checked independent-parameter kernel
then shows that all original-source relations over the rational parameter
field are generated by the single equation `p - T q`.
-/

namespace DimensionFourDependence

open MvPolynomial

variable {K : Type*} [Field K]

local notation "R" => MvPolynomial (Fin 4) K
local notation "F" => FractionRing (MvPolynomial (Fin 4) K)

/-- The pencil equation in the source polynomial ring over the actual
rational parameter field. -/
noncomputable def genericSourcePencilEquation (p q : R) : MvPolynomial (Fin 4) (RatFunc K) :=
  MvPolynomial.map (algebraMap K (RatFunc K)) p -
    C RatFunc.X * MvPolynomial.map (algebraMap K (RatFunc K)) q

/-- Swapping source and parameter is compatible with the actual rational
parameter realization in the original source field. -/
theorem parameterSourceSwap_evaluation
    (f : RatFunc K →ₐ[K] F) (A : MvPolynomial (Fin 4) (Polynomial K)) :
    Polynomial.eval₂ (algebraMap R F) (f RatFunc.X) (parameterSourceSwap K 4 A) =
      MvPolynomial.eval₂ f.toRingHom (rationalCoordinate (K := K) (n := 4))
        (MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K)) A) := by
  induction A using MvPolynomial.induction_on with
  | C r =>
    rw [parameterSourceSwap_C, Polynomial.eval₂_map, MvPolynomial.map_C, eval₂_C]
    exact (rational_function_algHom_polynomial_value f r).symm
  | add A B hA hB =>
    simp only [map_add, Polynomial.eval₂_add, eval₂_add, hA, hB]
  | mul_X A i hA =>
    rw [map_mul, parameterSourceSwap_X, Polynomial.eval₂_mul, Polynomial.eval₂_C,
      map_mul, MvPolynomial.map_X, eval₂_mul, eval₂_X, hA]
    rfl

/-- The parameter-polynomial lift maps to the rational-parameter pencil. -/
theorem genericSourcePencilEquation_lift (p q : R) :
    MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K))
      (MvPolynomial.map Polynomial.C p - C Polynomial.X * MvPolynomial.map Polynomial.C q) =
        genericSourcePencilEquation p q := by
  simp only [map_sub, map_mul, MvPolynomial.map_C, MvPolynomial.map_map,
    genericSourcePencilEquation]
  rfl

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- The entire actual rational-parameter relation kernel is generated by
the reduced generic pencil equation. -/
theorem genericSourcePencilEquation_dvd_iff_evaluation_zero
    (p q : R) (hq : q ≠ 0) (hrel : IsRelPrime p q)
    (f : RatFunc K →ₐ[K] F)
    (ht : f RatFunc.X = algebraMap R F p / algebraMap R F q)
    (P : MvPolynomial (Fin 4) (RatFunc K)) :
    genericSourcePencilEquation p q ∣ P ↔
      MvPolynomial.eval₂ f.toRingHom (rationalCoordinate (K := K) (n := 4)) P = 0 := by
  let v := MvPolynomial.eval₂Hom f.toRingHom (rationalCoordinate (K := K) (n := 4))
  let L : MvPolynomial (Fin 4) (Polynomial K) :=
    MvPolynomial.map Polynomial.C p - C Polynomial.X * MvPolynomial.map Polynomial.C q
  have hL : parameterSourceSwap K 4 L = sourcePencilEquation p q := by
    simp only [L, map_sub, map_mul, parameterSourceSwap_map_source, parameterSourceSwap_C_X,
      sourcePencilEquation, Polynomial.C_neg]
    ring
  have hvL : v (genericSourcePencilEquation p q) = 0 := by
    rw [← genericSourcePencilEquation_lift]
    change MvPolynomial.eval₂ f.toRingHom (rationalCoordinate (K := K) (n := 4))
      (MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K)) L) = 0
    rw [← parameterSourceSwap_evaluation, hL, ht]
    exact sourcePencilEquation_eval_fraction p q hq
  constructor
  · rintro ⟨Q, rfl⟩
    change v (genericSourcePencilEquation p q * Q) = 0
    rw [map_mul, hvL, zero_mul]
  · intro hP
    let S := (nonZeroDivisors (Polynomial K)).map (C : Polynomial K →+* MvPolynomial (Fin 4) (Polynomial K))
    obtain ⟨d, A, hA⟩ := IsLocalization.exists_integer_multiple S P
    obtain ⟨r, hr, hdr⟩ := d.property
    have hAr : MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K)) A =
        C (algebraMap (Polynomial K) (RatFunc K) r) * P := by
      change algebraMap (MvPolynomial (Fin 4) (Polynomial K)) (MvPolynomial (Fin 4) (RatFunc K)) A = _
      rw [hA, Algebra.smul_def, ← hdr, MvPolynomial.algebraMap_def, MvPolynomial.map_C]
    have hAz : Polynomial.eval₂ (algebraMap R F) (algebraMap R F p / algebraMap R F q)
        (parameterSourceSwap K 4 A) = 0 := by
      rw [← ht, parameterSourceSwap_evaluation, hAr, eval₂_mul, hP, mul_zero]
    obtain ⟨B, hB⟩ := (sourcePencilEquation_dvd_iff_eval_fraction_zero p q hq hrel _).mpr hAz
    have hLA : L ∣ A := by
      refine ⟨(parameterSourceSwap K 4).symm B, ?_⟩
      apply (parameterSourceSwap K 4).injective
      rw [map_mul, hL, AlgEquiv.apply_symm_apply]
      exact hB
    have hdiv : genericSourcePencilEquation p q ∣ C (algebraMap (Polynomial K) (RatFunc K) r) * P := by
      rw [← hAr, ← genericSourcePencilEquation_lift]
      exact map_dvd (MvPolynomial.map (algebraMap (Polynomial K) (RatFunc K))) hLA
    have hr0 : algebraMap (Polynomial K) (RatFunc K) r ≠ 0 :=
      IsFractionRing.to_map_ne_zero_of_mem_nonZeroDivisors hr
    have hu : IsUnit (C (algebraMap (Polynomial K) (RatFunc K) r) : MvPolynomial (Fin 4) (RatFunc K)) :=
      (isUnit_iff_ne_zero.mpr hr0).map C
    exact hu.dvd_mul_left.mp hdiv

/-- The generic equation is nonzero: coefficient localization is injective
and the parameter-polynomial lift is the nonzero reduced pencil equation. -/
theorem genericSourcePencilEquation_ne_zero (p q : R) (hq : q ≠ 0)
    (hrel : IsRelPrime p q) : genericSourcePencilEquation p q ≠ 0 := by
  let L : MvPolynomial (Fin 4) (Polynomial K) :=
    MvPolynomial.map Polynomial.C p - C Polynomial.X * MvPolynomial.map Polynomial.C q
  have hL : parameterSourceSwap K 4 L = sourcePencilEquation p q := by
    simp only [L, map_sub, map_mul, parameterSourceSwap_map_source, parameterSourceSwap_C_X,
      sourcePencilEquation, Polynomial.C_neg]
    ring
  have hL0 : L ≠ 0 := by
    intro hz
    have hh := congrArg (parameterSourceSwap K 4) hz
    rw [hL, map_zero] at hh
    exact (sourcePencilEquation_irreducible p q hq hrel).ne_zero hh
  rw [← genericSourcePencilEquation_lift]
  have hi := MvPolynomial.map_injective (σ := Fin 4)
    (algebraMap (Polynomial K) (RatFunc K))
    (IsFractionRing.injective (Polynomial K) (RatFunc K))
  exact fun hz => hL0 (hi (hz.trans (map_zero _).symm))

/-- Equal homogeneous source degrees give that same generic pencil degree. -/
theorem genericSourcePencilEquation_isHomogeneous (p q : R) {d : ℕ}
    (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous d) :
    (genericSourcePencilEquation p q).IsHomogeneous d :=
  (hp.map (algebraMap K (RatFunc K))).sub
    ((hq.map (algebraMap K (RatFunc K))).C_mul RatFunc.X)

/-- The exact rational-parameter evaluation kernel is the principal
ideal of the generic source pencil equation. -/
theorem genericSourcePencilEquation_evaluation_kernel
    (p q : R) (hq : q ≠ 0) (hrel : IsRelPrime p q)
    (f : RatFunc K →ₐ[K] F)
    (ht : f RatFunc.X = algebraMap R F p / algebraMap R F q) :
    RingHom.ker (MvPolynomial.eval₂Hom f.toRingHom (rationalCoordinate (K := K) (n := 4))) =
      Ideal.span {genericSourcePencilEquation p q} := by
  ext P
  change MvPolynomial.eval₂ f.toRingHom (rationalCoordinate (K := K) (n := 4)) P = 0 ↔ _
  rw [Ideal.mem_span_singleton,
    genericSourcePencilEquation_dvd_iff_evaluation_zero p q hq hrel f ht P]

end DimensionFourDependence
