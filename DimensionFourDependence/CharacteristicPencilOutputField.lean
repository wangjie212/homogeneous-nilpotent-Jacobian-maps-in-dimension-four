import DimensionFourDependence.CharacteristicPencilRegularZero
import DimensionFourDependence.PencilCoefficientCurveField
import DimensionFourDependence.LinearPencilProjectiveField

/-! # The characteristic parameter field is the actual projective output field -/

namespace DimensionFourDependence

open MvPolynomial AlgebraicGeometry

universe u

set_option maxHeartbeats 3000000
set_option synthInstance.maxHeartbeats 100000
set_option backward.isDefEq.respectTransparency true
set_option backward.isDefEq.respectTransparency.types true

variable {K : Type u} [Field K] [CharZero K]
  (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
  (E : Type u) [Field E] [Algebra (closedGaussParameterField H I) E]
  [Algebra.IsAlgebraic (closedGaussParameterField H I) E]
  {d : ℕ} (hH : IsHomogMap H d)
  (e : RatFunc K ≃ₐ[K] closedGaussParameterField H I)

local notation "N" => extendedClosedGaussNormalizationScheme H I E hH e
local notation "w" => extendedClosedGaussNormalizationHyperplaneWeight H I E hH e
local notation "O" => extendedClosedGaussOutputLinearPolynomial H I E
local notation "Y" => fun i => aeval (w) (MvPolynomial.map (extendedClosedGaussSourceCoefficientHom H I E) (H i))

local instance characteristicPencilOutputFieldIntegral : IsIntegral N :=
  extendedClosedGaussNormalizationScheme_isIntegral H I E hH e
noncomputable local instance characteristicPencilOutputFieldAlgebra : Algebra E (N).functionField :=
  extendedClosedGaussOwnFunctionFieldAlgebra H I E hH e

variable [Module.Finite (closedGaussParameterField H I) E]

/-- The characteristic pencil's denominator is nonzero: its
internally proved transcendental ratio cannot be the zero quotient. -/
theorem actual_characteristic_pencil_tangent_value_ne_zero
    (hd : 1 < d) (hind : ¬ComponentsDependent H) (hGauss : gaussImageDimension H I = 1)
    (cS cN : Fin 4 → E) (r : (N).functionField) (hr : r ≠ 0)
    (hroot : r ^ d = aeval w ((O) cS))
    (hfactor : CharacteristicNativeRulingRootFactorization H I E hH e (by omega) hind hGauss cN r) :
    (∑ j, algebraMap E (N).functionField
      (extendedClosedGaussChosenRulingMatrix H I E hH (Nat.lt_trans Nat.zero_lt_one hd) hind hGauss 0 j) * w j) ≠ 0 := by
  have ht := actual_characteristic_pencil_value_transcendental
    H I E hH e hd hind hGauss cS cN r hr hroot hfactor
  intro hz
  apply ht
  change IsAlgebraic E (r / _)
  rw [hz, div_zero]
  exact isAlgebraic_zero

/-- In every actual nonzero output chart, the original projective
output field is exactly the field generated by rho/L_t over the same
extended Gauss constants. -/
theorem actual_characteristic_pencil_projective_output_field_eq_adjoin
    (hd : 1 < d) (hind : ¬ComponentsDependent H) (hGauss : gaussImageDimension H I = 1)
    (cS cN : Fin 4 → E) (r : (N).functionField) (hr : r ≠ 0)
    (hroot : r ^ d = aeval w ((O) cS))
    (hfactor : CharacteristicNativeRulingRootFactorization H I E hH e (by omega) hind hGauss cN r)
    (a : Fin 4) (ha : (Y) a ≠ 0) :
    projectiveRatioField (K := E) (Y) a = IntermediateField.adjoin E
      {nativeCharacteristicPencilValue H I E hH e (Nat.lt_trans Nat.zero_lt_one hd) hind hGauss r} := by
  let T := ∑ j, algebraMap E (N).functionField
    (extendedClosedGaussChosenRulingMatrix H I E hH (Nat.lt_trans Nat.zero_lt_one hd) hind hGauss 0 j) * w j
  have hT : T ≠ 0 := actual_characteristic_pencil_tangent_value_ne_zero
    H I E hH e hd hind hGauss cS cN r hr hroot hfactor
  obtain ⟨V, W, hVW, _hV, _hW, _hchar, _hspan, _hN, hY⟩ := hfactor
  have hcoords (i : Fin 4) : (Y) i = (r ^ (d - 1) * T) *
      ((r / T) * algebraMap E (N).functionField (V i) + algebraMap E (N).functionField (W i)) := by
    rw [hY i]
    change r ^ (d - 1) * (r * algebraMap E (N).functionField (V i) +
      T * algebraMap E (N).functionField (W i)) = _
    field_simp [hT]
    <;> ring
  exact independent_linear_pencil_projective_field_eq_adjoin V W hVW
    (r ^ (d - 1) * T) (r / T) (mul_ne_zero (pow_ne_zero _ hr) hT) (Y) hcoords a ha

/-- The actual factorization supplies a nonzero original output
chart and identifies its entire projective output field with the
characteristic parameter field, without a chosen output pivot. -/
theorem actual_characteristic_pencil_constructs_projective_output_field_chart
    (hd : 1 < d) (hind : ¬ComponentsDependent H) (hGauss : gaussImageDimension H I = 1)
    (cS cN : Fin 4 → E) (r : (N).functionField) (hr : r ≠ 0)
    (hroot : r ^ d = aeval w ((O) cS))
    (hfactor : CharacteristicNativeRulingRootFactorization H I E hH e (by omega) hind hGauss cN r) :
    ∃ a : Fin 4, (Y) a ≠ 0 ∧ projectiveRatioField (K := E) (Y) a = IntermediateField.adjoin E
      {nativeCharacteristicPencilValue H I E hH e (Nat.lt_trans Nat.zero_lt_one hd) hind hGauss r} := by
  let T := ∑ j, algebraMap E (N).functionField
    (extendedClosedGaussChosenRulingMatrix H I E hH (Nat.lt_trans Nat.zero_lt_one hd) hind hGauss 0 j) * w j
  have hT : T ≠ 0 := actual_characteristic_pencil_tangent_value_ne_zero
    H I E hH e hd hind hGauss cS cN r hr hroot hfactor
  obtain ⟨V, W, hVW, _hV, _hW, _hchar, _hspan, _hN, hY⟩ := hfactor
  have hcoords (i : Fin 4) : (Y) i = (r ^ (d - 1) * T) *
      ((r / T) * algebraMap E (N).functionField (V i) + algebraMap E (N).functionField (W i)) := by
    rw [hY i]
    change r ^ (d - 1) * (r * algebraMap E (N).functionField (V i) +
      T * algebraMap E (N).functionField (W i)) = _
    field_simp [hT]
    <;> ring
  obtain ⟨a, ha⟩ := independent_linear_pencil_has_nonzero_coordinate V W hVW
    (r ^ (d - 1) * T) (r / T) (mul_ne_zero (pow_ne_zero _ hr) hT) (Y) hcoords
  exact ⟨a, ha, independent_linear_pencil_projective_field_eq_adjoin V W hVW
    (r ^ (d - 1) * T) (r / T) (mul_ne_zero (pow_ne_zero _ hr) hT) (Y) hcoords a ha⟩

/-- The full relatively closed pencil coefficient curve is exactly
the relative algebraic closure of the actual projective output field,
as an intermediate field over the original extended constants. -/
theorem actual_characteristic_pencil_coefficient_curve_eq_projective_output_closure
    (hd : 1 < d) (hind : ¬ComponentsDependent H) (hGauss : gaussImageDimension H I = 1)
    (cS cN : Fin 4 → E) (r : (N).functionField) (hr : r ≠ 0)
    (hroot : r ^ d = aeval w ((O) cS))
    (hfactor : CharacteristicNativeRulingRootFactorization H I E hH e (by omega) hind hGauss cN r)
    (a : Fin 4) (ha : (Y) a ≠ 0) :
    (algebraicClosure (projectiveRatioField (K := E) (Y) a) (N).functionField).restrictScalars E =
      (pencilCoefficientCurveField (E := E) (nativeCharacteristicPencilValue
        H I E hH e (Nat.lt_trans Nat.zero_lt_one hd) hind hGauss r)).restrictScalars E := by
  rw [actual_characteristic_pencil_projective_output_field_eq_adjoin
    H I E hH e hd hind hGauss cS cN r hr hroot hfactor a ha]

end DimensionFourDependence
