import DimensionFourDependence.SaturatedRadialMap

/-! # Coordinates of the generic output value

Evaluation at the output coordinates inside `K(H)` retains exactly the
original image relations, also after extending this field.
-/

namespace DimensionFourDependence

open MvPolynomial

variable {K F : Type*} [Field K] [Field F] [Algebra K F] {n : ℕ}

/-- The actual output coordinate as an element of its generated field. -/
noncomputable def fullOutputCoordinate (H : Fin n → F) (i : Fin n) : fullOutputField (K := K) H :=
  ⟨H i, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩

theorem fullOutputCoordinate_aeval (H : Fin n → F) (p : MvPolynomial (Fin n) K) :
    algebraMap (fullOutputField (K := K) H) F (aeval (fullOutputCoordinate (K := K) H) p) =
      aeval H p := by
  exact comp_aeval_apply _ (fullOutputField (K := K) H).val p

/-- A field extension of the generic output value has exactly the same
polynomial equations over the original coefficient field. -/
theorem fullOutputCoordinate_extended_relations
    (H : Fin n → F) (E : Type*) [Field E] [Algebra (fullOutputField (K := K) H) E]
    [Algebra K E] [IsScalarTower K (fullOutputField (K := K) H) E]
    (p : MvPolynomial (Fin n) K) :
    aeval (fun i => algebraMap (fullOutputField (K := K) H) E (fullOutputCoordinate (K := K) H i)) p = 0
      ↔ aeval H p = 0 := by
  have he := comp_aeval_apply (fullOutputCoordinate (K := K) H)
    (IsScalarTower.toAlgHom K (fullOutputField (K := K) H) E) p
  change algebraMap (fullOutputField (K := K) H) E
    (aeval (fullOutputCoordinate (K := K) H) p) =
      aeval (fun i => algebraMap (fullOutputField (K := K) H) E
        (fullOutputCoordinate (K := K) H i)) p at he
  rw [← he, map_eq_zero_iff _ (algebraMap (fullOutputField (K := K) H) E).injective]
  rw [← fullOutputCoordinate_aeval H p,
    map_eq_zero_iff _ (algebraMap (fullOutputField (K := K) H) F).injective]

/-- Nonzero polynomial maps have a nonzero generic output vector. -/
theorem fullOutputCoordinate_extended_ne_zero
    (H : Fin n → F) (hH : H ≠ 0) (E : Type*) [Field E]
    [Algebra (fullOutputField (K := K) H) E] :
    (fun i => algebraMap (fullOutputField (K := K) H) E (fullOutputCoordinate (K := K) H i)) ≠ 0 := by
  intro hz
  apply hH
  funext i
  have hi := congrFun hz i
  have hi' : fullOutputCoordinate (K := K) H i = 0 :=
    (algebraMap (fullOutputField (K := K) H) E).injective (by simpa only [map_zero, Pi.zero_apply] using hi)
  exact congrArg (fun a : fullOutputField (K := K) H => (a : F)) hi'

/-- The field generated by the rational images of a polynomial map. -/
@[reducible] noncomputable def polynomialOutputField (H : Fin n → MvPolynomial (Fin n) K) :
    IntermediateField K (FractionRing (MvPolynomial (Fin n) K)) :=
  fullOutputField (K := K) (fun i => algebraMap (MvPolynomial (Fin n) K)
    (FractionRing (MvPolynomial (Fin n) K)) (H i))

/-- The actual generic value in an extension of the full output field. -/
noncomputable def genericOutputValue (H : Fin n → MvPolynomial (Fin n) K)
    (E : Type*) [Field E] [Algebra (polynomialOutputField H) E] : Fin n → E :=
  fun i => algebraMap (polynomialOutputField H) E
    (fullOutputCoordinate (K := K) (fun i => algebraMap (MvPolynomial (Fin n) K)
      (FractionRing (MvPolynomial (Fin n) K)) (H i)) i)

theorem genericOutputValue_ne_zero (H : Fin n → MvPolynomial (Fin n) K)
    (hH : H ≠ 0) (E : Type*) [Field E] [Algebra (polynomialOutputField H) E] :
    genericOutputValue H E ≠ 0 := by
  apply fullOutputCoordinate_extended_ne_zero
  intro hz
  apply hH
  funext i
  apply IsFractionRing.injective (MvPolynomial (Fin n) K) (FractionRing (MvPolynomial (Fin n) K))
  simpa only [map_zero, Pi.zero_apply] using congrFun hz i

/-- Original polynomial image relations are detected by the generic value. -/
theorem genericOutputValue_relations (H : Fin n → MvPolynomial (Fin n) K)
    (E : Type*) [Field E] [Algebra (polynomialOutputField H) E]
    [Algebra K E] [IsScalarTower K (polynomialOutputField H) E]
    (p : MvPolynomial (Fin n) K) :
    aeval (genericOutputValue H E) p = 0 ↔ aeval H p = 0 := by
  unfold genericOutputValue
  rw [fullOutputCoordinate_extended_relations, ← aeval_polynomial_to_fraction]
  exact map_eq_zero_iff _ (IsFractionRing.injective (MvPolynomial (Fin n) K)
    (FractionRing (MvPolynomial (Fin n) K)))

end DimensionFourDependence
