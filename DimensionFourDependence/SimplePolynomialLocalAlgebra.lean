import DimensionFourDependence.BinaryFirstOrderDivision
import DimensionFourDependence.RationalPointLocalModel
import DimensionFourDependence.SimpleRootLocalIntersection

/-! # Local doubled-line bounds from an arbitrary original simple-root polynomial

An exact polynomial division constructs a factor whose origin value is
the nonzero transverse derivative. That factor is a unit in the actual
local algebra, so the maximal ideal is generated by the doubled-line
coordinate. Its square is zero, and the residue-field comparison gives
the dimension and length bounds. No quadratic coefficient presentation
is required.
-/

namespace DimensionFourDependence

open MvPolynomial Module

variable {F A : Type*} [Field F] [CommRing A] [Algebra F A] [IsLocalRing A]

omit [IsLocalRing A] in
/-- Evaluation at the actual local coordinates retains the original
rational-origin values after applying the local point map. -/
theorem rational_local_polynomial_value (ev : A →ₐ[F] F) (u v : A)
    (hu : ev u = 0) (hv : ev v = 0) (P : MvPolynomial (Fin 2) F) :
    ev (aeval ![u, v] P) = aeval (fun _ : Fin 2 => (0 : F)) P := by
  have he : ev.comp (aeval ![u, v]) = aeval (fun _ : Fin 2 => (0 : F)) := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i <;> simp [hu, hv]
  exact DFunLike.congr_fun he P

/-- A nonzero transverse derivative constructs the local unit which
eliminates v and makes the actual maximal ideal principal. -/
theorem simple_polynomial_double_line_maximal_ideal_principal
    (ev : A →ₐ[F] F) (u v : A) (hu : ev u = 0) (hv : ev v = 0)
    (hmax : IsLocalRing.maximalIdeal A = Ideal.span ({u, v} : Set A))
    (hu2 : u ^ 2 = 0) (P : MvPolynomial (Fin 2) F)
    (hP : aeval (fun _ : Fin 2 => (0 : F)) P = 0)
    (hPv : aeval (fun _ : Fin 2 => (0 : F)) (pderiv 1 P) ≠ 0)
    (hzero : aeval ![u, v] P = 0) :
    IsLocalRing.maximalIdeal A = Ideal.span ({u} : Set A) := by
  obtain ⟨R, Q, hdecomp, hQ⟩ := binary_origin_polynomial_division P hP
  let phi : MvPolynomial (Fin 2) F →ₐ[F] A := aeval ![u, v]
  let a := algebraMap F A (aeval (fun _ : Fin 2 => (0 : F)) (pderiv 0 P))
  have hunit : IsUnit (phi Q) := by
    apply (rational_local_algebra_isUnit_iff ev _).mpr
    rw [rational_local_polynomial_value ev u v hu hv Q, hQ]
    exact hPv
  have he : a * u + v * phi Q = 0 := by
    have hh := congrArg phi hdecomp
    simp only [phi, map_add, map_mul, map_pow, aeval_C, aeval_X,
      Matrix.cons_val_zero, Matrix.cons_val_one, hu2, zero_mul, add_zero] at hh
    rw [hzero] at hh
    exact hh.symm
  obtain ⟨w, hw⟩ := hunit
  have hlin : v * phi Q = -(a * u) := by linear_combination he
  have hvrep : v = (-(a * (↑w⁻¹ : A))) * u := by
    calc
      v = (v * (w : A)) * (↑w⁻¹ : A) := by simp [mul_assoc]
      _ = _ := by rw [hw, hlin]; ring
  rw [hmax]
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro z (rfl | rfl)
    · exact Ideal.subset_span (by simp)
    · rw [hvrep]
      exact (Ideal.span ({u} : Set A)).mul_mem_left _ (Ideal.subset_span (by simp))
  · apply Ideal.span_mono
    intro z hz
    simp only [Set.mem_singleton_iff, Set.mem_insert_iff] at hz ⊢
    exact Or.inl hz

/-- A rational local algebra with square-zero principal maximal ideal
is spanned by its scalar one and the actual nilpotent coordinate. -/
theorem rational_principal_square_zero_local_span
    (ev : A →ₐ[F] F) (u : A) (hu2 : u ^ 2 = 0)
    (hmax : IsLocalRing.maximalIdeal A = Ideal.span ({u} : Set A)) :
    Submodule.span F (Set.range ![(1 : A), u]) = ⊤ := by
  apply top_unique
  intro z _
  obtain ⟨a, b, hz⟩ := square_zero_principal_local_algebra_expression u hu2 hmax
    (rational_local_algebra_coefficient_residue_surjective ev) z
  rw [hz]
  have h1 : (1 : A) ∈ Submodule.span F (Set.range ![(1 : A), u]) := Submodule.subset_span ⟨0, rfl⟩
  have hU : u ∈ Submodule.span F (Set.range ![(1 : A), u]) := Submodule.subset_span ⟨1, rfl⟩
  exact (Submodule.span F (Set.range ![(1 : A), u])).add_mem
    (by simpa only [Algebra.smul_def, mul_one] using
      (Submodule.span F (Set.range ![(1 : A), u])).smul_mem a h1)
    (by simpa only [Algebra.smul_def] using
      (Submodule.span F (Set.range ![(1 : A), u])).smul_mem b hU)

/-- The doubled-line local intersection bound follows directly from
the original polynomial value and its nonzero transverse derivative. -/
theorem simple_polynomial_double_line_local_dimension_and_length_le_two
    (ev : A →ₐ[F] F) (u v : A) (hu : ev u = 0) (hv : ev v = 0)
    (hmax : IsLocalRing.maximalIdeal A = Ideal.span ({u, v} : Set A))
    (hu2 : u ^ 2 = 0) (P : MvPolynomial (Fin 2) F)
    (hP : aeval (fun _ : Fin 2 => (0 : F)) P = 0)
    (hPv : aeval (fun _ : Fin 2 => (0 : F)) (pderiv 1 P) ≠ 0)
    (hzero : aeval ![u, v] P = 0) :
    Module.Finite F A ∧ finrank F A ≤ 2 ∧ Module.length A A ≤ 2 := by
  have hprincipal := simple_polynomial_double_line_maximal_ideal_principal ev u v hu hv hmax hu2 P hP hPv hzero
  have hspan := rational_principal_square_zero_local_span ev u hu2 hprincipal
  have hdim : finrank F A ≤ 2 := by simpa using finrank_le_of_span_eq_top hspan
  have hfinite : Module.Finite F A := by
    apply Module.Finite.of_fg_top
    rw [← hspan]
    exact Submodule.fg_span (Set.finite_range _)
  let := hfinite
  exact ⟨hfinite, hdim, (local_algebra_length_le_coefficient_dimension (F := F) (A := A)).trans
    (by exact_mod_cast hdim)⟩

end DimensionFourDependence
