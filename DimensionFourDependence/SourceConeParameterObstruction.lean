import DimensionFourDependence.RationalParameterTangentTransport
import DimensionFourDependence.SourceDivisorLocalization
import DimensionFourDependence.PrimeLocalizationFunctionField

/-! # The local obstruction in the original source-cone ring

The actual cone prime determines its local ring and residue field.
The power of its equation in the original common factor, the local
unit, the faithful fraction-space realization and parameter transport
are all constructed. Tangent and common-kernel geometry remain explicit.
-/

namespace DimensionFourDependence

open MvPolynomial Matrix IsLocalRing

variable {K : Type*} [Field K] {n : ℕ}
  (Q : Ideal (MvPolynomial (Fin n) K)) [Q.IsPrime]

local notation "S" => MvPolynomial (Fin n) K
local notation "O" => Localization.AtPrime Q
local notation "κ₀" => IsLocalRing.ResidueField O

/-- Factoring the original common scalar by the cone equation gives
a unit of the actual source local ring, without a supplied exponent. -/
theorem source_cone_common_factor_unit_decomposition
    (R g : S) (hR : Irreducible R) (hQ : Q = Ideal.span {R}) (hg : g ≠ 0) :
    ∃ (m : ℕ) (a : S) (u : Oˣ), g = R ^ m * a ∧ algebraMap S O a = (u : O) := by
  obtain ⟨m, a, ha, he⟩ := WfDvdMonoid.max_power_factor hg hR
  have hau : IsUnit (algebraMap S O a) := IsLocalization.map_units (M := Q.primeCompl) O
    ⟨a, by simpa only [Ideal.mem_primeCompl_iff, hQ, Ideal.mem_span_singleton] using ha⟩
  obtain ⟨u, hu⟩ := hau
  exact ⟨m, a, u, he, hu.symm⟩

/-- The actual residue kernel is generated by the actual localized
cone equation, so no residue-kernel presentation is supplied. -/
theorem source_cone_local_residue_kernel
    (R : S) (hQ : Q = Ideal.span {R}) :
    RingHom.ker (algebraMap O κ₀) = Ideal.span {algebraMap S O R} := by
  rw [ResidueField.algebraMap_eq, ker_residue,
    ← Localization.AtPrime.map_eq_maximalIdeal (I := Q)]
  calc
    _ = (Ideal.span {R}).map (algebraMap S O) := congrArg (Ideal.map (algebraMap S O)) hQ
    _ = _ := by rw [Ideal.map_span, Set.image_singleton]

/-- Nilpotence excludes preservation of the original rational
parameter whenever its source and target covectors have the same
nontrivial tangent kernel and the cone tangent space is preserved.
All local arithmetic and the differential transport identity are derived.
The remaining hypotheses are precisely the tangent/ruling geometry. -/
theorem source_cone_nilpotence_obstructs_parameter_preservation
    (R g : S) (hR : Irreducible R) (hQ : Q = Ideal.span {R}) (hg : g ≠ 0)
    (P : Fin n → S) (hN : IsNilpotent (jac (fun i => g * P i)))
    (p q : S) {d : ℕ} (hp : p.IsHomogeneous d) (hq : q.IsHomogeneous d)
    (hq₀ : algebraMap S κ₀ q ≠ 0) (hqP : algebraMap S κ₀ (aeval P q) ≠ 0)
    (hpreserve : R ∣ aeval P p * q - p * aeval P q)
    (hP : mappedPolynomialGradient (algebraMap S κ₀) R ⬝ᵥ
      (fun i => algebraMap S κ₀ (P i)) = 0)
    (hJ : ∀ v : Fin n → κ₀, mappedPolynomialGradient (algebraMap S κ₀) R ⬝ᵥ v = 0 →
      mappedPolynomialGradient (algebraMap S κ₀) R ⬝ᵥ ((jac P).map (algebraMap S κ₀) *ᵥ v) = 0)
    (hb : ∃ v : Fin n → κ₀, mappedPolynomialGradient (algebraMap S κ₀) R ⬝ᵥ v = 0 ∧
      polynomialRatioCovector (algebraMap S κ₀) p q ⬝ᵥ v ≠ 0)
    (hker : ∀ v : Fin n → κ₀, mappedPolynomialGradient (algebraMap S κ₀) R ⬝ᵥ v = 0 →
      (polynomialRatioCovector (algebraMap S κ₀) p q ⬝ᵥ v = 0 ↔
        polynomialRatioCovector ((algebraMap S κ₀).comp (aeval P).toRingHom) p q ⬝ᵥ v = 0)) :
    False := by
  let F := FractionRing S
  let : Algebra O F := primeLocalizationFractionAlgebra Q
  let : IsScalarTower S O F := primeLocalizationFraction_scalarTower Q
  let : IsFractionRing O F := primeLocalizationFraction_isFractionRing Q
  have he (z : S) : algebraMap O κ₀ (algebraMap S O z) = algebraMap S κ₀ z :=
    (IsScalarTower.algebraMap_apply S O κ₀ z).symm
  have heF (z : S) : algebraMap O F (algebraMap S O z) = algebraMap S F z :=
    (IsScalarTower.algebraMap_apply S O F z).symm
  obtain ⟨m, a, u, hgfac, hu⟩ := source_cone_common_factor_unit_decomposition Q R g hR hQ hg
  have hRfield : algebraMap S F R ≠ 0 := fun hz =>
    hR.ne_zero (IsFractionRing.injective S F (by simpa only [map_zero] using hz))
  have hnil := simplePoleMatrix_isNilpotent_of_polynomial_jacobian R a m P u hu hRfield
    (by simpa only [← hgfac] using hN)
  have hπκ := source_cone_local_residue_kernel Q R hQ
  have hRres : algebraMap S κ₀ R = 0 := by
    rw [← he]
    apply RingHom.mem_ker.mp
    rw [hπκ]
    exact Ideal.subset_span (Set.mem_singleton _)
  have hJmap : ((jac P).map (algebraMap S O)).map (algebraMap O κ₀) =
      (jac P).map (algebraMap S κ₀) := by
    ext i j
    exact he _
  obtain ⟨γ, _hγ, hproportional⟩ := covectors_same_tangent_kernel_proportional
    (mappedPolynomialGradient (algebraMap S κ₀) R)
    (polynomialRatioCovector (algebraMap S κ₀) p q)
    (polynomialRatioCovector ((algebraMap S κ₀).comp (aeval P).toRingHom) p q) hb hker
  apply simplePoleMatrix_not_isNilpotent_of_covector_transport
    (IsFractionRing.injective O F) (IsLocalRing.residue_surjective (R := O))
    (algebraMap S O R) (m : O) ((jac P).map (algebraMap S O))
    (fun i => algebraMap S O (P i)) (fun j => algebraMap S O (pderiv j R))
    (fun j => algebraMap S O (pderiv j a) * (↑u⁻¹ : O))
    (by rwa [heF]) hπκ
    (by
      simp only [residueLatticeCoordinateMap, LinearMap.coe_mk, AddHom.coe_mk, he]
      exact hP)
    (by simp only [hJmap, he]; exact hJ)
    (polynomialRatioCovector (algebraMap S κ₀) p q)
    (polynomialRatioCovector ((algebraMap S κ₀).comp (aeval P).toRingHom) p q)
    (by
      have hrad := polynomialRatioCovector_radial_eq_zero
        ((algebraMap S κ₀).comp (aeval P).toRingHom) p q hp hq
      simpa only [residueLatticeCoordinateMap, LinearMap.coe_mk, AddHom.coe_mk,
        he, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, aeval_X] using hrad)
    (by simp only [he]; exact hb) γ
    (by simp only [he]; exact hproportional)
    (by
      rw [hJmap]
      intro v hv
      exact polynomial_ratio_preservation_implies_tangent_transport (algebraMap S κ₀)
        P R p q hRres hq₀ hqP hpreserve v (by simp only [he] at hv; exact hv)) hnil

end DimensionFourDependence
