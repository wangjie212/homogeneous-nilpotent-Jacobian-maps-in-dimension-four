import DimensionFourDependence.ImageRelationHeight
import DimensionFourDependence.HomogenizedDivisorLift
import DimensionFourDependence.ProjectiveCone

/-! # Principal equations for two-coordinate projective closures

One transcendental affine coordinate makes the two-coordinate relation
prime have height at most one, so it is principal, including the zero
ideal. Homogenizing its entire generator gives the entire projective
closure ideal. This retains all relations rather than just their zeros.
-/

namespace DimensionFourDependence

open MvPolynomial

variable {L F sigma : Type*} [Field L] [Field F] [Algebra L F]

/-- Adjoining one coordinate to any algebraically independent family
gives a relation prime of height at most one. -/
theorem independent_family_extra_coordinate_relation_height_le_one
    (x : sigma → F) (y : F) (hx : AlgebraicIndependent L x) :
    (RingHom.ker (aeval (fun j : Option sigma => j.elim y x) :
      MvPolynomial (Option sigma) L →ₐ[L] F)).height ≤ 1 := by
  let E := optionEquivLeft L sigma
  let f : Polynomial (MvPolynomial sigma L) →+* F := Polynomial.eval₂RingHom (aeval x).toRingHom y
  let P := RingHom.ker f
  have : P.IsPrime := RingHom.ker_isPrime f
  have hcoeff : P.comap Polynomial.C = ⊥ := by
    ext Q
    change f (Polynomial.C Q) = 0 ↔ Q = 0
    simpa [f] using (show aeval x Q = 0 ↔ Q = 0 from
      ⟨fun hQ => hx (by simpa using hQ), fun hQ => by rw [hQ, map_zero]⟩)
  have heval : f.comp E.toRingHom =
      (aeval (fun j : Option sigma => j.elim y x)).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro a; simp [f, E]
    · intro j; cases j <;> simp [f, E]
  have hker : RingHom.ker (aeval (fun j : Option sigma => j.elim y x) :
      MvPolynomial (Option sigma) L →ₐ[L] F) = P.comap E.toRingHom := by
    ext Q
    change aeval (fun j : Option sigma => j.elim y x) Q = 0 ↔ f (E Q) = 0
    have he := RingHom.congr_fun heval Q
    change f (E Q) = aeval (fun j : Option sigma => j.elim y x) Q at he
    rw [he]
  rw [hker]
  calc
    _ = P.height := E.toRingEquiv.height_comap P
    _ ≤ 1 := polynomial_prime_height_le_one_of_coefficient_comap P hcoeff

/-- A prime of height at most one in a unique factorization domain
has one generator, allowing zero for the zero prime. -/
theorem prime_height_le_one_exists_generator {R : Type*} [CommRing R] [IsDomain R]
    [UniqueFactorizationMonoid R] (I : Ideal R) [I.IsPrime] (hheight : I.height ≤ 1) :
    ∃ P : R, I = Ideal.span {P} := by
  rcases Order.le_one_iff.mp hheight with h0 | h1
  · refine ⟨0, ?_⟩
    rw [Ideal.height_eq_zero_iff_eq_bot.mp h0, Ideal.span_singleton_zero]
  · obtain ⟨P, hP⟩ := UniqueFactorizationMonoid.isPrincipal_of_height_eq_one h1
    exact ⟨P, hP⟩

/-- The entire projective closure ideal of a principal affine
relation ideal is generated by its actual-degree homogenization. -/
theorem projectiveConeIdeal_eq_homogenized_affine_generator
    (x : sigma → F) (P : MvPolynomial sigma L)
    (hker : RingHom.ker (aeval x : MvPolynomial sigma L →ₐ[L] F) = Ideal.span {P}) :
    projectiveConeIdeal (L := L) x = Ideal.span {projectiveHomogenize P P.totalDegree} := by
  apply le_antisymm
  · intro Q hQ
    rw [← sum_homogeneousComponent Q]
    apply Ideal.sum_mem
    intro d _
    apply Ideal.mem_span_singleton.mpr
    apply homogenized_chart_divisor_dvd_homogeneous _ (homogeneousComponent_isHomogeneous d Q) P
    apply Ideal.mem_span_singleton.mp
    rw [← hker]
    change aeval x (projectiveDehomogenize (homogeneousComponent d Q)) = 0
    rw [← aeval_projectiveDehomogenize]
    exact (projectiveConeIdeal_mem_of_isHomogeneous x (homogeneousComponent_isHomogeneous d Q)).mp
      (projectiveConeIdeal_homogeneousComponent_mem x hQ d)
  · apply Ideal.span_le.mpr
    rintro _ rfl
    apply (projectiveConeIdeal_mem_of_isHomogeneous x
      (projectiveHomogenize_isHomogeneous P P.totalDegree le_rfl)).mpr
    rw [aeval_projectiveDehomogenize, projectiveDehomogenize_homogenize]
    have hP : P ∈ RingHom.ker (aeval x : MvPolynomial sigma L →ₐ[L] F) := by
      rw [hker]
      exact Ideal.subset_span (by simp)
    exact hP

/-- A pair containing a transcendental coordinate has an actual
principal affine relation ideal. -/
theorem two_coordinate_relation_exists_generator (t y : F) (ht : Transcendental L t) :
    ∃ P : MvPolynomial (Option Unit) L,
      RingHom.ker (aeval (fun j : Option Unit => j.elim y (fun _ => t)) :
        MvPolynomial (Option Unit) L →ₐ[L] F) = Ideal.span {P} := by
  let : (RingHom.ker (aeval (fun j : Option Unit => j.elim y (fun _ => t)) :
    MvPolynomial (Option Unit) L →ₐ[L] F)).IsPrime := RingHom.ker_isPrime _
  apply prime_height_le_one_exists_generator
  exact independent_family_extra_coordinate_relation_height_le_one (fun _ : Unit => t) y
    (algebraicIndependent_unique_type_iff.mpr ht)

/-- The corresponding entire plane projective closure has a
homogeneous generator constructed from the actual affine relations. -/
theorem two_coordinate_projective_closure_exists_homogeneous_generator
    (t y : F) (ht : Transcendental L t) :
    ∃ (P : MvPolynomial (Option (Option Unit)) L) (d : ℕ), P.IsHomogeneous d ∧
      projectiveConeIdeal (L := L) (fun j : Option Unit => j.elim y (fun _ => t)) = Ideal.span {P} := by
  obtain ⟨Q, hQ⟩ := two_coordinate_relation_exists_generator t y ht
  exact ⟨projectiveHomogenize Q Q.totalDegree, Q.totalDegree,
    projectiveHomogenize_isHomogeneous Q Q.totalDegree le_rfl,
    projectiveConeIdeal_eq_homogenized_affine_generator _ Q hQ⟩

end DimensionFourDependence
