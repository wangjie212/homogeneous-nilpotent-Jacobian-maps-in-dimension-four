import DimensionFourDependence.GraphLineChart
import DimensionFourDependence.IrreducibleLineFamilies

/-! # The Zariski topology and incidence condition in a line chart

The matrix chart carries the topology generated by polynomial nonvanishing.
Skewness is open and incidence is closed, by the actual determinant equation.
These properties pass to every subfamily with the induced topology.
-/

namespace DimensionFourDependence

open MvPolynomial Matrix

variable {F : Type*} [Field F]

/-- Evaluate a polynomial in the four matrix entries of a line chart. -/
noncomputable def lineChartPolynomialValue (B : Matrix (Fin 2) (Fin 2) F)
    (P : MvPolynomial (Fin 2 × Fin 2) F) : F := aeval (fun ij => B ij.1 ij.2) P

/-- The usual polynomial Zariski topology on the four-dimensional matrix chart.
It is explicit rather than a global instance on matrix/function types. -/
@[instance_reducible] def graphLineChartTopology (F : Type*) [Field F] : TopologicalSpace (Matrix (Fin 2) (Fin 2) F) :=
  TopologicalSpace.generateFrom {U | ∃ P : MvPolynomial (Fin 2 × Fin 2) F,
    U = {B | lineChartPolynomialValue B P ≠ 0}}

/-- Principal polynomial nonvanishing sets are open in the chart. -/
theorem lineChart_principal_isOpen (P : MvPolynomial (Fin 2 × Fin 2) F) :
    @IsOpen _ (graphLineChartTopology F) {B | lineChartPolynomialValue B P ≠ 0} := by
  exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨P, rfl⟩

/-- A single polynomial zero set is closed in the chart. -/
theorem lineChart_polynomial_zero_isClosed (P : MvPolynomial (Fin 2 × Fin 2) F) :
    @IsClosed _ (graphLineChartTopology F) {B | lineChartPolynomialValue B P = 0} := by
  let : TopologicalSpace (Matrix (Fin 2) (Fin 2) F) := graphLineChartTopology F
  simpa only [Set.compl_ofPred, not_not] using (lineChart_principal_isOpen P).isClosed_compl

/-- Simultaneous polynomial equations define a closed subfamily. -/
theorem lineChart_equations_isClosed (S : Set (MvPolynomial (Fin 2 × Fin 2) F)) :
    @IsClosed _ (graphLineChartTopology F) {B | ∀ P ∈ S, lineChartPolynomialValue B P = 0} := by
  let : TopologicalSpace (Matrix (Fin 2) (Fin 2) F) := graphLineChartTopology F
  simp only [Set.ofPred_forall]
  exact isClosed_iInter (fun P => isClosed_iInter (fun _ => lineChart_polynomial_zero_isClosed P))

/-- The incidence determinant with one fixed line. -/
noncomputable def graphSkewPolynomial (B : Matrix (Fin 2) (Fin 2) F) :
    MvPolynomial (Fin 2 × Fin 2) F :=
  (C (B 0 0) - X (0, 0)) * (C (B 1 1) - X (1, 1)) -
    (C (B 0 1) - X (0, 1)) * (C (B 1 0) - X (1, 0))

/-- The incidence polynomial evaluates to the determinant of the matrix difference. -/
theorem graphSkewPolynomial_eval (B D : Matrix (Fin 2) (Fin 2) F) :
    lineChartPolynomialValue D (graphSkewPolynomial B) = (B - D).det := by
  simp [lineChartPolynomialValue, graphSkewPolynomial, Matrix.det_fin_two]

/-- Skewness with a fixed line is open, with no openness hypothesis left to assume. -/
theorem graphLineChart_skew_isOpen (B : Matrix (Fin 2) (Fin 2) F) :
    @IsOpen _ (graphLineChartTopology F) {D | Disjoint (graphLineFour B) (graphLineFour D)} := by
  simpa only [graphSkewPolynomial_eval, graphLineFour_disjoint_iff_det] using
    lineChart_principal_isOpen (graphSkewPolynomial B)

/-- Incidence with a fixed line is closed in the matrix chart. -/
theorem graphLineChart_incidence_isClosed (B : Matrix (Fin 2) (Fin 2) F) :
    @IsClosed _ (graphLineChartTopology F) {D | ¬ Disjoint (graphLineFour B) (graphLineFour D)} := by
  let : TopologicalSpace (Matrix (Fin 2) (Fin 2) F) := graphLineChartTopology F
  simpa only [Set.compl_ofPred] using (graphLineChart_skew_isOpen B).isClosed_compl

/-- The open-skewness property restricts to every actual chart subfamily. -/
theorem graphLineChart_subfamily_skew_isOpen
    (S : Set (Matrix (Fin 2) (Fin 2) F)) (B : S) :
    letI := graphLineChartTopology F
    IsOpen {D : S | Disjoint (graphLineFour B.val) (graphLineFour D.val)} := by
  let : TopologicalSpace (Matrix (Fin 2) (Fin 2) F) := graphLineChartTopology F
  exact (graphLineChart_skew_isOpen B.val).preimage continuous_subtype_val

/-- Irreducible chart subfamilies which are neither coplanar nor concurrent
have three pairwise skew lines on every nonempty open chart. Openness of skewness
is now proved from its determinant equation, rather than supplied as a hypothesis. -/
theorem lineChart_irreducible_subfamily_skew_triple
    (S : Set (Matrix (Fin 2) (Fin 2) F)) :
    letI := graphLineChartTopology F
    PreirreducibleSpace S →
    (¬ ∃ P : Submodule F (Fin 4 → F), Module.finrank F P ≤ 3 ∧
      ∀ B : S, graphLineFour B.val ≤ P) →
    (¬ ∃ T : Submodule F (Fin 4 → F), Module.finrank F T = 1 ∧
      ∀ B : S, T ≤ graphLineFour B.val) →
    ∀ (O : Set S), IsOpen O → O.Nonempty →
      ∃ a ∈ O, ∃ b ∈ O, ∃ c ∈ O,
        Disjoint (graphLineFour a.val) (graphLineFour b.val) ∧
        Disjoint (graphLineFour a.val) (graphLineFour c.val) ∧
        Disjoint (graphLineFour b.val) (graphLineFour c.val) := by
  let : TopologicalSpace (Matrix (Fin 2) (Fin 2) F) := graphLineChartTopology F
  intro hirr hplane hpoint O hO hOne
  let : PreirreducibleSpace S := hirr
  exact noncoplanar_nonconcurrent_irreducible_family_skew_triple
    (fun B : S => graphLineFour B.val) (fun B => graphLineFour_finrank B.val)
    (fun B => graphLineChart_subfamily_skew_isOpen S B) hplane hpoint O hO hOne

end DimensionFourDependence
