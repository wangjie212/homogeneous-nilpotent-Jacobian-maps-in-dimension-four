import DimensionFourDependence.PolynomialProjectiveBase
import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
import Mathlib.RingTheory.MvPolynomial.Ideal

/-! # The actual projective-space morphism for coefficient extension

Mapping the coefficients preserves the grading and all original source
coordinates. Its positive-degree image generates the target irrelevant
ideal, so Mathlib's Proj functor defines the original-source morphism.
-/

namespace DimensionFourDependence

open MvPolynomial AlgebraicGeometry HomogeneousIdeal

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {C E : Type u} [CommRing C] [CommRing E] (f : C →+* E)

/-- The coefficient map preserves the actual polynomial grading. -/
noncomputable def polynomialCoefficientGradedHom :
    homogeneousSubmodule (Fin 4) C →+*ᵍ homogeneousSubmodule (Fin 4) E where
  toRingHom := MvPolynomial.map f
  map_mem := fun h => h.map f

/-- Every positive-degree target polynomial is generated by the
original source coordinates, which are all images of the same variables. -/
theorem polynomialCoefficientGradedHom_irrelevant_le :
    irrelevant (homogeneousSubmodule (Fin 4) E) ≤
      (irrelevant (homogeneousSubmodule (Fin 4) C)).map (polynomialCoefficientGradedHom f) := by
  apply (HomogeneousIdeal.irrelevant_le _).mpr
  intro i hi P hP
  have hgen : idealOfVars (Fin 4) E ≤
      ((irrelevant (homogeneousSubmodule (Fin 4) C)).map
        (polynomialCoefficientGradedHom f)).toIdeal := by
    apply Ideal.span_le.mpr
    rintro _ ⟨a, rfl⟩
    have ha : X a ∈ irrelevant (homogeneousSubmodule (Fin 4) C) :=
      HomogeneousIdeal.mem_irrelevant_of_mem _ (by omega) (isHomogeneous_X (R := C) a)
    change X a ∈ (irrelevant (homogeneousSubmodule (Fin 4) C)).toIdeal.map (MvPolynomial.map f)
    simpa only [MvPolynomial.map_X] using Ideal.mem_map_of_mem (MvPolynomial.map f) ha
  apply hgen
  rw [← pow_one (idealOfVars (Fin 4) E)]
  apply (mem_pow_idealOfVars_iff 1 P).mpr
  intro m hm
  have hd : m.degree = i := by
    simpa only [Finsupp.degree_eq_weight_one, Pi.one_def] using hP (mem_support_iff.mp hm)
  omega

/-- The actual morphism from projective space over the extended
coefficients to projective space in the same original coordinates. -/
noncomputable def polynomialProjectiveCoefficientMap :
    AlgebraicGeometry.Proj (homogeneousSubmodule (Fin 4) E) ⟶
      AlgebraicGeometry.Proj (homogeneousSubmodule (Fin 4) C) :=
  Proj.map (polynomialCoefficientGradedHom f) (polynomialCoefficientGradedHom_irrelevant_le f)

/-- Original source coordinate charts pull back to the exact same
coordinate charts over the new field. -/
theorem polynomialProjectiveCoefficientMap_preimage_basicOpen (a : Fin 4) :
    polynomialProjectiveCoefficientMap f ⁻¹ᵁ
        Proj.basicOpen (homogeneousSubmodule (Fin 4) C) (X a) =
      Proj.basicOpen (homogeneousSubmodule (Fin 4) E) (X a) := by
  change Proj.map (polynomialCoefficientGradedHom f) _ ⁻¹ᵁ _ = _
  rw [Proj.map_preimage_basicOpen]
  change Proj.basicOpen (homogeneousSubmodule (Fin 4) E) (MvPolynomial.map f (X a)) = _
  rw [MvPolynomial.map_X]

end DimensionFourDependence
