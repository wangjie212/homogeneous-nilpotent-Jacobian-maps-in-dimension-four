import DimensionFourDependence.PolynomialParameterRegularity
import DimensionFourDependence.RationalClosedGaussCover

/-! # A primitive actual polynomial parameter cannot be a nonlinear composite

A rational section of a nonconstant polynomial map gives a polynomial
cross identity. Its degree says deg(F) divides one. Relative algebraic
closedness produces precisely that rational section: the inner coordinate
is algebraic over the actual field generated by its nonconstant polynomial
value, so already lies in that field.
-/

namespace DimensionFourDependence

open Polynomial

set_option maxHeartbeats 3000000
set_option synthInstance.maxHeartbeats 100000

variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The full polynomial cross identity of a rational inverse forces the
original polynomial degree to be exactly one. -/
theorem polynomial_rational_section_cross_identity_degree_one
    (p n d : Polynomial K) (hd : d.comp p ≠ 0)
    (hcross : Polynomial.X * d.comp p = n.comp p) : p.natDegree = 1 := by
  have he := congrArg Polynomial.natDegree hcross
  rw [natDegree_mul Polynomial.X_ne_zero hd, natDegree_X, natDegree_comp, natDegree_comp] at he
  have hdiv : p.natDegree ∣ 1 := by
    have hadd : p.natDegree ∣ 1 + d.natDegree * p.natDegree := by
      rw [he]
      exact dvd_mul_left _ _
    have hterm : p.natDegree ∣ d.natDegree * p.natDegree := dvd_mul_left _ _
    exact (Nat.dvd_add_iff_right hterm).mpr (by simpa only [Nat.add_comm] using hadd)
  exact Nat.dvd_one.mp hdiv

/-- A transcendental actual polynomial parameter generating a relatively
closed source subfield has polynomial degree exactly one in every
nonconstant inner coordinate representing it. -/
theorem relatively_closed_polynomial_parameter_composite_degree_one
    (t x : L) (ht : Transcendental K t) (p : Polynomial K) (hp : 0 < p.natDegree)
    (hvalue : t = Polynomial.aeval x p)
    (hclosed : algebraicClosure (IntermediateField.adjoin K {t}) L = ⊥) : p.natDegree = 1 := by
  let J := IntermediateField.adjoin K ({t} : Set L)
  let tJ : J := ⟨t, IntermediateField.subset_adjoin K _ rfl⟩
  have hintegral : IsIntegral J x := parameter_isIntegral_of_nonconstant_polynomial_value
    (L := K) (R := J) p hp x tJ hvalue.symm
  have hmem : x ∈ algebraicClosure J L := mem_algebraicClosure_iff.mpr hintegral.isAlgebraic
  rw [hclosed] at hmem
  obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hmem
  have hxmem : x ∈ J := by
    rw [← hc]
    exact c.property
  have hx : Transcendental K x := (transcendental_aeval_iff.mp (hvalue ▸ ht)).1
  have hx0 : x ≠ 0 := by
    intro hz
    apply hx
    rw [hz]
    simpa only [map_zero] using isAlgebraic_algebraMap (R := K) (A := L) (0 : K)
  obtain ⟨n, d, hquot⟩ := (IntermediateField.mem_adjoin_simple_iff K x).mp hxmem
  have hden : Polynomial.aeval t d ≠ 0 := by
    intro hz
    apply hx0
    rw [hquot, hz, div_zero]
  have hcomp (q : Polynomial K) : Polynomial.aeval x (q.comp p) = Polynomial.aeval t q := by
    rw [Polynomial.aeval_comp, ← hvalue]
  have hd : d.comp p ≠ 0 := by
    intro hz
    apply hden
    rw [← hcomp d, hz, map_zero]
  have hcross : Polynomial.X * d.comp p = n.comp p := by
    apply transcendental_iff_injective.mp hx
    rw [map_mul, Polynomial.aeval_X, hcomp d, hcomp n]
    exact (eq_div_iff hden).mp hquot
  exact polynomial_rational_section_cross_identity_degree_one p n d hd hcross

/-- The complete affine coefficients and nonzero slope of the primitive
polynomial composite are recovered from its original polynomial. -/
theorem relatively_closed_polynomial_parameter_constructs_affine_form
    (t x : L) (ht : Transcendental K t) (p : Polynomial K) (hp : 0 < p.natDegree)
    (hvalue : t = Polynomial.aeval x p)
    (hclosed : algebraicClosure (IntermediateField.adjoin K {t}) L = ⊥) :
    ∃ a b : K, a ≠ 0 ∧ p = Polynomial.C a * Polynomial.X + Polynomial.C b := by
  have hd := relatively_closed_polynomial_parameter_composite_degree_one t x ht p hp hvalue hclosed
  have hp0 : p ≠ 0 := by intro hz; simp [hz] at hp
  have ha : p.coeff 1 ≠ 0 := by
    rw [← hd, Polynomial.coeff_natDegree]
    exact Polynomial.leadingCoeff_ne_zero.mpr hp0
  exact ⟨p.coeff 1, p.coeff 0, ha, Polynomial.eq_X_add_C_of_natDegree_le_one hd.le⟩

end DimensionFourDependence
