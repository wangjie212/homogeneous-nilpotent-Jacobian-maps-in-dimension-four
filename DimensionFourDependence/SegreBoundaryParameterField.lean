import DimensionFourDependence.SegreBoundaryRulingAlgebraicity

/-! # The actual boundary ruling field is exactly the field generated by its parameter -/

namespace DimensionFourDependence

attribute [local instance] coefficientFieldScalarTower

universe u
variable {K : Type u} [Field K] [CharZero K]
local notation "S₀" => FractionRing (MvPolynomial (Fin 4) K)

/-- The actual source-field embedding used in the algebraicity theorem
has exactly `K(t)` as its image in the boundary extension. -/
theorem segreBoundaryRulingField_eq_adjoin_parameter
    (Y : Fin 3 → S₀) (hY : AlgebraicIndependent K Y) (j : Fin 3) (hj : j ≠ 0)
    (κ : Type u) [Field κ] [Algebra (coefficientField (K := K) Y) κ]
    [Algebra K κ] [IsScalarTower K (coefficientField (K := K) Y) κ] :
    segreBoundaryRulingField Y hY j hj κ = IntermediateField.adjoin K
      {algebraMap (coefficientField (K := K) Y) κ (segreCoefficientRulingParameter Y j)} := by
  let S := segreSourceRulingParameterHom Y hY j hj
  let f : S.fieldRange →ₐ[K] κ :=
    (IsScalarTower.toAlgHom K (coefficientField (K := K) Y) κ).comp (segreRulingFieldCoefficientHom Y hY j hj)
  let g : RatFunc K →ₐ[K] κ := f.comp S.equivFieldRange.toAlgHom
  have hg : g.fieldRange = f.fieldRange := by
    ext a
    constructor
    · rintro ⟨r, rfl⟩
      exact ⟨S.equivFieldRange r, rfl⟩
    · rintro ⟨m, rfl⟩
      refine ⟨S.equivFieldRange.symm m, ?_⟩
      change f (S.equivFieldRange (S.equivFieldRange.symm m)) = f m
      rw [AlgEquiv.apply_symm_apply]
  have hv : g RatFunc.X = algebraMap (coefficientField (K := K) Y) κ (segreCoefficientRulingParameter Y j) := by
    change algebraMap (coefficientField (K := K) Y) κ
      (segreRulingFieldCoefficientHom Y hY j hj (segreRulingFieldParameter Y hY j hj)) = _
    rw [segreRulingFieldCoefficientHom_parameter]
  change f.fieldRange = _
  rw [← hg, rational_function_algHom_fieldRange_eq_adjoin_parameter, hv]

/-- The boundary ruling parameter retains transcendence degree one
over the original constants in every compatible boundary extension. -/
theorem segre_boundary_ruling_field_trdeg_one
    (Y : Fin 3 → S₀) (hY : AlgebraicIndependent K Y) (j : Fin 3) (hj : j ≠ 0)
    (κ : Type u) [Field κ] [Algebra (coefficientField (K := K) Y) κ]
    [Algebra K κ] [IsScalarTower K (coefficientField (K := K) Y) κ] :
    Algebra.trdeg K (segreBoundaryRulingField Y hY j hj κ) = 1 := by
  rw [segreBoundaryRulingField_eq_adjoin_parameter]
  apply generatedField_singleton_trdeg_one_of_transcendental
  intro he
  apply segre_coefficient_ruling_parameter_transcendental Y hY j hj
  exact (isAlgebraic_algHom_iff (IsScalarTower.toAlgHom K (coefficientField (K := K) Y) κ)
    (IsScalarTower.toAlgHom K (coefficientField (K := K) Y) κ).injective).mp he

end DimensionFourDependence
