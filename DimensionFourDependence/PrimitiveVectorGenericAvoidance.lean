import DimensionFourDependence.CoprimeBaseGenericAvoidance

/-! # A nonzero primitive direction cannot vanish where three outputs are independent -/

namespace DimensionFourDependence

open MvPolynomial

universe u
set_option maxHeartbeats 2500000
set_option synthInstance.maxHeartbeats 100000

variable {K A : Type u} [Field K] [CommRing A] [IsDomain A] [Algebra K A]
    [Algebra.FiniteType K A] [UniqueFactorizationMonoid A]

/-- In an actual four-dimensional factorial affine domain, a nonzero
prime with residue dimension at least three is generated by an actual
prime element. The two strict dimension drops are checked internally. -/
theorem nonzero_prime_residue_trdeg_ge_three_constructs_prime_equation
    (hA : Algebra.trdeg K A = 4) (P : Ideal A) [P.IsPrime] (hPne : P ≠ ⊥)
    (hge : 3 ≤ Algebra.trdeg K (A ⧸ P)) : ∃ δ : A, Prime δ ∧ P = Ideal.span {δ} := by
  classical
  let : IsNoetherianRing A := Algebra.FiniteType.isNoetherianRing K A
  obtain ⟨δ, hδP, hδprime⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot
    (inferInstance : P.IsPrime) hPne
  let Q : Ideal A := Ideal.span {δ}
  let : Q.IsPrime := Ideal.isPrime_span_singleton_of_prime hδprime
  have hQP : Q ≤ P := Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hδP)
  have hQne : Q ≠ ⊥ := by
    intro he
    exact hδprime.ne_zero (Ideal.mem_bot.mp
      (he ▸ (Ideal.subset_span (Set.mem_singleton δ))))
  have hlt : Algebra.trdeg K (A ⧸ Q) < 4 :=
    (prime_quotient_trdeg_lt (K' := K) Q hQne
      (trdeg_lt_aleph0_of_finiteType (R := K) (S := A))).trans_eq hA
  have hle : Algebra.trdeg K (A ⧸ Q) ≤ 3 :=
    (Cardinal.lt_natCast_add_one_iff (n := 3)).mp (by convert hlt using 1; norm_num)
  let g := Ideal.Quotient.factorₐ K hQP
  have hgs : Function.Surjective g := Ideal.Quotient.factor_surjective hQP
  have hPQ : Algebra.trdeg K (A ⧸ P) ≤ Algebra.trdeg K (A ⧸ Q) := trdeg_le_of_surjective g hgs
  have heq : Algebra.trdeg K (A ⧸ Q) = Algebra.trdeg K (A ⧸ P) := le_antisymm (hle.trans hge) hPQ
  have hginj := surjective_algHom_injective_of_trdeg_eq g hgs
    (trdeg_lt_aleph0_of_finiteType (R := K) (S := A ⧸ Q)) heq
  have hPQ' : P ≤ Q := by
    intro a ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    apply hginj
    exact (Ideal.Quotient.eq_zero_iff_mem.mpr ha).trans (map_zero g).symm
  exact ⟨δ, hδprime, le_antisymm hPQ' hQP⟩

variable {K : Type u} [Field K]
local notation "R₀" => MvPolynomial (Fin 4) K

/-- A prime containing a nonzero primitive polynomial vector has
residue transcendence degree below three. -/
theorem primitive_nonzero_vector_common_zero_prime_trdeg_lt_three
    (u : Fin 4 → R₀) (hu : u ≠ 0) (hprim : IsPrimitiveVec u)
    (P : Ideal R₀) [P.IsPrime] (hall : ∀ i, u i ∈ P) :
    Algebra.trdeg K (R₀ ⧸ P) < 3 := by
  by_contra hlt
  have hPne : P ≠ ⊥ := by
    intro hz
    apply hu
    funext i
    simpa only [hz, Ideal.mem_bot, Pi.zero_apply] using hall i
  obtain ⟨δ, hδ, hP⟩ := nonzero_prime_residue_trdeg_ge_three_constructs_prime_equation
    (K := K) (A := R₀) (by simp) P hPne (le_of_not_gt hlt)
  apply hδ.not_isUnit
  apply hprim δ
  intro i
  exact Ideal.mem_span_singleton.mp (hP ▸ hall i)

variable {E : Type*} [Field E] [Algebra K E]

/-- Three actual independent polynomial output values prevent a zero
of every original nonzero primitive polynomial vector at that point. -/
theorem three_independent_polynomial_values_avoid_primitive_vector_zero
    (z : Fin 4 → E) (H : Fin 3 → R₀)
    (hH : AlgebraicIndependent K (fun i => aeval z (H i)))
    (u : Fin 4 → R₀) (hu : u ≠ 0) (hprim : IsPrimitiveVec u) :
    (fun i => aeval z (u i)) ≠ 0 := by
  intro hz
  let I := RingHom.ker (aeval z : R₀ →ₐ[K] E)
  let : I.IsPrime := RingHom.ker_isPrime _
  let f : (R₀ ⧸ I) →ₐ[K] E := Ideal.kerLiftAlg (aeval z : R₀ →ₐ[K] E)
  let w : Fin 3 → (R₀ ⧸ I) := fun i => Ideal.Quotient.mk I (H i)
  have hind : AlgebraicIndependent K w := by
    apply AlgebraicIndependent.of_comp f
    have he : f ∘ w = fun i => aeval z (H i) := by
      funext i
      exact Ideal.kerLiftAlg_mk (aeval z : R₀ →ₐ[K] E) (H i)
    rwa [he]
  have hge : 3 ≤ Algebra.trdeg K (R₀ ⧸ I) := by simpa using hind.lift_cardinalMk_le_trdeg
  have hlt := primitive_nonzero_vector_common_zero_prime_trdeg_lt_three u hu hprim I
    (fun i => congrFun hz i)
  exact not_le_of_gt hlt hge

end DimensionFourDependence
