import DimensionFourDependence.RationalClosedGaussCover

/-! # An algebraic coefficient field is controlled by its rational parameter -/

namespace DimensionFourDependence

variable {K P E L : Type*} [Field K] [Field P] [Field E] [Field L]
  [Algebra K P] [Algebra K L]

/-- A rational-function embedding has exactly the intermediate field
generated by the image of its original parameter. -/
theorem rational_parameter_hom_fieldRange (f : RatFunc K →ₐ[K] L) :
    IntermediateField.adjoin K {f RatFunc.X} = f.fieldRange := by
  have h := congrArg (IntermediateField.map f) (RatFunc.adjoin_X (K := K))
  rwa [IntermediateField.adjoin_map, Set.image_singleton, ← AlgHom.fieldRange_eq_map] at h

/-- A field containing the image of a rational parameter contains the
whole rational coefficient field. -/
theorem rational_parameter_field_image_mem
    (e : RatFunc K ≃ₐ[K] P) (f : P →ₐ[K] L)
    (J : IntermediateField K L) (ht : f (e RatFunc.X) ∈ J) (p : P) : f p ∈ J := by
  have hle : (f.comp e.toAlgHom).fieldRange ≤ J := by
    rw [← rational_parameter_hom_fieldRange]
    exact IntermediateField.adjoin_le_iff.mpr (Set.singleton_subset_iff.mpr ht)
  apply hle
  exact ⟨e.symm p, by simp⟩

variable [Algebra P E] [Algebra.IsAlgebraic P E]

/-- If the full coefficient field is algebraic over a rational curve
field, all its images are algebraic over any intermediate field
containing the image of that curve parameter. This also applies to
finite closed Gauss covers and their further algebraic extensions. -/
theorem rational_parameter_algebraic_coefficient_images
    (e : RatFunc K ≃ₐ[K] P) (f : P →ₐ[K] L) (g : E →+* L)
    (hcomp : f.toRingHom = g.comp (algebraMap P E))
    (J : IntermediateField K L) (ht : f (e RatFunc.X) ∈ J) :
    ∀ c : E, IsAlgebraic J (g c) := by
  let fJ : P →+* J :=
    { toFun := fun p => ⟨f p, rational_parameter_field_image_mem e f J ht p⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' := fun a b => Subtype.ext (map_mul _ a b)
      map_zero' := Subtype.ext (map_zero _)
      map_add' := fun a b => Subtype.ext (map_add _ a b) }
  have hfJ : (algebraMap J L).comp fJ = g.comp (algebraMap P E) := hcomp
  intro c
  exact (Algebra.IsAlgebraic.isAlgebraic (R := P) c).ringHom_of_comp_eq
    fJ g fJ.injective hfJ

end DimensionFourDependence
