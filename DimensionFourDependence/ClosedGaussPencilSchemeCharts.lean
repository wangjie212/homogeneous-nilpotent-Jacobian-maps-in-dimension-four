import DimensionFourDependence.ClosedGaussPencilScheme
import DimensionFourDependence.ProjectiveSourceSchemeChart

/-! # The original Gauss-pencil ratio rings are its global scheme charts

Every original source coordinate gives an actual nonempty affine open
of the constructed global pencil scheme. Its coordinate ring is the
existing subalgebra generated by the original source ratios.
-/

namespace DimensionFourDependence

open MvPolynomial AlgebraicGeometry CategoryTheory

attribute [local instance] MvPolynomial.gradedAlgebra

universe u

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

variable {K : Type u} [Field K] [CharZero K]
  (H : Fin 4 → MvPolynomial (Fin 4) K) {d : ℕ} (hH : IsHomogMap H d)
  (I : ImageRelationWitness H) (e : RatFunc K ≃ₐ[K] closedGaussParameterField H I)

local notation "C₀" => closedGaussParameterField H I
local notation "𝒢" => homogeneousSubmodule (Fin 4) C₀

/-- The actual standard source affine open on the global pencil scheme. -/
noncomputable def closedGaussPencilSchemeChartOpen (a : Fin 4) :
    (closedGaussPencilScheme H hH I e).Opens :=
  closedGaussPencilSchemeInclusion H hH I e ⁻¹ᵁ Proj.basicOpen 𝒢 (X a)

/-- The original generic source point belongs to every standard chart. -/
theorem closedGaussPencilGenericPoint_mem_chart (a : Fin 4) :
    closedGaussPencilProjectiveGenericPoint H hH I e ∈ Proj.basicOpen 𝒢 (X a) := by
  change X a ∉ (closedGaussPencilProjectiveGenericPoint H hH I e).asHomogeneousIdeal
  intro hz
  change aeval (rationalCoordinate (K := K) (n := 4)) (X a) = 0 at hz
  rw [aeval_X] at hz
  apply (IsFractionRing.injective (MvPolynomial (Fin 4) K)
    (FractionRing (MvPolynomial (Fin 4) K))).ne (X_ne_zero a)
  simpa only [rationalCoordinate, map_zero] using hz

/-- Every standard chart of the actual global projective pencil is
the spectrum of the original ratio-generated source ring. -/
noncomputable def closedGaussPencilSchemeChartIso (a : Fin 4) :
    (closedGaussPencilSchemeChartOpen H hH I e a).toScheme ≅
      Spec (CommRingCat.of (projectiveCoordinateChartAlgebra (C := C₀)
        (rationalCoordinate (K := K) (n := 4)) a)) := by
  have ha : rationalCoordinate (K := K) a ≠ 0 := by
    simpa only [rationalCoordinate, map_zero] using
      (IsFractionRing.injective (MvPolynomial (Fin 4) K)
        (FractionRing (MvPolynomial (Fin 4) K))).ne (X_ne_zero a)
  exact projectiveSourceReducedClosureAffineChart (C := C₀)
    (rationalCoordinate (K := K) (n := 4)) a ha
    (closedGaussPencilProjectiveGenericPoint H hH I e) rfl
    (closedGaussPencilGenericPoint_mem_chart H hH I e a)

/-- The original ratio chart is an affine open on the actual scheme. -/
theorem closedGaussPencilSchemeChartOpen_isAffineOpen (a : Fin 4) :
    IsAffineOpen (closedGaussPencilSchemeChartOpen H hH I e a) :=
  IsAffine.of_isIso (closedGaussPencilSchemeChartIso H hH I e a).hom

/-- Each original ratio chart is a nonempty open on the global pencil. -/
theorem closedGaussPencilSchemeChartOpen_nonempty (a : Fin 4) :
    Nonempty (closedGaussPencilSchemeChartOpen H hH I e a) :=
  ⟨(closedGaussPencilSchemeChartIso H hH I e a).inv
    (⊥ : PrimeSpectrum (projectiveCoordinateChartAlgebra (C := C₀)
      (rationalCoordinate (K := K) (n := 4)) a))⟩

/-- The four actual original-coordinate charts cover the global pencil scheme. -/
theorem closedGaussPencilSchemeChartOpen_iSup :
    ⨆ a : Fin 4, closedGaussPencilSchemeChartOpen H hH I e a = ⊤ := by
  have hgen : Algebra.adjoin (𝒢 0) (Set.range (X : Fin 4 → MvPolynomial (Fin 4) C₀)) = ⊤ := by
    let S := Algebra.adjoin (𝒢 0) (Set.range (X : Fin 4 → MvPolynomial (Fin 4) C₀))
    apply top_unique
    intro P hP
    clear hP
    induction P using MvPolynomial.induction_on with
    | C c => exact S.algebraMap_mem ⟨MvPolynomial.C c, isHomogeneous_C (Fin 4) c⟩
    | add P Q hP hQ => exact S.add_mem hP hQ
    | mul_X P i hP => exact S.mul_mem hP (Algebra.subset_adjoin ⟨i, rfl⟩)
  have hcover := Proj.iSup_basicOpen_eq_top' 𝒢 (X : Fin 4 → MvPolynomial (Fin 4) C₀)
    (fun i => ⟨1, isHomogeneous_X (R := C₀) i⟩) hgen
  unfold closedGaussPencilSchemeChartOpen
  rw [← Scheme.Hom.preimage_iSup, hcover, Scheme.Hom.preimage_top]

/-- The actual affine section ring is canonically identified with the
existing original-source ratio algebra. -/
noncomputable def closedGaussPencilSchemeChartSectionEquiv (a : Fin 4) :
    Γ(closedGaussPencilScheme H hH I e, closedGaussPencilSchemeChartOpen H hH I e a) ≃+*
      projectiveCoordinateChartAlgebra (C := C₀) (rationalCoordinate (K := K) (n := 4)) a :=
  ((closedGaussPencilSchemeChartOpen H hH I e a).topIso.symm ≪≫
    (Scheme.Γ.mapIso (closedGaussPencilSchemeChartIso H hH I e a).op).symm ≪≫
    Scheme.ΓSpecIso _).commRingCatIsoToRingEquiv

end DimensionFourDependence
