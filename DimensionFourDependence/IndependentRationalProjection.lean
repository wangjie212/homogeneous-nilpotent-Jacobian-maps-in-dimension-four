import DimensionFourDependence.Defs
import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.RingTheory.Localization.Integral

/-! # Independent projection coordinates remain transcendental over the parameter field

Independence first gives transcendence over the actual polynomial algebra
of the first coordinate. Its polynomial-coordinate equivalence and the
fraction-field criterion then extend this to the specified rational
parameter field, using its exact original coordinate value.
-/

namespace DimensionFourDependence

open MvPolynomial

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 2000000

variable {k L : Type*} [Field k] [Field L] [Algebra k L]

/-- The second of two independent original coordinates is transcendental
over the actual algebra generated by the first coordinate. -/
theorem independent_pair_transcendental_adjoin
    (u w : L) (h : AlgebraicIndependent k ![u, w]) :
    Transcendental (Algebra.adjoin k {u}) w := by
  classical
  let f : Option Unit → Fin 2 := fun i => i.elim 1 (fun _ => 0)
  have hf : Function.Injective f := by
    intro i j hij
    cases i <;> cases j <;> simp_all [f]
  have hind := h.comp f hf
  change AlgebraicIndependent k (fun i => ![u, w] (f i)) at hind
  have hvalues : (fun i => ![u, w] (f i)) =
      (fun i : Option Unit => i.elim w (fun _ => u)) := by
    funext i
    cases i <;> rfl
  rw [hvalues] at hind
  have hs := (AlgebraicIndependent.option_iff (R := k) (x := fun _ : Unit => u) (a := w)).mp hind
  have hrange : Set.range (fun _ : Unit => u) = {u} := by ext z; simp
  have hring : Algebra.adjoin k (Set.range (fun _ : Unit => u)) = Algebra.adjoin k {u} :=
    congrArg (Algebra.adjoin k) hrange
  exact Eq.mp (congrArg (fun S : Subalgebra k L => Transcendental S w) hring) hs.2

variable [Algebra (RatFunc k) L] [IsScalarTower k (RatFunc k) L]

/-- Two independent original coordinates construct transcendence of the
second over the specified rational parameter field whenever its actual
parameter maps to the first coordinate. No vanishing condition on the
second coordinate is required. -/
theorem independent_pair_transcendental_rational_parameter
    (u w : L) (h : AlgebraicIndependent k ![u, w])
    (hX : algebraMap (RatFunc k) L RatFunc.X = u) :
    Transcendental (RatFunc k) w := by
  let : Algebra (Polynomial k) L := (Polynomial.aeval u).toRingHom.toAlgebra
  let : IsScalarTower k (Polynomial k) L := IsScalarTower.of_algebraMap_eq
    (fun c => ((Polynomial.aeval u).commutes c).symm)
  have hpoly : (IsScalarTower.toAlgHom k (RatFunc k) L).comp
      (IsScalarTower.toAlgHom k (Polynomial k) (RatFunc k)) = Polynomial.aeval u := by
    apply Polynomial.algHom_ext
    rw [AlgHom.comp_apply, Polynomial.aeval_X]
    change algebraMap (RatFunc k) L (algebraMap (Polynomial k) (RatFunc k) Polynomial.X) = u
    rw [RatFunc.algebraMap_X, hX]
  let : IsScalarTower (Polynomial k) (RatFunc k) L := IsScalarTower.of_algebraMap_eq
    (fun p => (AlgHom.congr_fun hpoly p).symm)
  have hu : Transcendental k u := by simpa using h.transcendental (0 : Fin 2)
  let A := Algebra.adjoin k {u}
  let e : Polynomial k ≃ₐ[k] A := Polynomial.algEquivOfTranscendental k u hu
  have hcomp : (algebraMap A L).comp e.toRingHom =
      (RingHom.id L).comp (algebraMap (Polynomial k) L) := by
    apply RingHom.ext
    intro p
    change A.val (e p) = Polynomial.aeval u p
    rw [Polynomial.algEquivOfTranscendental_apply, ← Polynomial.aeval_algHom_apply A.val]
    rfl
  have hw : Transcendental (Polynomial k) w :=
    (transcendental_ringHom_iff_of_comp_eq e.toRingEquiv (RingHom.id L) Function.injective_id hcomp).mp
      (independent_pair_transcendental_adjoin u w h)
  intro halg
  exact hw ((IsFractionRing.isAlgebraic_iff (Polynomial k) (RatFunc k) L).mpr halg)

end DimensionFourDependence
