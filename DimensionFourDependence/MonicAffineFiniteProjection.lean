import DimensionFourDependence.Defs

/-! # A monic hypersurface projection is finite on the entire affine chart

The original full-degree equation makes the omitted fiber coordinate
integral over the actual algebra generated by the projection coordinates.
The original affine generation then constructs module finiteness of the
entire original chart over that projection algebra.
-/

namespace DimensionFourDependence

open MvPolynomial

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 2000000

variable {k R A σ : Type*} [Field k] [CommRing R] [CommRing A]
  [Algebra k R] [Algebra k A] [Algebra R A] [IsScalarTower k R A]

/-- A full-degree original equation constructs a monic integral equation
for the fiber coordinate over any actual projection coefficient algebra. -/
theorem fiber_isIntegral_of_full_degree_relation
    (s : σ → R) (f : MvPolynomial (Option σ) k) (hf : f ≠ 0)
    (hfull : f.degreeOf none = f.totalDegree)
    (v : A) (hroot : aeval (fun i => i.elim v (fun j => algebraMap R A (s j))) f = 0) :
    IsIntegral R v := by
  let f' := optionEquivLeft k σ f
  have hf' : f' ≠ 0 := by
    intro h
    exact hf ((optionEquivLeft k σ).injective (by simpa only [map_zero] using h))
  have hfdegree : f'.natDegree = f.totalDegree :=
    (natDegree_optionEquivLeft k f).trans hfull
  have hconstant : f'.leadingCoeff.totalDegree = 0 := by
    have h := totalDegree_coeff_optionEquivLeft_add_le k σ f f.totalDegree le_rfl
    change (f'.coeff f.totalDegree).totalDegree + f.totalDegree ≤ f.totalDegree at h
    rw [← hfdegree, Polynomial.coeff_natDegree] at h
    omega
  let c : k := f'.leadingCoeff.coeff 0
  have hlead : f'.leadingCoeff = C c := totalDegree_eq_zero_iff_eq_C.mp hconstant
  have hc : c ≠ 0 := by
    intro hzero
    apply (Polynomial.leadingCoeff_ne_zero.mpr hf')
    rw [hlead, hzero, map_zero]
  let P₀ := f' * Polynomial.C (C c⁻¹)
  have hP₀ : P₀.Monic := by
    apply Polynomial.monic_mul_C_of_leadingCoeff_mul_eq_one
    rw [hlead, ← C_mul, mul_inv_cancel₀ hc, map_one]
  let P : Polynomial R := P₀.map (aeval s).toRingHom
  refine ⟨P, hP₀.map _, ?_⟩
  have hrawroot : Polynomial.aeval v (f'.map (aeval s).toRingHom) = 0 := by
    let ψ : Polynomial (MvPolynomial σ k) →ₐ[k] A :=
      ((Polynomial.aeval v).restrictScalars k).comp (Polynomial.mapAlgHom (aeval s))
    have hψ : ψ.comp (optionEquivLeft k σ).toAlgHom =
        aeval (fun i => i.elim v (fun j => algebraMap R A (s j))) := by
      apply MvPolynomial.algHom_ext
      intro i
      cases i <;> simp [ψ]
    exact (AlgHom.congr_fun hψ f).trans hroot
  change Polynomial.aeval v ((f' * Polynomial.C (C c⁻¹)).map (aeval s).toRingHom) = 0
  rw [Polynomial.map_mul, map_mul, hrawroot, zero_mul]

/-- The actual projection-coordinate algebra inside the original chart. -/
noncomputable def affineProjectionAlgebra (x : Option σ → A) : Subalgebra k A :=
  Algebra.adjoin k (Set.range (fun i => x (some i)))

omit [CommRing R] [Algebra k R] [Algebra R A] [IsScalarTower k R A] in
/-- A full-degree relation on the original generators makes the entire
original affine chart finite over its actual projection-coordinate algebra.
The integral equation and generation over that algebra are constructed. -/
theorem affine_full_degree_projection_finite
    (x : Option σ → A) (hx : Algebra.adjoin k (Set.range x) = ⊤)
    (f : MvPolynomial (Option σ) k) (hf : f ≠ 0)
    (hfull : f.degreeOf none = f.totalDegree) (hroot : aeval x f = 0) :
    Module.Finite (affineProjectionAlgebra (k := k) x) A := by
  let B := affineProjectionAlgebra (k := k) x
  let s : σ → B := fun i => ⟨x (some i), Algebra.subset_adjoin ⟨i, rfl⟩⟩
  have hcoords : (fun i => i.elim (x none) (fun j => algebraMap B A (s j))) = x := by
    funext i
    cases i <;> rfl
  have hv : IsIntegral B (x none) := fiber_isIntegral_of_full_degree_relation s f hf hfull
    (x none) (by rwa [hcoords])
  let N := Algebra.adjoin B {x none}
  have htop : N = ⊤ := by
    have hle : Algebra.adjoin k (Set.range x) ≤ N.restrictScalars k := by
      apply Algebra.adjoin_le_iff.mpr
      rintro _ ⟨i, rfl⟩
      cases i with
      | none => exact Algebra.subset_adjoin (Set.mem_singleton (x none))
      | some i => exact N.algebraMap_mem (s i)
    apply top_unique
    intro a _
    apply hle
    rw [hx]
    trivial
  let : Module.Finite B N := Algebra.finite_adjoin_simple_of_isIntegral hv
  apply Module.Finite.of_surjective N.val.toLinearMap
  intro a
  have ha : a ∈ N := by rw [htop]; trivial
  exact ⟨⟨a, ha⟩, rfl⟩

end DimensionFourDependence
