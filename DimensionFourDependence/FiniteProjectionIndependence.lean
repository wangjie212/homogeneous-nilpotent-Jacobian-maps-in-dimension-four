import DimensionFourDependence.MonicAffineFiniteProjection

/-! # Finite surface projections supply independent actual base coordinates

The projection-coordinate algebra is generated by its specified original
coordinate elements. Finiteness preserves the original transcendence
degree. In dimension two its two generating coordinates are consequently
a transcendence basis, without an independence hypothesis.
-/

namespace DimensionFourDependence

universe u

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 1000000

variable {k A : Type u} [Field k] [CommRing A] [IsDomain A] [Algebra k A]
  {σ : Type*}

/-- An original projection coordinate in its actual generated algebra. -/
noncomputable def affineProjectionCoordinate (y : Option σ → A) (i : σ) :
    affineProjectionAlgebra (k := k) y :=
  ⟨y (some i), Algebra.subset_adjoin ⟨i, rfl⟩⟩

omit [IsDomain A] in
/-- The actual projection coordinate algebra is generated by these
actual original coordinate values, rather than by auxiliary generators. -/
theorem affineProjectionCoordinate_adjoin
    (y : Option σ → A) :
    Algebra.adjoin k (Set.range (affineProjectionCoordinate (k := k) y)) = ⊤ := by
  let R := affineProjectionAlgebra (k := k) y
  apply Subalgebra.map_injective (f := R.val) Subtype.val_injective
  rw [AlgHom.map_adjoin, Algebra.map_top, R.range_val]
  change Algebra.adjoin k (R.val '' Set.range (affineProjectionCoordinate (k := k) y)) = R
  rw [← Set.range_comp]
  rfl

/-- A finite actual affine projection preserves the entire original
transcendence degree over the original constants. -/
theorem affine_finite_projection_trdeg_eq
    (y : Option σ → A) (hfinite : Module.Finite (affineProjectionAlgebra (k := k) y) A) :
    Algebra.trdeg k (affineProjectionAlgebra (k := k) y) = Algebra.trdeg k A := by
  let R := affineProjectionAlgebra (k := k) y
  let : Module.Finite R A := hfinite
  have h := trdeg_add_eq (A := A) k R
  simpa only [trdeg_eq_zero, add_zero] using h

/-- On an actual surface, the two original projection coordinates of
a finite affine projection are algebraically independent. -/
theorem affine_finite_surface_projection_algebraicIndependent
    (y : Option (Fin 2) → A) (htr : 2 ≤ Algebra.trdeg k A)
    (hfinite : Module.Finite (affineProjectionAlgebra (k := k) y) A) :
    AlgebraicIndependent k (fun i : Fin 2 => y (some i)) := by
  let R := affineProjectionAlgebra (k := k) y
  let : Module.Finite R A := hfinite
  let : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range (fun i : Fin 2 => y (some i)))) A :=
    inferInstanceAs (Algebra.IsAlgebraic R A)
  exact (Algebra.IsAlgebraic.isTranscendenceBasis_of_lift_le_trdeg_of_finite k
    (fun i : Fin 2 => y (some i)) (by simpa using htr)).1

end DimensionFourDependence
