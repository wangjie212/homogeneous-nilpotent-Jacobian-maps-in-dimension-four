import DimensionFourDependence.TernaryMovingLineAlgebraicity
import DimensionFourDependence.ProjectiveCovectorTranscendence

/-! # Positive-dimensional tangent normals give finite intersection directions

Positive dimension of the actual normal-coordinate field constructs a
transcendental ratio and a source-coordinate permutation putting it in
the proved moving-line chart. The original homogeneous polynomial,
actual covector equation and every projective coordinate ratio are
transported by that same permutation. Thus no nonzero restriction or
transcendental coordinate ratio needs to be supplied separately.
-/

namespace DimensionFourDependence

open MvPolynomial

universe u

variable {K : Type*} [Field K] [Infinite K]
    {L F : Type u} [Field L] [Field F] [Algebra K L] [Algebra L F]
    [Algebra K F] [IsScalarTower K L F]

/-- A fixed proper original homogeneous plane locus intersects a
positive-dimensional family of actual tangent lines only in directions
whose original normalized coordinates are algebraic over the ruling field. -/
theorem positive_dimensional_normal_original_direction_ratios_isAlgebraic
    (nu : Fin 3 → L) (k : Fin 3) (hk : nu k ≠ 0)
    (hdim : Algebra.trdeg K (projectiveRatioField (K := K) nu k) ≠ 0)
    (Q : MvPolynomial (Fin 3) K) (hQ0 : Q ≠ 0) {D : ℕ} (hQ : Q.IsHomogeneous D)
    (A : Fin 3 → F) (hA : A ≠ 0)
    (hline : ∑ i : Fin 3, algebraMap L F (nu i) * A i = 0)
    (hzero : aeval A Q = 0) (j : Fin 3) (hj : A j ≠ 0) :
    ∀ i : Fin 3, IsAlgebraic L (A i / A j) := by
  obtain ⟨i, hi⟩ := projective_ratio_positive_dimension_exists_transcendental_coordinate nu k hdim
  have hik : i ≠ k := by
    intro he
    apply hi
    rw [he, div_self hk]
    exact isAlgebraic_one
  obtain ⟨p, hp0, hp2⟩ := exists_ternary_permutation_first_last i k hik
  let B : Fin 3 → F := A ∘ p
  let R : MvPolynomial (Fin 3) K := rename p.symm Q
  have hR0 : R ≠ 0 := by
    intro hz
    exact hQ0 ((renameEquiv K p.symm).injective (hz.trans (map_zero _).symm))
  have hR : R.IsHomogeneous D := hQ.rename_isHomogeneous
  have hB : B ≠ 0 := by
    intro hz
    apply hA
    funext l
    have h := congrFun hz (p.symm l)
    simpa [B] using h
  have hpoint : B ∘ p.symm = A := by
    funext l
    simp [B]
  have hzeroB : aeval B R = 0 := by
    change aeval B (rename p.symm Q) = 0
    rw [aeval_rename, hpoint, hzero]
  have hnu2 : (nu ∘ p) 2 ≠ 0 := by
    simpa only [Function.comp_apply, hp2] using hk
  have hratio : Transcendental K ((nu ∘ p) 0 / (nu ∘ p) 2) := by
    simpa only [Function.comp_apply, hp0, hp2] using hi
  have hsum : (∑ l : Fin 3, algebraMap L F (nu (p l)) * A (p l)) = 0 := by
    rw [Equiv.sum_comp p (fun l => algebraMap L F (nu l) * A l), hline]
  have hlineB : algebraMap L F ((nu ∘ p) 0) * B 0 +
      algebraMap L F ((nu ∘ p) 1) * B 1 + algebraMap L F ((nu ∘ p) 2) * B 2 = 0 := by
    simpa [Fin.sum_univ_succ, add_assoc, B] using hsum
  have hBj : B (p.symm j) ≠ 0 := by simpa [B] using hj
  have halg := ternary_moving_line_original_point_ratios_isAlgebraic
    (nu ∘ p) hnu2 hratio R hR0 hR B hB hlineB hzeroB (p.symm j) hBj
  intro l
  simpa [B] using halg (p.symm l)

/-- The entire actual field generated by the original projective
direction ratios is finite over the moving tangent line's ruling field. -/
theorem positive_dimensional_normal_original_direction_field_finite
    (nu : Fin 3 → L) (k : Fin 3) (hk : nu k ≠ 0)
    (hdim : Algebra.trdeg K (projectiveRatioField (K := K) nu k) ≠ 0)
    (Q : MvPolynomial (Fin 3) K) (hQ0 : Q ≠ 0) {D : ℕ} (hQ : Q.IsHomogeneous D)
    (A : Fin 3 → F) (hA : A ≠ 0)
    (hline : ∑ i : Fin 3, algebraMap L F (nu i) * A i = 0)
    (hzero : aeval A Q = 0) (j : Fin 3) (hj : A j ≠ 0) :
    Module.Finite L (IntermediateField.adjoin L (Set.range (fun i => A i / A j))) := by
  have halg := positive_dimensional_normal_original_direction_ratios_isAlgebraic
    nu k hk hdim Q hQ0 hQ A hA hline hzero j hj
  apply IntermediateField.finiteDimensional_adjoin
  rintro z ⟨i, rfl⟩
  exact (halg i).isIntegral

end DimensionFourDependence
