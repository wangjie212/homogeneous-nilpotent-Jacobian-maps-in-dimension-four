import DimensionFourDependence.FiberHilbertDegree

/-! # Ranks and polynomial quotients under extension of the coefficient field -/

namespace DimensionFourDependence

open TensorProduct Module

variable {L E : Type*} [Field L] [Field E] [Algebra L E]

/-- Tensoring a linear map with a field extension preserves its kernel dimension. -/
theorem scalarExtension_kernel_finrank
    {M N : Type*} [AddCommGroup M] [AddCommGroup N] [Module L M] [Module L N]
    (f : M →ₗ[L] N) :
    finrank E (LinearMap.ker (f.baseChange E)) = finrank L (LinearMap.ker f) := by
  have he := (LinearMap.tensorKerEquiv E E f).finrank_eq
  rw [Module.finrank_baseChange] at he
  exact he.symm

/-- Tensoring a finite-dimensional linear map with a field extension preserves its rank. -/
theorem scalarExtension_range_finrank
    {M N : Type*} [AddCommGroup M] [AddCommGroup N] [Module L M] [Module L N] [Module.Finite L M]
    (f : M →ₗ[L] N) :
    finrank E (LinearMap.range (f.baseChange E)) = finrank L (LinearMap.range f) := by
  have h1 := LinearMap.finrank_range_add_finrank_ker f
  have h2 := LinearMap.finrank_range_add_finrank_ker (f.baseChange E)
  rw [scalarExtension_kernel_finrank, Module.finrank_baseChange] at h2
  omega

variable (E) {σ : Type*}

/-- The relation ideal after extending its coefficient field. -/
noncomputable def extendCoefficientIdeal (I : Ideal (MvPolynomial σ L)) : Ideal (MvPolynomial σ E) :=
  I.map (MvPolynomial.map (algebraMap L E))

/-- The scalar extension of a polynomial quotient is the quotient by
the ideal generated by its extended relations. -/
noncomputable def polynomialQuotientBaseChangeEquiv (I : Ideal (MvPolynomial σ L)) :
    E ⊗[L] (MvPolynomial σ L ⧸ I) ≃ₐ[E] MvPolynomial σ E ⧸ extendCoefficientIdeal E I := by
  let e := MvPolynomial.algebraTensorAlgEquiv (σ := σ) L E
  have hcomp : e.toRingHom.comp (Algebra.TensorProduct.includeRight (R := L) (A := E)
      (B := MvPolynomial σ L)).toRingHom =
      MvPolynomial.map (algebraMap L E) := by
    apply RingHom.ext
    intro p
    simp [e]
  have hmap : extendCoefficientIdeal E I =
      (I.map (Algebra.TensorProduct.includeRight (R := L) (A := E)
        (B := MvPolynomial σ L))).map (e : E ⊗[L] MvPolynomial σ L →+* MvPolynomial σ E) := by
    change extendCoefficientIdeal E I =
      (I.map (Algebra.TensorProduct.includeRight (R := L) (A := E)
        (B := MvPolynomial σ L)).toRingHom).map e.toRingHom
    rw [Ideal.map_map, hcomp]
    rfl
  exact (Algebra.TensorProduct.tensorQuotientEquiv (R := L) E (MvPolynomial σ L) E I).trans
    (Ideal.quotientEquivAlg _ _ e hmap)

theorem polynomialQuotientBaseChangeEquiv_tmul (I : Ideal (MvPolynomial σ L))
    (a : E) (p : MvPolynomial σ L) :
    polynomialQuotientBaseChangeEquiv E I (a ⊗ₜ[L] (Ideal.Quotient.mk I p)) =
      a • Ideal.Quotient.mk (extendCoefficientIdeal E I) (MvPolynomial.map (algebraMap L E) p) := by
  simp only [polynomialQuotientBaseChangeEquiv, AlgEquiv.trans_apply]
  rw [Algebra.TensorProduct.tensorQuotientEquiv_apply_tmul, Ideal.quotientEquivAlg_mk,
    MvPolynomial.algebraTensorAlgEquiv_tmul]
  exact (Ideal.Quotient.mkₐ E _).toLinearMap.map_smul a _

end DimensionFourDependence
