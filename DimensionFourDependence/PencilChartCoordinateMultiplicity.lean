import DimensionFourDependence.NormalizedAffineCoordinateMultiplicity
import DimensionFourDependence.ProjectivePencilDimension
import DimensionFourDependence.HomogeneousDehomogenize

/-! # The actual pencil degree bounds original chart-coordinate orders

This specializes the constructed projection to the canonical normalization
of an actual closed Gauss pencil chart, with its actual dehomogenized
pencil equation. The order is bounded by the original common homogeneous
numerator/denominator degree.
-/

namespace DimensionFourDependence

universe u

open MvPolynomial

set_option synthInstance.maxHeartbeats 100000
set_option maxHeartbeats 2000000

variable {K : Type u} [Field K]

/-- A genuine original three-ratio coordinate as an element of the
actual projective-pencil chart algebra. -/
noncomputable def closedGaussPencilChartCoordinate
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (s : Fin 4 ≃ Option (Fin 3)) (i : Fin 3) : closedGaussPencilChartAlgebra H I s :=
  ⟨closedGaussPencilChartPoint s i, Algebra.subset_adjoin ⟨i, rfl⟩⟩

/-- The actual chart is generated by its original coordinate elements,
with no additional algebra-generation hypothesis. -/
theorem closedGaussPencilChartCoordinate_adjoin
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (s : Fin 4 ≃ Option (Fin 3)) :
    Algebra.adjoin (closedGaussParameterField H I)
      (Set.range (closedGaussPencilChartCoordinate H I s)) = ⊤ := by
  let C := closedGaussParameterField H I
  let A := closedGaussPencilChartAlgebra H I s
  apply Subalgebra.map_injective (f := A.val) Subtype.val_injective
  rw [AlgHom.map_adjoin, Algebra.map_top, A.range_val]
  change Algebra.adjoin C (A.val '' Set.range (closedGaussPencilChartCoordinate H I s)) = A
  rw [← Set.range_comp]
  rfl

/-- Every original chart ratio is nonzero, since both of its original
source coordinate functions are nonzero. -/
theorem closedGaussPencilChartCoordinate_ne_zero
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (s : Fin 4 ≃ Option (Fin 3)) (i : Fin 3) :
    closedGaussPencilChartCoordinate H I s i ≠ 0 := by
  have hx (j : Fin 4) : rationalCoordinate (K := K) j ≠ 0 := by
    simpa only [rationalCoordinate, map_zero] using
      (IsFractionRing.injective (MvPolynomial (Fin 4) K)
        (FractionRing (MvPolynomial (Fin 4) K))).ne (X_ne_zero j)
  intro h
  have hzero := congrArg Subtype.val h
  exact (div_ne_zero (hx (s.symm (some i))) (hx (s.symm none))) hzero

/-- The exact actual chart equation is nonzero, vanishes at the original
coordinate elements, and has degree at most the original pencil degree. -/
theorem actual_closed_gauss_pencil_chart_equation_data
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (e : RatFunc K ≃ₐ[K] closedGaussParameterField H I)
    (p q : MvPolynomial (Fin 4) K) {D : ℕ}
    (hq : q ≠ 0) (hrel : IsRelPrime p q) (hpH : p.IsHomogeneous D) (hqH : q.IsHomogeneous D)
    (ht : closedGaussParameterSourceHom H I e RatFunc.X =
      algebraMap _ (FractionRing (MvPolynomial (Fin 4) K)) p /
        algebraMap _ (FractionRing (MvPolynomial (Fin 4) K)) q)
    (s : Fin 4 ≃ Option (Fin 3)) :
    closedGaussPencilChartEquation H I e p q s ≠ 0 ∧
      aeval (closedGaussPencilChartCoordinate H I s)
        (closedGaussPencilChartEquation H I e p q s) = 0 ∧
      (closedGaussPencilChartEquation H I e p q s).totalDegree ≤ D := by
  let C := closedGaussParameterField H I
  let A := closedGaussPencilChartAlgebra H I s
  let G := closedGaussPencilEquation H I e p q
  obtain ⟨hG0, hGH, hGD⟩ := actual_closed_gauss_pencil_homogeneous_degree H I e p q hq hrel hpH hqH
  have hr0 : rename s G ≠ 0 := by
    intro h
    apply hG0
    apply (renameEquiv C s).injective
    change rename s G = rename s 0
    simpa only [map_zero] using h
  refine ⟨fun h => hr0 (homogeneous_dehomogenize_eq_zero (rename s G)
    hGH.rename_isHomogeneous h), ?_, ?_⟩
  · apply Subtype.val_injective
    have hmem : closedGaussPencilChartEquation H I e p q s ∈
        fiberVanishingIdeal (L := C) (closedGaussPencilChartPoint (K := K) s) := by
      rw [actual_closed_gauss_pencil_chart_relation_ideal H I e p q hq hrel hpH hqH ht s]
      exact Ideal.subset_span (by simp)
    have hroot : aeval (closedGaussPencilChartPoint (K := K) s)
        (closedGaussPencilChartEquation H I e p q s) = 0 := hmem
    have h := MvPolynomial.comp_aeval_apply (closedGaussPencilChartCoordinate H I s) A.val
      (closedGaussPencilChartEquation H I e p q s)
    exact h.trans hroot
  · exact (projectiveDehomogenize_totalDegree (rename s G)).trans
      ((MvPolynomial.totalDegree_rename_le s G).trans hGD.le)

variable [CharZero K]

/-- Every height-one prime of the actual original-parameter pencil
chart normalization satisfies the pencil-degree bound for an original
coordinate hyperplane. The actual equation, residue parameter, projection
and generator are all constructed from the original pencil data. -/
theorem actual_closed_gauss_pencil_chart_coordinate_order_le_degree
    (H : Fin 4 → MvPolynomial (Fin 4) K) {d : ℕ} (hH : IsHomogMap H d)
    (I : ImageRelationWitness H) (e : RatFunc K ≃ₐ[K] closedGaussParameterField H I)
    (hGauss : gaussImageDimension H I = 1)
    (p q : MvPolynomial (Fin 4) K) {D : ℕ}
    (hq : q ≠ 0) (hrel : IsRelPrime p q) (hpH : p.IsHomogeneous D) (hqH : q.IsHomogeneous D)
    (ht : closedGaussParameterSourceHom H I e RatFunc.X =
      algebraMap _ (FractionRing (MvPolynomial (Fin 4) K)) p /
        algebraMap _ (FractionRing (MvPolynomial (Fin 4) K)) q)
    (s : Fin 4 ≃ Option (Fin 3)) (r : Fin 3 ≃ Option (Option Unit))
    (Q : Ideal (normalizationRing (closedGaussPencilChartAlgebra H I s))) [Q.IsPrime]
    (hQ : Q.height = 1)
    (hz : algebraMap (closedGaussPencilChartAlgebra H I s)
      (normalizationRing (closedGaussPencilChartAlgebra H I s))
      (closedGaussPencilChartCoordinate H I s (r.symm (some none))) ∈ Q)
    (a : ℕ) (horder : algebraMap (closedGaussPencilChartAlgebra H I s) (Localization.AtPrime Q)
      (closedGaussPencilChartCoordinate H I s (r.symm (some none))) ∈
        (IsLocalRing.maximalIdeal (Localization.AtPrime Q)) ^ a) : a ≤ D := by
  let C := closedGaussParameterField H I
  let A := closedGaussPencilChartAlgebra H I s
  let : CharZero C := charZero_of_injective_algebraMap (algebraMap K C).injective
  let : Algebra.FiniteType C A := closedGaussPencilChartAlgebra_finiteType H I s
  let x : Option (Option Unit) → A := fun j => closedGaussPencilChartCoordinate H I s (r.symm j)
  let f := MvPolynomial.renameEquiv C r (closedGaussPencilChartEquation H I e p q s)
  obtain ⟨hf0, hroot, hdegree⟩ := actual_closed_gauss_pencil_chart_equation_data
    H I e p q hq hrel hpH hqH ht s
  have hx : Algebra.adjoin C (Set.range x) = ⊤ := by
    have hrange : Set.range x = Set.range (closedGaussPencilChartCoordinate H I s) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩; exact ⟨r.symm i, rfl⟩
      · rintro ⟨i, rfl⟩; exact ⟨r i, by simp [x]⟩
    rw [hrange]
    exact closedGaussPencilChartCoordinate_adjoin H I s
  have hf : f ≠ 0 := by
    intro h
    apply hf0
    apply (MvPolynomial.renameEquiv C r).injective
    simpa only [map_zero] using h
  have hroot' : aeval x f = 0 := by
    change aeval x (rename r _) = 0
    rw [aeval_rename]
    have hcoords : x ∘ r = closedGaussPencilChartCoordinate H I s := by
      funext i
      simp [x]
    rw [hcoords]
    exact hroot
  have htr : 2 ≤ Algebra.trdeg C A := by
    rw [actual_closed_gauss_pencil_chart_trdeg_two H hH I e hGauss s]
  have h := canonical_normalization_coordinate_order_le_totalDegree
    (k := C) x hx htr Q hQ
      (closedGaussPencilChartCoordinate_ne_zero H I s (r.symm (some none))) hz f hf hroot' a horder
  exact h.trans ((MvPolynomial.totalDegree_renameEquiv r _).le.trans hdegree)

end DimensionFourDependence
