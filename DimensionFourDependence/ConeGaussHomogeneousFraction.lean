import DimensionFourDependence.ImageConeGaussRealization
import DimensionFourDependence.HomogeneousGaussParameter

/-! # A homogeneous quotient for the original parameter in cone coordinates

Projective normal ratios over the actual cone field form a field of
equal-degree homogeneous polynomial quotients. Denominators are checked
in the cone field itself, so a polynomial killed by the cone equation
is never used as a denominator.
-/

namespace DimensionFourDependence

open MvPolynomial

variable {K F : Type*} [Field K] [Field F] [Algebra K F]

/-- Every element generated by equal-degree homogeneous polynomial
ratios has a homogeneous quotient with nonzero actual mapped denominator,
even when the original polynomial evaluation has a nontrivial kernel. -/
theorem mapped_projective_ratio_field_homogeneous_fraction
    (f : MvPolynomial (Fin 4) K →ₐ[K] F) (N : Fin 4 → MvPolynomial (Fin 4) K)
    {d : ℕ} (hN : IsHomogMap N d) (a : Fin 4) (ha : f (N a) ≠ 0)
    (t : F) (ht : t ∈ projectiveRatioField (K := K) (fun i => f (N i)) a) :
    ∃ p q : MvPolynomial (Fin 4) K, ∃ m : ℕ,
      f q ≠ 0 ∧ p.IsHomogeneous m ∧ q.IsHomogeneous m ∧ t = f p / f q := by
  induction ht using IntermediateField.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ⟨N i, N a, d, ha, hN i, hN a, rfl⟩
  | algebraMap c =>
    refine ⟨C c, 1, 0, by simp, isHomogeneous_C _ _, isHomogeneous_one _ _, ?_⟩
    rw [map_one, div_one]
    exact (f.commutes c).symm
  | add x y hx hy ihx ihy =>
    obtain ⟨p, q, m, hq, hpH, hqH, hxp⟩ := ihx
    obtain ⟨r, s, k, hs, hrH, hsH, hyr⟩ := ihy
    refine ⟨p * s + r * q, q * s, m + k, by simpa only [map_mul] using mul_ne_zero hq hs,
      (hpH.mul hsH).add (by simpa only [add_comm] using hrH.mul hqH), hqH.mul hsH, ?_⟩
    rw [hxp, hyr, map_add, map_mul, map_mul, map_mul]
    field_simp
  | inv x hx ih =>
    obtain ⟨p, q, m, hq, hpH, hqH, hxp⟩ := ih
    by_cases hp : f p = 0
    · refine ⟨0, 1, 0, by simp, isHomogeneous_zero _ _ _, isHomogeneous_one _ _, ?_⟩
      rw [hxp, hp, zero_div, inv_zero, map_zero, zero_div]
    · exact ⟨q, p, m, hp, hqH, hpH, by rw [hxp, inv_div]⟩
  | mul x y hx hy ihx ihy =>
    obtain ⟨p, q, m, hq, hpH, hqH, hxp⟩ := ihx
    obtain ⟨r, s, k, hs, hrH, hsH, hyr⟩ := ihy
    refine ⟨p * r, q * s, m + k, by simpa only [map_mul] using mul_ne_zero hq hs,
      hpH.mul hrH, hqH.mul hsH, ?_⟩
    rw [hxp, hyr, map_mul, map_mul, div_mul_div_comm]

/-- The original Gauss parameter has an equal-degree homogeneous
quotient in the original cone coordinates with nonzero cone denominator.
The quotient and all its regularity conditions are constructed. -/
theorem original_cone_gauss_parameter_homogeneous_fraction
    (H : Fin 4 → MvPolynomial (Fin 4) K) (I : ImageRelationWitness H)
    (e : RatFunc K ≃ₐ[K] projectiveRatioField (K := K)
      (rationalImageNormal H I.equation) (imageNormalPivot H I)) :
    ∃ p q : MvPolynomial (Fin 4) K, ∃ m : ℕ,
      algebraMap (MvPolynomial (Fin 4) K) (imageRelationIdeal H).ResidueField q ≠ 0 ∧
      p.IsHomogeneous m ∧ q.IsHomogeneous m ∧
      imageConeGaussHom H I e RatFunc.X =
        algebraMap (MvPolynomial (Fin 4) K) (imageRelationIdeal H).ResidueField p /
          algebraMap (MvPolynomial (Fin 4) K) (imageRelationIdeal H).ResidueField q := by
  let ρ := algebraMap (MvPolynomial (Fin 4) K) (imageRelationIdeal H).ResidueField
  let emb := imageConeResidueEmbedding H
  let φ := imageConeGaussHom H I e
  let a := imageNormalPivot H I
  let N : Fin 4 → (imageRelationIdeal H).ResidueField := fun i => ρ (pderiv i I.equation)
  let B := projectiveRatioField (K := K) N a
  have hB : B.map emb = projectiveRatioField (K := K) (rationalImageNormal H I.equation) a := by
    change (IntermediateField.adjoin K (Set.range (fun i => N i / N a))).map emb = _
    rw [IntermediateField.adjoin_map, ← Set.range_comp]
    apply congrArg (IntermediateField.adjoin K)
    apply congrArg Set.range
    funext i
    change imageConeResidueEmbedding H (ρ (pderiv i I.equation) / ρ (pderiv a I.equation)) = _
    rw [map_div₀, imageConeResidueEmbedding_polynomial, imageConeResidueEmbedding_polynomial]
    rfl
  have hmem : emb (φ RatFunc.X) ∈ B.map emb := by
    rw [hB]
    change imageConeResidueEmbedding H (imageConeGaussHom H I e RatFunc.X) ∈ _
    rw [imageConeGaussHom_realization]
    exact (e RatFunc.X).property
  obtain ⟨z, hz, he⟩ := hmem
  have hzφ : z = φ RatFunc.X := emb.injective he
  have hφ : φ RatFunc.X ∈ B := hzφ ▸ hz
  exact mapped_projective_ratio_field_homogeneous_fraction
    (IsScalarTower.toAlgHom K (MvPolynomial (Fin 4) K) (imageRelationIdeal H).ResidueField)
    (fun i => pderiv i I.equation) (fun _ => I.homogeneous.pderiv) a
    (image_cone_normal_pivot_ne_zero H I) (φ RatFunc.X) hφ

end DimensionFourDependence
