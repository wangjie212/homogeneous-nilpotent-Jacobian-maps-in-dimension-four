import DimensionFourDependence.ProjectiveCone
import Mathlib.FieldTheory.RatFunc.AsPolynomial
import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra

/-! # The actual radial cone algebra, its affine evaluation and its fraction embedding -/

namespace DimensionFourDependence

open MvPolynomial

variable {E F : Type*} [Field E] [Field F] [Algebra E F]

/-- The actual homogeneous cone algebra, inside the radial polynomial
ring, generated by the line through the original affine point. -/
@[reducible]
noncomputable def projectiveConeCoordinateAlgebra (x : Fin 3 → F) : Subalgebra E (Polynomial F) :=
  (projectiveConeMap (L := E) x).range

/-- The four original homogeneous coordinates of that actual cone. -/
noncomputable def projectiveConeCoordinate (x : Fin 3 → F) (i : Option (Fin 3)) :
    projectiveConeCoordinateAlgebra (E := E) x :=
  (projectiveConeMap (L := E) x).rangeRestrict (X i)

/-- Each cone coordinate is exactly its original affine value
multiplied by the same actual radial polynomial parameter. -/
theorem projectiveConeCoordinate_polynomial_value (x : Fin 3 → F) (i : Option (Fin 3)) :
    (projectiveConeCoordinate (E := E) x i : Polynomial F) =
      Polynomial.C (i.elim 1 x) * Polynomial.X :=
  projectiveConeMap_X x i

/-- The four actual homogeneous coordinates generate the whole cone
algebra; no generation hypothesis is supplied. -/
theorem projectiveConeCoordinate_adjoin (x : Fin 3 → F) :
    Algebra.adjoin E (Set.range (projectiveConeCoordinate (E := E) x)) = ⊤ := by
  let ψ := (projectiveConeMap (L := E) x).rangeRestrict
  have hψ : ψ = aeval (projectiveConeCoordinate (E := E) x) := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [aeval_X]
    rfl
  exact (MvPolynomial.aeval_range (f := projectiveConeCoordinate (E := E) x)).symm.trans
    ((congrArg AlgHom.range hψ.symm).trans
      ((AlgHom.range_eq_top ψ).mpr (projectiveConeMap (L := E) x).rangeRestrict_surjective))

/-- The cone algebra is an actual finite-type coefficient algebra. -/
theorem projectiveConeCoordinateAlgebra_finiteType (x : Fin 3 → F) :
    Algebra.FiniteType E (projectiveConeCoordinateAlgebra (E := E) x) :=
  Algebra.FiniteType.of_surjective (projectiveConeMap (L := E) x).rangeRestrict
    (projectiveConeMap (L := E) x).rangeRestrict_surjective

/-- Evaluation of the radial parameter at one retains the original
affine point inside its original coordinate field. -/
noncomputable def projectiveConeEvaluateOne (x : Fin 3 → F) :
    projectiveConeCoordinateAlgebra (E := E) x →ₐ[E] F :=
  ((Polynomial.aeval (1 : F)).restrictScalars E).comp
    (projectiveConeCoordinateAlgebra (E := E) x).val

/-- Its image is precisely the original affine coordinate algebra. -/
theorem projectiveConeEvaluateOne_range (x : Fin 3 → F) :
    (projectiveConeEvaluateOne (E := E) x).range = Algebra.adjoin E (Set.range x) := by
  let ψ := (projectiveConeMap (L := E) x).rangeRestrict
  have hψ : ψ.range = ⊤ := (AlgHom.range_eq_top ψ).mpr
    (projectiveConeMap (L := E) x).rangeRestrict_surjective
  have he : (projectiveConeEvaluateOne (E := E) x).comp ψ =
      aeval (fun j : Option (Fin 3) => j.elim 1 x) := by
    apply MvPolynomial.algHom_ext
    intro j
    change (projectiveConeMap (L := E) x (X j)).eval 1 = _
    rw [projectiveConeMap_X]
    simp
  have hr := congrArg AlgHom.range he
  rw [AlgHom.range_comp ψ (projectiveConeEvaluateOne (E := E) x), hψ, Algebra.map_top,
    MvPolynomial.aeval_range] at hr
  refine hr.trans (le_antisymm ?_ ?_)
  · apply Algebra.adjoin_le_iff.mpr
    rintro _ ⟨j, rfl⟩
    cases j with
    | none => exact (Algebra.adjoin E (Set.range x)).one_mem
    | some i => exact Algebra.subset_adjoin (Set.mem_range_self i)
  · apply Algebra.adjoin_mono
    rintro _ ⟨i, rfl⟩
    exact ⟨some i, rfl⟩

/-- The actual cone evaluates onto the actual original affine
coordinate algebra, with the original coefficient field retained. -/
noncomputable def projectiveConeChartEvaluation (x : Fin 3 → F) :
    projectiveConeCoordinateAlgebra (E := E) x →ₐ[E] Algebra.adjoin E (Set.range x) :=
  ((Subalgebra.equivOfEq _ _ (projectiveConeEvaluateOne_range (E := E) x)).toAlgHom).comp
    (projectiveConeEvaluateOne (E := E) x).rangeRestrict

theorem projectiveConeChartEvaluation_surjective (x : Fin 3 → F) :
    Function.Surjective (projectiveConeChartEvaluation (E := E) x) :=
  (Subalgebra.equivOfEq _ _ (projectiveConeEvaluateOne_range (E := E) x)).surjective.comp
    (projectiveConeEvaluateOne (E := E) x).rangeRestrict_surjective

/-- The actual cone has at least the transcendence dimension of
the actual original affine coordinate algebra. -/
theorem projectiveConeCoordinateAlgebra_trdeg_ge_chart (x : Fin 3 → F) :
    Algebra.trdeg E (Algebra.adjoin E (Set.range x)) ≤
      Algebra.trdeg E (projectiveConeCoordinateAlgebra (E := E) x) :=
  trdeg_le_of_surjective (projectiveConeChartEvaluation (E := E) x)
    (projectiveConeChartEvaluation_surjective (E := E) x)

/-- The actual polynomial cone includes into the rational radial
field, preserving the original coefficient algebra. -/
noncomputable def projectiveConeRadialHom (x : Fin 3 → F) :
    projectiveConeCoordinateAlgebra (E := E) x →ₐ[E] RatFunc F :=
  (IsScalarTower.toAlgHom E (Polynomial F) (RatFunc F)).comp
    (projectiveConeCoordinateAlgebra (E := E) x).val

theorem projectiveConeRadialHom_injective (x : Fin 3 → F) :
    Function.Injective (projectiveConeRadialHom (E := E) x) :=
  (IsFractionRing.injective (Polynomial F) (RatFunc F)).comp Subtype.val_injective

/-- The actual cone fraction field embeds in the radial rational
field by the original cone-coordinate inclusion. -/
noncomputable def projectiveConeFractionEmbedding (x : Fin 3 → F) :
    FractionRing (projectiveConeCoordinateAlgebra (E := E) x) →ₐ[E] RatFunc F :=
  IsFractionRing.liftAlgHom (projectiveConeRadialHom_injective (E := E) x)

/-- The fraction embedding retains every actual original homogeneous
coordinate and the same radial parameter. -/
theorem projectiveConeFractionEmbedding_coordinate (x : Fin 3 → F) (i : Option (Fin 3)) :
    projectiveConeFractionEmbedding (E := E) x
      (algebraMap (projectiveConeCoordinateAlgebra (E := E) x)
        (FractionRing (projectiveConeCoordinateAlgebra (E := E) x)) (projectiveConeCoordinate (E := E) x i)) =
      RatFunc.C (i.elim 1 x) * RatFunc.X := by
  change IsFractionRing.lift (projectiveConeRadialHom_injective (E := E) x) _ = _
  rw [IsFractionRing.lift_algebraMap]
  change algebraMap (Polynomial F) (RatFunc F) (projectiveConeCoordinate (E := E) x i : Polynomial F) = _
  rw [projectiveConeCoordinate_polynomial_value, map_mul]
  rfl

end DimensionFourDependence
