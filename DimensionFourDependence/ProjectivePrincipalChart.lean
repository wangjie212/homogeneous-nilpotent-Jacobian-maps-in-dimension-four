import DimensionFourDependence.ProjectiveFiberPrime
import DimensionFourDependence.NormalizationRing

/-! # Exact affine charts of a homogeneous principal source relation

For a nonzero homogeneous coordinate, the cone over the normalized source
point has exactly the original homogeneous relation ideal. Dehomogenizing
its single generator therefore gives the entire affine-chart ideal.
-/

namespace DimensionFourDependence

open MvPolynomial

variable {C F : Type*} [Field C] [Field F] [Algebra C F]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- Evaluating the radial parameter at the actual nonzero coordinate
recovers the original source point. -/
theorem projectiveConeMap_eval_nonzero_coordinate
    (x : Option (Fin 3) → F) (hx : x none ≠ 0) (P : MvPolynomial (Option (Fin 3)) C) :
    (projectiveConeMap (L := C) (fun i => x (some i) / x none) P).eval (x none) = aeval x P := by
  have h : ((Polynomial.aeval (x none)).restrictScalars C).comp
      (projectiveConeMap (L := C) (fun i => x (some i) / x none)) = aeval x := by
    apply MvPolynomial.algHom_ext
    intro j
    cases j <;> simp [projectiveConeMap_X, hx]
  exact DFunLike.congr_fun h P

/-- Normalizing a nonzero source coordinate preserves the whole
homogeneous cone ideal, including inhomogeneous polynomial relations. -/
theorem projectiveConeIdeal_eq_homogeneous_source_kernel
    (x : Option (Fin 3) → F) (hx : x none ≠ 0)
    (hI : (RingHom.ker (aeval x : MvPolynomial (Option (Fin 3)) C →ₐ[C] F)).IsHomogeneous
      (homogeneousSubmodule (Option (Fin 3)) C)) :
    projectiveConeIdeal (L := C) (fun i => x (some i) / x none) =
      RingHom.ker (aeval x : MvPolynomial (Option (Fin 3)) C →ₐ[C] F) := by
  ext P
  constructor
  · intro hp
    change aeval x P = 0
    rw [← projectiveConeMap_eval_nonzero_coordinate x hx]
    change projectiveConeMap (L := C) (fun i => x (some i) / x none) P = 0 at hp
    rw [hp, Polynomial.eval_zero]
  · intro hp
    change projectiveConeMap (L := C) (fun i => x (some i) / x none) P = 0
    apply Polynomial.ext
    intro d
    rw [projectiveConeMap_coeff, Polynomial.coeff_zero]
    have hc := homogeneousComponent_mem_of_mem hI hp d
    change aeval x (homogeneousComponent d P) = 0 at hc
    have he := projectiveConeMap_eval_nonzero_coordinate x hx (homogeneousComponent d P)
    rw [projectiveConeMap_of_isHomogeneous _ (homogeneousComponent_isHomogeneous d P),
      Polynomial.eval_monomial, hc] at he
    exact (mul_eq_zero.mp he).resolve_right (pow_ne_zero d hx)

/-- The exact ideal of the affine chart of a homogeneous principal source
hypersurface is generated by the dehomogenized source equation. -/
theorem homogeneous_principal_source_chart_relation_ideal
    (x : Option (Fin 3) → F) (hx : x none ≠ 0)
    (G : MvPolynomial (Option (Fin 3)) C) {D : ℕ} (hG : G.IsHomogeneous D)
    (hker : RingHom.ker (aeval x : MvPolynomial (Option (Fin 3)) C →ₐ[C] F) = Ideal.span {G}) :
    fiberVanishingIdeal (L := C) (fun i => x (some i) / x none) =
      Ideal.span {projectiveDehomogenize G} := by
  have hI : (RingHom.ker (aeval x : MvPolynomial (Option (Fin 3)) C →ₐ[C] F)).IsHomogeneous
      (homogeneousSubmodule (Option (Fin 3)) C) := by
    rw [hker]
    apply Ideal.homogeneous_span
    intro P hp
    obtain rfl := Set.mem_singleton_iff.mp hp
    exact ⟨D, hG⟩
  rw [← projectiveConeIdeal_dehomogenize, projectiveConeIdeal_eq_homogeneous_source_kernel x hx hI,
    hker, Ideal.map_span, Set.image_singleton]
  rfl

end DimensionFourDependence
