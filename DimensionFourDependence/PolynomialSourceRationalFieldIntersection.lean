import DimensionFourDependence.NormalSourcePolynomialParameter
import DimensionFourDependence.AffineTriangularDivisibility

/-! # The intersection of a polynomial parameter field with the source ring -/

namespace DimensionFourDependence

open MvPolynomial

universe u
set_option maxHeartbeats 1700000

variable {K : Type u} [Field K] {n : ℕ}
local notation "R₀" => MvPolynomial (Fin n) K
local notation "F" => FractionRing R₀
local notation "ι" => (algebraMap R₀ F)

/-- Substitution of the actual polynomial parameter followed by source
inclusion is the same as the rational field embedding on polynomials. -/
theorem rational_polynomial_parameter_source_value
    (f : RatFunc K →ₐ[K] F) (T : R₀) (hT : ι T = f RatFunc.X) (p : Polynomial K) :
    ι (Polynomial.aeval T p) = f (algebraMap (Polynomial K) (RatFunc K) p) := by
  rw [rational_function_algHom_polynomial_value, ← hT]
  exact (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom K R₀ F) T p).symm

/-- A polynomial source value in the field generated by a polynomial
parameter is a polynomial in that same parameter. Bezout coprimality
forces the substituted denominator to be a scalar unit. -/
theorem polynomial_source_value_lies_in_polynomial_parameter_ring
    (f : RatFunc K →ₐ[K] F) (T : R₀) (hT : ι T = f RatFunc.X)
    (r : RatFunc K) (H : R₀) (hH : f r = ι H) :
    ∃ A : Polynomial K, Polynomial.aeval T A = H := by
  have hmul : Polynomial.aeval T r.num = H * Polynomial.aeval T r.denom := by
    apply IsFractionRing.injective R₀ F
    have hnum : algebraMap (Polynomial K) (RatFunc K) r.num =
        r * algebraMap (Polynomial K) (RatFunc K) r.denom :=
      (div_eq_iff (RatFunc.algebraMap_ne_zero r.denom_ne_zero)).mp (RatFunc.num_div_denom r)
    have he := congrArg f hnum
    change f (algebraMap (Polynomial K) (RatFunc K) r.num) =
      f (r * algebraMap (Polynomial K) (RatFunc K) r.denom) at he
    simpa only [map_mul, rational_polynomial_parameter_source_value f T hT, hH] using he
  have hcop : IsCoprime (Polynomial.aeval T r.num) (Polynomial.aeval T r.denom) :=
    r.isCoprime_num_denom.map (Polynomial.aeval T).toRingHom
  have hu : IsUnit (Polynomial.aeval T r.denom) :=
    hcop.symm.isUnit_of_dvd ⟨H, hmul.trans (mul_comm _ _)⟩
  let b := (Polynomial.aeval T r.denom).coeff 0
  have hb : Polynomial.aeval T r.denom = C b :=
    totalDegree_eq_zero_iff_eq_C.mp (isUnit_iff_totalDegree_of_isReduced.mp hu).2
  have hd : r.denom = Polynomial.C b := by
    apply RatFunc.algebraMap_injective K
    apply f.injective
    change f (algebraMap (Polynomial K) (RatFunc K) r.denom) =
      f (algebraMap (Polynomial K) (RatFunc K) (Polynomial.C b))
    rw [← rational_polynomial_parameter_source_value f T hT,
      ← rational_polynomial_parameter_source_value f T hT, Polynomial.aeval_C, algebraMap_eq, hb]
  obtain ⟨A, hA⟩ := ratFunc_exists_polynomial_of_denom_degree_zero r (by rw [hd, Polynomial.natDegree_C])
  refine ⟨A, IsFractionRing.injective R₀ F ?_⟩
  rw [rational_polynomial_parameter_source_value f T hT, hA, hH]

end DimensionFourDependence
