import DimensionFourDependence.VertexParameterTranscendence
import DimensionFourDependence.FullOutputGeometricFiber

/-! # The actual source as a univariate rational field over transverse coordinates

The original four-coordinate source field is the fraction field of the
polynomial ring in its vertex coordinate over its actual transverse
coordinate field. Both the coefficient coordinates and polynomial source
values are constructed from the original coordinates, without an assumed
source-field equivalence or polynomial presentation.
-/

namespace DimensionFourDependence

open MvPolynomial

set_option maxHeartbeats 2000000
set_option synthInstance.maxHeartbeats 100000

variable (K : Type*) [Field K]

/-- The actual field generated by the original three transverse coordinates. -/
noncomputable def transverseSourceField :
    IntermediateField K (FractionRing (MvPolynomial (Fin 4) K)) :=
  IntermediateField.adjoin K (Set.range (fun i : Fin 3 => rationalCoordinate (K := K) i.castSucc))

/-- An original transverse coordinate, regarded in its own generated field. -/
noncomputable def transverseSourceCoordinate (i : Fin 3) : transverseSourceField K :=
  ⟨rationalCoordinate (K := K) i.castSucc, IntermediateField.subset_adjoin K _ ⟨i, rfl⟩⟩

/-- A source polynomial with the vertex coordinate retained as its
univariate variable and the transverse coordinates moved to coefficients. -/
noncomputable def sourceVertexPolynomial (P : MvPolynomial (Fin 4) K) :
    Polynomial (transverseSourceField K) :=
  MvPolynomial.eval₂ ((Polynomial.C).comp (algebraMap K (transverseSourceField K)))
    (Fin.lastCases Polynomial.X (fun i => Polynomial.C (transverseSourceCoordinate K i))) P

/-- The actual transverse coordinate field retains their original
algebraic independence over the original coefficient field. -/
theorem transverseSourceCoordinate_algebraicIndependent :
    AlgebraicIndependent K (transverseSourceCoordinate K) := by
  apply AlgebraicIndependent.of_comp
    (IsScalarTower.toAlgHom K (transverseSourceField K) (FractionRing (MvPolynomial (Fin 4) K)))
  exact (rationalCoordinates_algebraicIndependent (K := K) (n := 4)).comp
    Fin.castSucc (Fin.castSucc_injective 3)

/-- The constructed univariate source polynomial has precisely the
original polynomial value in the original rational source field. -/
theorem sourceVertexPolynomial_value (P : MvPolynomial (Fin 4) K) :
    Polynomial.aeval (rationalCoordinate (K := K) (Fin.last 3)) (sourceVertexPolynomial K P) =
      algebraMap (MvPolynomial (Fin 4) K) (FractionRing (MvPolynomial (Fin 4) K)) P := by
  have hX (i : Fin 4) : Polynomial.aeval (rationalCoordinate (K := K) (Fin.last 3))
      (Fin.lastCases Polynomial.X (fun j => Polynomial.C (transverseSourceCoordinate K j)) i) =
      rationalCoordinate (K := K) i := by
    refine Fin.lastCases ?_ (fun j => ?_) i
    · simp only [Fin.lastCases_last, Polynomial.aeval_X]
    · simp only [Fin.lastCases_castSucc, Polynomial.aeval_C]
      rfl
  induction P using MvPolynomial.induction_on with
  | C c =>
      simp only [sourceVertexPolynomial, MvPolynomial.eval₂_C, RingHom.comp_apply, Polynomial.aeval_C]
      rw [← IsScalarTower.algebraMap_apply K (transverseSourceField K)
        (FractionRing (MvPolynomial (Fin 4) K))]
      exact (IsScalarTower.algebraMap_apply K (MvPolynomial (Fin 4) K)
        (FractionRing (MvPolynomial (Fin 4) K)) c)
  | add P Q hP hQ =>
      simp only [sourceVertexPolynomial, MvPolynomial.eval₂_add, map_add] at *
      exact congrArg₂ (· + ·) hP hQ
  | mul_X P i hP =>
      simp only [sourceVertexPolynomial, MvPolynomial.eval₂_mul, MvPolynomial.eval₂_X, map_mul, hX]
      simpa only [sourceVertexPolynomial, rationalCoordinate] using
        congrArg (fun z => z * rationalCoordinate (K := K) i) hP

/-- Adjoining the original vertex coordinate to the actual transverse
field recovers the entire original rational source field. -/
theorem transverseSourceField_vertex_adjoin_eq_top :
    IntermediateField.adjoin (transverseSourceField K)
      {rationalCoordinate (K := K) (Fin.last 3)} = ⊤ := by
  let J := IntermediateField.adjoin (transverseSourceField K)
    {rationalCoordinate (K := K) (Fin.last 3)}
  have hJ : J.restrictScalars K = ⊤ := by
    apply rationalSource_field_eq_top_of_coordinates
    intro i
    refine Fin.lastCases ?_ (fun j => ?_) i
    · change rationalCoordinate (K := K) (Fin.last 3) ∈ J
      exact IntermediateField.subset_adjoin (transverseSourceField K)
        {rationalCoordinate (K := K) (Fin.last 3)} rfl
    · exact J.algebraMap_mem (transverseSourceCoordinate K j)
  apply top_unique
  intro z _
  have hz : z ∈ J.restrictScalars K := by rw [hJ]; trivial
  exact hz

variable [CharZero K]

/-- The original vertex coordinate is transcendental over the entire
actual transverse coordinate field. -/
theorem vertexCoordinate_transcendental_over_transverseSourceField :
    Transcendental (transverseSourceField K) (rationalCoordinate (K := K) (Fin.last 3)) := by
  apply nonzero_derivation_value_transcendental_over_coordinate_field
    (rationalPartial (K := K) (Fin.last 3))
    (fun i : Fin 3 => rationalCoordinate (K := K) i.castSucc)
    (fun i => by
      rw [rationalPartial_coordinate]
      simp only [Fin.castSucc_ne_last, ite_false])
  simp [rationalPartial_coordinate]

/-- The canonical vertex evaluation makes the original source the
fraction field of the actual transverse-coefficient polynomial ring. -/
theorem actual_source_vertex_polynomial_isFractionRing :
    letI : Algebra (Polynomial (transverseSourceField K)) (FractionRing (MvPolynomial (Fin 4) K)) :=
      (Polynomial.aeval (rationalCoordinate (K := K) (Fin.last 3))).toRingHom.toAlgebra
    IsFractionRing (Polynomial (transverseSourceField K)) (FractionRing (MvPolynomial (Fin 4) K)) := by
  let : Algebra (Polynomial (transverseSourceField K)) (FractionRing (MvPolynomial (Fin 4) K)) :=
    (Polynomial.aeval (rationalCoordinate (K := K) (Fin.last 3))).toRingHom.toAlgebra
  have hinj : Function.Injective (algebraMap (Polynomial (transverseSourceField K))
      (FractionRing (MvPolynomial (Fin 4) K))) :=
    transcendental_iff_injective.mp (vertexCoordinate_transcendental_over_transverseSourceField K)
  let : FaithfulSMul (Polynomial (transverseSourceField K)) (FractionRing (MvPolynomial (Fin 4) K)) :=
    (faithfulSMul_iff_algebraMap_injective _ _).mpr hinj
  apply IsFractionRing.of_field
  intro z
  have hz : z ∈ IntermediateField.adjoin (transverseSourceField K)
      {rationalCoordinate (K := K) (Fin.last 3)} := by
    rw [transverseSourceField_vertex_adjoin_eq_top]; trivial
  exact (IntermediateField.mem_adjoin_simple_iff _ z).mp hz

end DimensionFourDependence
